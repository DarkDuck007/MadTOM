[Unit]
Description=MADTOM Studio Direct-Display (DRM/KMS Appliance Mode)
Documentation=https://github.com/DarkDuck007/madtom
After=systemd-udevd.service systemd-user-sessions.service network-online.target
Wants=network-online.target
Conflicts=getty@tty7.service

[Service]
Type=simple
# Executing user (e.g. madtom or your local operator user)
User=madtom
Group=madtom
SupplementaryGroups=video render input tty

WorkingDirectory=/opt/madtom
Environment=HOME=/home/madtom
Environment=XDG_DATA_HOME=/home/madtom/.local/share

# Run on dedicated TTY or detached from display managers
TTYPath=/dev/tty7
TTYReset=yes
TTYVHangup=yes
TTYVTDisallocate=yes
StandardInput=tty
StandardOutput=journal
StandardError=journal

# ------------------------------------------------------------------------------
# COMMAND ARGUMENT REFERENCE FOR MADTOM.Studio (DRM/KMS Mode)
# ------------------------------------------------------------------------------
#   --output drm (or -o drm)
#       Launches MADTOM Studio directly rendering to Linux DRM/KMS framebuffer without X11 or Wayland.
#
#   --card <path> (or -c <path>)
#       DRI card node path (default: /dev/dri/card0).
#
#   --scaling <factor> (or -s <factor>)
#       Display scaling factor (e.g. 1.0, 1.25, 1.5, 2.0).
#
ExecStart=/opt/madtom/MADTOM.Studio --output drm --card /dev/dri/card0 --scaling 1.0

# Graceful termination: SIGTERM triggers AppShutdownCoordinator ensuring Pebble/TSDB WAL and plugin disposal
KillSignal=SIGTERM
TimeoutStopSec=15
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
