<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.NoxAI.ViewModels"
             xmlns:logs="clr-namespace:MadTOM.Controls.Logs;assembly=MADTOM.Plugins.Telemetry"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MADTOM.Plugins.NoxAI.Views.Tabs.RawLogsApiTabView"
             x:DataType="vm:RawLogsApiTabViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <!-- Read-Only Status & Server WAL Spool Ribbon (Mode is configured per-node in Settings) -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <!-- Per-Node Mode Badge -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeBadgeText}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>

                <!-- Live Stream Status -->
                <Border Grid.Column="1"
                        Background="{DynamicResource DarkBaseBrush}"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding LogStreamStatus}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <!-- WAL Spool Status Summary -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SERVER WAL SPOOL (1GB CAP · CONFIGURE IN ⚙ SETTINGS)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SpoolStatusSummary}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding RefreshSpoolStatusCommand}" Content="🔄 Refresh" Padding="8,4" FontSize="11" ToolTip.Tip="Query server spool usage stats"/>
                <Button Grid.Column="4" Command="{Binding ClearSpoolCommand}" Content="🗑️ Clear Spool" Padding="8,4" FontSize="11" Foreground="#EF4444" ToolTip.Tip="Completely clear server-side spools and reset cached logs and API calls"/>
            </Grid>
        </Border>

        <!-- Sub Tabs: Bot Virtual Logs & Raw API Calls -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSubViewIndex, Mode=TwoWay}">
            <!-- Sub-Tab 1: Bot System Logs (Zstd Virtual Log View) -->
            <TabItem Header="📜 Bot Logs (Virtual Zstd)" FontSize="11">
                <Panel Margin="0,8,0,0">
                    <Border Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <logs:VirtualLogViewControl x:Name="LogViewer"
                                                    NodeId="{Binding NodeId}"
                                                    CollectorEndpoint="noxchat"
                                                    LogMode="{Binding LogMode}"
                                                    TotalRecords="{Binding TotalRecords}"
                                                    FirstSeq="{Binding FirstSeq}"
                                                    LastSeq="{Binding LastSeq}"
                                                    IsFollowMode="{Binding IsFollowMode, Mode=TwoWay}"
                                                    LogCache="{Binding LogCache}"
                                                    CacheRevision="{Binding CacheRevision}"
                                                    ChunkUnavailablePredicate="{Binding IsChunkUnavailablePredicate}"/>
                    </Border>

                    <!-- Floating "Jump to latest (↓)" button -->
                    <Button Command="{Binding ScrollToLatestCommand}"
                            IsVisible="{Binding HasNewLogs}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            CornerRadius="14"
                            Padding="14,6"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="↓" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Jump to latest" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Panel>
            </TabItem>

            <!-- Sub-Tab 2: Raw LLM API Calls -->
            <TabItem Header="🧠 Raw API Calls &amp; Payloads" FontSize="11">
                <Grid ColumnDefinitions="340,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <!-- Left: Calls timeline -->
                    <Border Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="{Binding RecentApiCalls.Count, StringFormat='Intercepted API Calls ({0})'}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="4,2,4,6"/>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="ApiCallsListBox"
                                         ItemsSource="{Binding RecentApiCalls}"
                                         SelectedItem="{Binding SelectedApiCall, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RawApiCallItemModel">
                                            <Border Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8"
                                                    Margin="0,2">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Caller}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DurationMs, StringFormat='{}{0}ms'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Grid>
                                                    <!-- Chat Name Badge -->
                                                    <Border IsVisible="{Binding HasChatName}"
                                                            Background="#162032"
                                                            BorderBrush="#1E3A5F"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,1">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="💬" FontSize="9" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ChatName}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#60A5FA"
                                                                       MaxWidth="170"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Model}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding PromptTokens, StringFormat='In: {0} tok'}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CompletionTokens, StringFormat='Out: {0} tok'}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Floating "Go to newest" Button -->
                                <Button Command="{Binding GoToNewestCommand}"
                                        IsVisible="{Binding ShowGoToNewestButton}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,8,0,0"
                                        Padding="12,5"
                                        CornerRadius="16"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip.Tip="Jump to the newest API call at the top">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="⬆" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="Go to newest" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: Payload / Images Detail -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Panel>
                            <!-- Empty selection placeholder -->
                            <TextBlock IsVisible="{Binding SelectedApiCall, Converter={x:Static ObjectConverters.IsNull}}"
                                       Text="Select a raw LLM API call on the left to inspect syntax prompt JSON and multimodal payloads."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <!-- Active item details -->
                            <Grid IsVisible="{Binding SelectedApiCall, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="10">
                                <!-- Call Header Summary -->
                                <Border Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SelectedApiCall.Caller, FallbackValue=''}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                                <Border IsVisible="{Binding SelectedApiCall.HasChatName, FallbackValue=False}"
                                                        Background="#162032"
                                                        BorderBrush="#1E3A5F"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="💬" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedApiCall.ChatName, FallbackValue=''}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#60A5FA"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedApiCall.Model, FallbackValue=''}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="LATENCY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedApiCall.DurationMs, FallbackValue=0, StringFormat='{}{0} ms'}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="PROMPT TOKENS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedApiCall.PromptTokens, FallbackValue=0}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="2">
                                            <TextBlock Text="COMPLETION TOKENS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedApiCall.CompletionTokens, FallbackValue=0}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- JSON & Image Payloads -->
                                <TabControl Grid.Row="1">
                                    <TabItem Header="💻 Parsed Chat (CLI / Log)" FontSize="11">
                                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                            <ItemsControl ItemsSource="{Binding SelectedApiCall.ParsedTurns}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ParsedTurnItemModel">
                                                        <Border Background="#0D1117"
                                                                BorderBrush="{Binding BorderBrushHex}"
                                                                BorderThickness="1"
                                                                CornerRadius="6"
                                                                Padding="12,10"
                                                                Margin="0,0,0,10">
                                                            <StackPanel Spacing="8">
                                                                <!-- Turn Header Ribbon -->
                                                                <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
                                                                    <Border Background="{Binding HeaderBadgeBackground}"
                                                                            CornerRadius="4"
                                                                            Padding="6,3">
                                                                        <TextBlock Text="{Binding HeaderTitle}"
                                                                                   FontSize="10"
                                                                                   FontWeight="Bold"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   Foreground="{Binding HeaderBadgeForeground}"/>
                                                                    </Border>
                                                                    <TextBlock Grid.Column="2"
                                                                               Text="{Binding TimestampText}"
                                                                               FontSize="9"
                                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                                               VerticalAlignment="Center"/>
                                                                </Grid>

                                                                <!-- System Sections Breakdown (for system prompt turns) -->
                                                                <ItemsControl ItemsSource="{Binding SystemSections}"
                                                                              IsVisible="{Binding HasSystemSections}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ParsedSystemSectionModel">
                                                                            <Border Background="#161226"
                                                                                    BorderBrush="#4C1D95"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="5"
                                                                                    Padding="10,8"
                                                                                    Margin="0,3">
                                                                                <StackPanel Spacing="6">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <TextBlock Text="{Binding SectionIcon}" FontSize="11" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding Header, StringFormat='[SYS // {0}]'}"
                                                                                                   FontSize="10"
                                                                                                   FontWeight="Bold"
                                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                                   Foreground="{Binding BadgeColor}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                    <SelectableTextBlock Text="{Binding Content}"
                                                                                                         FlowDirection="{Binding FlowDirection}"
                                                                                                         TextAlignment="{Binding TextAlignment}"
                                                                                                         FontSize="10.5"
                                                                                                         Foreground="#E2E8F0"
                                                                                                         TextWrapping="Wrap"
                                                                                                         LineHeight="16"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- Chat Entries Breakdown (dynamic RTL/LTR per individual chat entry) -->
                                                                <ItemsControl ItemsSource="{Binding ChatEntries}"
                                                                              IsVisible="{Binding HasChatEntries}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ParsedChatEntryModel">
                                                                            <Border Background="{Binding CardBackgroundHex}"
                                                                                    BorderBrush="{Binding BorderBrushHex}"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="5"
                                                                                    Padding="10,7"
                                                                                    Margin="0,3">
                                                                                <StackPanel Spacing="4">
                                                                                    <!-- Header Ribbon with Sender and optional Bot Badge -->
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasHeader}">
                                                                                        <Border Background="{Binding BadgeBackgroundHex}"
                                                                                                CornerRadius="3"
                                                                                                Padding="5,1"
                                                                                                VerticalAlignment="Center"
                                                                                                IsVisible="{Binding HasBadge}">
                                                                                            <StackPanel Orientation="Horizontal" Spacing="3">
                                                                                                <TextBlock Text="🤖" FontSize="9" VerticalAlignment="Center"/>
                                                                                                <TextBlock Text="{Binding BadgeText}"
                                                                                                           FontSize="9"
                                                                                                           FontWeight="Bold"
                                                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                                                           Foreground="{Binding BadgeForegroundHex}"
                                                                                                           VerticalAlignment="Center"/>
                                                                                            </StackPanel>
                                                                                        </Border>
                                                                                        <TextBlock Text="{Binding Header}"
                                                                                                   FontSize="10"
                                                                                                   FontWeight="Bold"
                                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                                   Foreground="{Binding HeaderForegroundHex}"
                                                                                                   VerticalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                    <SelectableTextBlock Text="{Binding Body}"
                                                                                                         FlowDirection="{Binding FlowDirection}"
                                                                                                         TextAlignment="{Binding TextAlignment}"
                                                                                                         FontSize="11.5"
                                                                                                         Foreground="{Binding TextForegroundHex}"
                                                                                                         TextWrapping="Wrap"
                                                                                                         LineHeight="17"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- Fallback Main Message Text (when ChatEntries are not present) -->
                                                                <SelectableTextBlock Text="{Binding Text}"
                                                                                     FlowDirection="{Binding FlowDirection}"
                                                                                     TextAlignment="{Binding TextAlignment}"
                                                                                     IsVisible="{Binding ShowFallbackText}"
                                                                                     FontSize="11.5"
                                                                                     Foreground="{DynamicResource TextPrimaryBrush}"
                                                                                     TextWrapping="Wrap"
                                                                                     LineHeight="17"/>

                                                                <!-- Thinking / Reasoning Process (for bot turns) -->
                                                                <Border Background="#1C1917"
                                                                        BorderBrush="#B45309"
                                                                        BorderThickness="1"
                                                                        CornerRadius="5"
                                                                        Padding="10,8"
                                                                        IsVisible="{Binding HasThought}">
                                                                    <StackPanel Spacing="4">
                                                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                                                            <TextBlock Text="⚡" FontSize="11" VerticalAlignment="Center"/>
                                                                            <TextBlock Text="[THINKING PROCESS / CHAIN OF THOUGHT]"
                                                                                       FontSize="9"
                                                                                       FontWeight="Bold"
                                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                                       Foreground="#FBBF24"/>
                                                                        </StackPanel>
                                                                        <SelectableTextBlock Text="{Binding ThoughtText}"
                                                                                             FlowDirection="{Binding ThoughtFlowDirection}"
                                                                                             TextAlignment="{Binding ThoughtTextAlignment}"
                                                                                             FontSize="10.5"
                                                                                             Foreground="#FCD34D"
                                                                                             TextWrapping="Wrap"
                                                                                             LineHeight="16"/>
                                                                    </StackPanel>
                                                                </Border>

                                                                <!-- Tool Calls Breakdown -->
                                                                <ItemsControl ItemsSource="{Binding ToolCalls}"
                                                                              IsVisible="{Binding HasToolCalls}">
                                                                    <ItemsControl.ItemTemplate>
                                                                        <DataTemplate x:DataType="vm:ParsedToolCallModel">
                                                                            <Border Background="#1F1322"
                                                                                    BorderBrush="#9D174D"
                                                                                    BorderThickness="1"
                                                                                    CornerRadius="5"
                                                                                    Padding="8,6"
                                                                                    Margin="0,3">
                                                                                <StackPanel Spacing="4">
                                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                                        <TextBlock Text="⚙" FontSize="11" VerticalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding Name, StringFormat='[TOOL CALL: {0}]'}"
                                                                                                   FontSize="9"
                                                                                                   FontWeight="Bold"
                                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                                   Foreground="#F472B6"/>
                                                                                    </StackPanel>
                                                                                    <SelectableTextBlock Text="{Binding Arguments}"
                                                                                                         FontFamily="{StaticResource MonoFontFamily}"
                                                                                                         FontSize="10"
                                                                                                         Foreground="#FBCFE8"
                                                                                                         TextWrapping="Wrap"/>
                                                                                </StackPanel>
                                                                            </Border>
                                                                        </DataTemplate>
                                                                    </ItemsControl.ItemTemplate>
                                                                </ItemsControl>

                                                                <!-- Attached Multimodal Media -->
                                                                <StackPanel Spacing="6" IsVisible="{Binding HasMediaAttachments}">
                                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                                        <TextBlock Text="📎" FontSize="11" VerticalAlignment="Center"/>
                                                                        <TextBlock Text="[ATTACHED MEDIA]"
                                                                                   FontSize="9"
                                                                                   FontWeight="Bold"
                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                   Foreground="#60A5FA"/>
                                                                    </StackPanel>
                                                                    <ItemsControl ItemsSource="{Binding MediaAttachments}">
                                                                        <ItemsControl.ItemsPanel>
                                                                            <ItemsPanelTemplate>
                                                                                <WrapPanel Orientation="Horizontal"/>
                                                                            </ItemsPanelTemplate>
                                                                        </ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate x:DataType="vm:RawApiCallImageItem">
                                                                                <Border Background="{DynamicResource CardBgBrush}"
                                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                                        BorderThickness="1"
                                                                                        CornerRadius="6"
                                                                                        Padding="6"
                                                                                        Margin="0,0,8,8">
                                                                                    <StackPanel Spacing="4">
                                                                                        <Image Source="{Binding Preview}" Width="150" Height="150" Stretch="Uniform"/>
                                                                                        <TextBlock Text="{Binding Label}" FontSize="9" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
                                                                                        <TextBlock Text="{Binding MimeType}" FontSize="8" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Center"/>
                                                                                    </StackPanel>
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>
                                                                </StackPanel>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Prompt Request JSON" FontSize="11">
                                        <TextBox Text="{Binding SelectedApiCall.RequestJson, FallbackValue=''}"
                                                 IsReadOnly="True"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="11"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Margin="0,8,0,0"/>
                                    </TabItem>
                                    <TabItem Header="LLM Response JSON" FontSize="11">
                                        <TextBox Text="{Binding SelectedApiCall.ResponseJson, FallbackValue=''}"
                                                 IsReadOnly="True"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="11"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Margin="0,8,0,0"/>
                                    </TabItem>
                                    <TabItem Header="Multimodal Images" FontSize="11">
                                        <ScrollViewer Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding SelectedApiCall.Images}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RawApiCallImageItem">
                                                        <Border Background="{DynamicResource CardBgBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="8"
                                                                Margin="0,0,10,10">
                                                            <StackPanel Spacing="6">
                                                                <Image Source="{Binding Preview}" Width="180" Height="180" Stretch="Uniform"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
