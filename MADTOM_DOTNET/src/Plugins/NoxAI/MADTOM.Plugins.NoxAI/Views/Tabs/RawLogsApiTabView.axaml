<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.NoxAI.ViewModels"
             xmlns:tabs="using:MADTOM.Plugins.NoxAI.Views.Tabs"
             xmlns:logs="clr-namespace:MadTOM.Controls.Logs;assembly=MADTOM.Plugins.Telemetry"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MADTOM.Plugins.NoxAI.Views.Tabs.RawLogsApiTabView"
             x:DataType="vm:RawLogsApiTabViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <!-- Read-Only Status & Server WAL Spool Ribbon (Mode is configured per-node in Settings) -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <Grid ColumnDefinitions="Auto,Auto,*,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center">
                <!-- Per-Node Mode Badge -->
                <Border Grid.Column="0"
                        Background="{DynamicResource AccentSubtleBrush}"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding ModeBadgeText}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>

                <!-- Live Stream Status -->
                <Border Grid.Column="1"
                        Background="{DynamicResource DarkBaseBrush}"
                        CornerRadius="4"
                        Padding="8,4"
                        VerticalAlignment="Center">
                    <TextBlock Text="{Binding LogStreamStatus}"
                               FontSize="11"
                               FontFamily="{StaticResource MonoFontFamily}"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </Border>

                <!-- WAL Spool Status Summary -->
                <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="SERVER WAL SPOOL (1GB CAP · CONFIGURE IN ⚙ SETTINGS)" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                    <TextBlock Text="{Binding SpoolStatusSummary}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right"/>
                </StackPanel>

                <Button Grid.Column="3" Command="{Binding RefreshSpoolStatusCommand}" Content="🔄 Refresh" Padding="8,4" FontSize="11" ToolTip.Tip="Query server spool usage stats"/>
                <Button Grid.Column="4" Command="{Binding ClearSpoolCommand}" Content="🗑️ Clear Spool" Padding="8,4" FontSize="11" Foreground="#EF4444" ToolTip.Tip="Completely clear server-side spools and reset cached logs and API calls"/>
            </Grid>
        </Border>

        <!-- Sub Tabs: Bot Virtual Logs & Raw API Calls -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedSubViewIndex, Mode=TwoWay}">
            <!-- Sub-Tab 1: Bot System Logs (Zstd Virtual Log View) -->
            <TabItem Header="📜 Bot Logs (Virtual Zstd)" FontSize="11">
                <Grid RowDefinitions="Auto,Auto,*" Margin="0,8,0,0" RowSpacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBox Width="260" MaxLength="4096" PlaceholderText="Search log messages (literal)" Text="{Binding LogQuery, Mode=TwoWay}" KeyDown="OnLogSearchKeyDown"/>
                        <TextBox Width="130" MaxLength="1024" PlaceholderText="Unit (exact)" Text="{Binding LogUnitFilter, Mode=TwoWay}" KeyDown="OnLogSearchKeyDown"/>
                        <ComboBox ItemsSource="{Binding LogTimeRanges}" SelectedItem="{Binding LogTimeRange, Mode=TwoWay}"/>
                        <ComboBox ItemsSource="{Binding LogPriorities}" SelectedItem="{Binding LogPriority, Mode=TwoWay}" ToolTip.Tip="Syslog priority (0–7)"/>
                        <CheckBox Content="Case sensitive" IsChecked="{Binding LogCaseSensitive, Mode=TwoWay}"/>
                        <Button Content="Search" Command="{Binding SearchLogsCommand}" IsEnabled="{Binding !IsLogSearching}"/>
                        <Button Content="Clear" Command="{Binding ClearLogSearchCommand}"/>
                    </StackPanel>
                    <TextBlock Grid.Row="1" Text="{Binding SearchStatus}" FontSize="11" TextWrapping="Wrap"/>
                    <Panel Grid.Row="2">
                    <Grid IsVisible="{Binding ShowLogResults}" RowDefinitions="*,Auto">
                        <ListBox ItemsSource="{Binding LogSearchResults}" SelectedItem="{Binding SelectedLogResult, Mode=TwoWay}">
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:LogSearchResult">
                                    <StackPanel Spacing="4" Margin="4">
                                        <TextBlock Text="{Binding Header}" FontSize="10"/>
                                        <TextBlock TextWrapping="Wrap" FlowDirection="{Binding Direction}"><Run Text="{Binding Before}"/><Run Text="{Binding Match}" FontWeight="Bold" Foreground="#FBBF24"/><Run Text="{Binding After}"/></TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                            <Button Content="Open selected log" Command="{Binding OpenLogResultCommand}"/>
                            <Button Content="Load next page" Command="{Binding MoreLogResultsCommand}" IsEnabled="{Binding HasMoreLogResults}"/>
                        </StackPanel>
                    </Grid>
                    <Border IsVisible="{Binding !ShowLogResults}" Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="4">
                        <logs:VirtualLogViewControl x:Name="LogViewer"
                                                    NodeId="{Binding NodeId}"
                                                    CollectorEndpoint="noxchat"
                                                    AllowHistoricalFetch="True"
                                                    LogMode="{Binding LogMode}"
                                                    TotalRecords="{Binding TotalRecords}"
                                                    FirstSeq="{Binding FirstSeq}"
                                                    LastSeq="{Binding LastSeq}"
                                                    IsFollowMode="{Binding IsFollowMode, Mode=TwoWay}"
                                                    LogCache="{Binding LogCache}"
                                                    CacheRevision="{Binding CacheRevision}"
                                                    ChunkUnavailablePredicate="{Binding IsChunkUnavailablePredicate}"/>
                    </Border>

                    <!-- Floating "Jump to latest (↓)" button -->
                    <Button Command="{Binding ScrollToLatestCommand}"
                            IsVisible="{Binding !ShowLogResults}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            Margin="0,0,0,16"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            CornerRadius="14"
                            Padding="14,6"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="↓" FontWeight="Bold" FontSize="12"/>
                            <TextBlock Text="Jump to latest" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold"/>
                        </StackPanel>
                    </Button>
                </Panel>
                </Grid>
            </TabItem>

            <!-- Sub-Tab 2: Raw LLM API Calls -->
            <TabItem Header="🧠 Raw API Calls &amp; Payloads" FontSize="11">
                <Grid ColumnDefinitions="340,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <!-- Left: Calls timeline -->
                    <Border Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <StackPanel Spacing="4" Margin="4,2,4,6">
                                <TextBlock Text="{Binding ApiFilterScope}" FontSize="10"/>
                                <TextBlock Text="{Binding ApiSearchStatus}" TextWrapping="Wrap" FontSize="10"/>
                                <TextBox PlaceholderText="Filter metadata; Enter searches request/response content" Text="{Binding ApiFilter, Mode=TwoWay}" KeyDown="OnApiSearchKeyDown"/>
                            </StackPanel>
                            <Grid Grid.Row="1">
                                <ListBox x:Name="ApiCallsListBox"
                                         ItemsSource="{Binding FilteredApiCalls}"
                                         SelectedItem="{Binding SelectedApiCall, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:RawApiCallItemModel">
                                            <Border Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8"
                                                    Margin="0,2">
                                                <StackPanel Spacing="3">
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Caller}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding DurationMs, StringFormat='{}{0}ms'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Grid>
                                                    <!-- Chat Name Badge -->
                                                    <Border IsVisible="{Binding HasChatName}"
                                                            Background="#162032"
                                                            BorderBrush="#1E3A5F"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="5,2"
                                                            HorizontalAlignment="Left"
                                                            Margin="0,1">
                                                        <StackPanel Orientation="Horizontal" Spacing="4">
                                                            <TextBlock Text="💬" FontSize="9" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ChatName}"
                                                                       FontSize="10"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="#60A5FA"
                                                                       MaxWidth="170"
                                                                       TextTrimming="CharacterEllipsis"
                                                                       VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </Border>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding Model}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Grid>
                                                    <Grid ColumnDefinitions="*,Auto">
                                                        <TextBlock Text="{Binding PromptTokens, StringFormat='In: {0} tok'}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding CompletionTokens, StringFormat='Out: {0} tok'}" FontSize="9" Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </Grid>
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>

                                <!-- Floating "Go to newest" Button -->
                                <Button Command="{Binding GoToNewestCommand}"
                                        IsVisible="{Binding ShowGoToNewestButton}"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Margin="0,8,0,0"
                                        Padding="12,5"
                                        CornerRadius="16"
                                        Background="#2563EB"
                                        Foreground="White"
                                        BorderThickness="0"
                                        Cursor="Hand"
                                        ToolTip.Tip="Jump to the newest API call at the top">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Text="⬆" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="Go to newest" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Right: Payload / Images Detail -->
                    <Border Grid.Column="1"
                            Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <Panel>
                            <!-- Empty selection placeholder -->
                            <TextBlock IsVisible="{Binding SelectedApiCall, Converter={x:Static ObjectConverters.IsNull}}"
                                       Text="Select a raw LLM API call on the left to inspect syntax prompt JSON and multimodal payloads."
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>

                            <!-- Active item details -->
                            <Grid IsVisible="{Binding SelectedApiCall, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  RowDefinitions="Auto,*"
                                  RowSpacing="10">
                                <!-- Call Header Summary -->
                                <Border Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="10">
                                    <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                                        <StackPanel Spacing="2">
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding SelectedApiCall.Caller, FallbackValue=''}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                                <Border IsVisible="{Binding SelectedApiCall.HasChatName, FallbackValue=False}"
                                                        Background="#162032"
                                                        BorderBrush="#1E3A5F"
                                                        BorderThickness="1"
                                                        CornerRadius="4"
                                                        Padding="6,2"
                                                        VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                                        <TextBlock Text="💬" FontSize="10" VerticalAlignment="Center"/>
                                                        <TextBlock Text="{Binding SelectedApiCall.ChatName, FallbackValue=''}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="#60A5FA"
                                                                   VerticalAlignment="Center"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Text="{Binding SelectedApiCall.Model, FallbackValue=''}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Spacing="2">
                                            <TextBlock Text="LATENCY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedApiCall.DurationMs, FallbackValue=0, StringFormat='{}{0} ms'}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Spacing="2">
                                            <TextBlock Text="PROMPT TOKENS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedApiCall.PromptTokens, FallbackValue=0}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="3" Spacing="2">
                                            <TextBlock Text="COMPLETION TOKENS" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                            <TextBlock Text="{Binding SelectedApiCall.CompletionTokens, FallbackValue=0}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>

                                <!-- JSON & Image Payloads -->
                                <TabControl Grid.Row="1">
                                    <TabItem Header="💻 Parsed Chat (CLI / Log)" FontSize="11">
                                        <ScrollViewer Margin="0,8,0,0" VerticalScrollBarVisibility="Auto">
                                            <tabs:ParsedCallTurnsView DataContext="{Binding SelectedApiCall}"/>
                                        </ScrollViewer>
                                    </TabItem>
                                    <TabItem Header="Prompt Request JSON" FontSize="11">
                                        <TextBox Text="{Binding SelectedApiCall.RequestJson, FallbackValue=''}"
                                                 IsReadOnly="True"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="11"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Margin="0,8,0,0"/>
                                    </TabItem>
                                    <TabItem Header="LLM Response JSON" FontSize="11">
                                        <TextBox Text="{Binding SelectedApiCall.ResponseJson, FallbackValue=''}"
                                                 IsReadOnly="True"
                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                 FontSize="11"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 Margin="0,8,0,0"/>
                                    </TabItem>
                                    <TabItem Header="Multimodal Images" FontSize="11">
                                        <ScrollViewer Margin="0,8,0,0">
                                            <ItemsControl ItemsSource="{Binding SelectedApiCall.Images}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:RawApiCallImageItem">
                                                        <Border Background="{DynamicResource CardBgBrush}"
                                                                BorderBrush="{DynamicResource BorderBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="8"
                                                                Padding="8"
                                                                Margin="0,0,10,10">
                                                            <StackPanel Spacing="6">
                                                                <Image Source="{Binding Preview}" Width="180" Height="180" Stretch="Uniform"/>
                                                                <TextBlock Text="{Binding Label}" FontSize="10" HorizontalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </ScrollViewer>
                                    </TabItem>
                                </TabControl>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>
            </TabItem>
            <!-- Sub-Tab 3: Raw API calls grouped per chat (same rendering as Raw API Calls & Payloads) -->
            <TabItem Header="💬 Chats" FontSize="11">
                <Grid ColumnDefinitions="250,*" ColumnSpacing="10" Margin="0,8,0,0">
                    <!-- Left: chats / DMs -->
                    <Border Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="6">
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="4">
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="4">
                                <TextBox PlaceholderText="Filter chats (title, type, id)" Text="{Binding ChatFilter, Mode=TwoWay}" FontSize="11"/>
                                <Button Grid.Column="1" Content="⟳" Command="{Binding RefreshChatsCommand}" Padding="8,3" ToolTip.Tip="Reload the chat list from the bot"/>
                            </Grid>
                            <TextBlock Grid.Row="1" Text="{Binding ChatListStatus}" FontSize="9" TextWrapping="Wrap"
                                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                            <ListBox Grid.Row="2" ItemsSource="{Binding ChatGroups}" SelectedItem="{Binding SelectedChatGroup, Mode=TwoWay}"
                                     Background="Transparent" BorderThickness="0">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="6,3"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ChatGroupModel">
                                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto" ColumnSpacing="6">
                                            <TextBlock Text="{Binding Title}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{DynamicResource AccentTextBrush}" ToolTip.Tip="Loaded API calls"/>
                                            <TextBlock Grid.Row="1" Text="{Binding MetaLine}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding LastActiveText}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Right: the selected chat's entire call history -->
                    <Border Grid.Column="1" Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="8">
                        <Panel>
                            <TextBlock IsVisible="{Binding SelectedChatGroup, Converter={x:Static ObjectConverters.IsNull}}"
                                       Text="Select a chat on the left to inspect its full API call history."
                                       FontSize="11" Foreground="{DynamicResource TextMutedBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <Grid IsVisible="{Binding SelectedChatGroup, Converter={x:Static ObjectConverters.IsNotNull}}"
                                  RowDefinitions="Auto,Auto,Auto,*" RowSpacing="6">
                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1" CornerRadius="6" Padding="10,6">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                        <TextBlock Text="{Binding SelectedChatGroup.Title, FallbackValue=''}" FontSize="13" FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" MaxWidth="360" TextTrimming="CharacterEllipsis"/>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock Text="{Binding SelectedChatGroup.MetaLine, FallbackValue=''}" FontSize="10"
                                                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ChatHistoryStatus}" FontSize="9" TextTrimming="CharacterEllipsis"
                                                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </StackPanel>
                                        <CheckBox Grid.Column="2" Content="Trace events" IsChecked="{Binding ChatShowTraceEvents, Mode=TwoWay}" FontSize="10"
                                                  ToolTip.Tip="Interleave non-LLM trace events (tool results, jobs) recorded for this chat"/>
                                    </Grid>
                                </Border>

                                <!-- Chat Content Search Bar -->
                                <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="6">
                                    <TextBox x:Name="ChatContentSearchBox"
                                             Text="{Binding ChatContentSearchQuery, Mode=TwoWay}"
                                             PlaceholderText="🔍 Search messages, prompts, responses &amp; trace events in this chat (Press Enter for full probe search)…"
                                             FontSize="11"
                                             KeyDown="OnChatContentSearchKeyDown"/>
                                    <Button Grid.Column="1"
                                            Content="🔍 Search All"
                                            Command="{Binding SearchChatHistoryCommand}"
                                            IsEnabled="{Binding !IsChatContentSearching}"
                                            Padding="10,4"
                                            FontSize="10"
                                            FontWeight="SemiBold"/>
                                    <Button Grid.Column="2"
                                            Content="✕ Clear"
                                            Command="{Binding ClearChatHistorySearchCommand}"
                                            IsVisible="{Binding IsChatContentSearchActive}"
                                            Padding="8,4"
                                            FontSize="10"/>
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding ChatContentSearchStatus}"
                                               IsVisible="{Binding ChatContentSearchStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontSize="9"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"
                                               MaxWidth="280"
                                               TextTrimming="CharacterEllipsis"/>
                                </Grid>

                                <!-- Older calls also load automatically when scrolling near the top -->
                                <Button Grid.Row="2" Content="↑ Load 100 older calls" Command="{Binding LoadOlderChatCommand}"
                                        IsVisible="{Binding ChatHasOlder}" HorizontalAlignment="Center" Padding="10,2" FontSize="10"/>

                                <Panel Grid.Row="3">
                                <ScrollViewer x:Name="ChatHistoryScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                    <ItemsControl ItemsSource="{Binding ChatHistory}">
                                        <ItemsControl.ItemsPanel>
                                            <!-- Windowed StackPanel eliminates VirtualizingStackPanel height re-estimation jumps during async payload expansion -->
                                            <ItemsPanelTemplate><StackPanel/></ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.DataTemplates>
                                            <!-- One API call: header with the same fields as the Raw API detail header, then the parsed turns -->
                                            <DataTemplate DataType="vm:RawApiCallItemModel">
                                                <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="1" CornerRadius="6" Padding="8" Margin="0,0,4,8">
                                                    <StackPanel Spacing="6">
                                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto" ColumnSpacing="10">
                                                            <TextBlock Text="{Binding Caller}" FontSize="11" FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="1" Text="{Binding TimestampText}" FontSize="10" VerticalAlignment="Center"
                                                                       FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                            <TextBlock Grid.Column="2" Text="{Binding Model}" FontSize="10" VerticalAlignment="Center"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DurationMs, StringFormat='{}{0} ms'}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                <TextBlock Text="{Binding PromptTokens, StringFormat='in {0}'}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Text="{Binding CompletionTokens, StringFormat='out {0}'}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <TextBlock Text="{Binding CallId}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                                <Button Content="Open in Raw API" FontSize="9" Padding="6,1"
                                                                        Command="{Binding $parent[tabs:RawLogsApiTabView].((vm:RawLogsApiTabViewModel)DataContext).OpenCallInRawCommand, FallbackValue={x:Null}}"
                                                                        CommandParameter="{Binding}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                        <SelectableTextBlock Text="{Binding ErrorMessage}" Foreground="#F87171" FontSize="10" TextWrapping="Wrap"
                                                                             IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                        <TextBlock Text="Loading payload…" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"
                                                                   IsVisible="{Binding !IsDetailsLoaded}"/>
                                                        <tabs:ParsedCallTurnsView/>
                                                        <StackPanel Orientation="Horizontal" Spacing="6" IsVisible="{Binding IsDetailsLoaded}">
                                                            <ToggleButton Content="Request JSON" IsChecked="{Binding ShowRequestJson, Mode=TwoWay}" FontSize="9" Padding="6,1" MinHeight="0"/>
                                                            <ToggleButton Content="Response JSON" IsChecked="{Binding ShowResponseJson, Mode=TwoWay}" FontSize="9" Padding="6,1" MinHeight="0"/>
                                                            <TextBlock Text="{Binding Images.Count, StringFormat='{}{0} image(s) in prompt'}" IsVisible="{Binding HasImages}"
                                                                       FontSize="9" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}"/>
                                                        </StackPanel>
                                                        <TextBox Text="{Binding RequestJson}" IsVisible="{Binding ShowRequestJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                                 MaxHeight="420" FontFamily="{StaticResource MonoFontFamily}" FontSize="10"/>
                                                        <TextBox Text="{Binding ResponseJson}" IsVisible="{Binding ShowResponseJson}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"
                                                                 MaxHeight="420" FontFamily="{StaticResource MonoFontFamily}" FontSize="10"/>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                            <!-- Non-call trace event: one dense line -->
                                            <DataTemplate DataType="vm:ChatTraceRowModel">
                                                <Border Background="#0B1220" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1"
                                                        CornerRadius="4" Padding="8,3" Margin="0,0,4,6">
                                                    <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="8">
                                                        <TextBlock Text="{Binding TimestampText}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="9" FontWeight="Bold"
                                                                   FontFamily="{StaticResource MonoFontFamily}" Foreground="#A78BFA"/>
                                                        <SelectableTextBlock Grid.Column="2" Text="{Binding Content}" FontSize="10" TextWrapping="Wrap"
                                                                             FontFamily="{StaticResource MonoFontFamily}" Foreground="#CBD5E1"/>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.DataTemplates>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Button x:Name="ChatJumpToNewest" IsVisible="False" Click="OnChatJumpToNewest"
                                        HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                                        Padding="12,5" CornerRadius="16" Background="#2563EB" Foreground="White" BorderThickness="0" Cursor="Hand">
                                    <TextBlock Text="⬇ Jump to newest" FontSize="11" FontWeight="SemiBold"/>
                                </Button>
                                </Panel>
                            </Grid>
                        </Panel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
