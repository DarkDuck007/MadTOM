<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.NoxAI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="780"
             x:Class="MADTOM.Plugins.NoxAI.Views.Tabs.AutomationTabView"
             x:DataType="vm:AutomationTabViewModel">

    <Panel>
        <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="16" RowSpacing="10">

            <!-- Top Toolbar: Chat Filter & Refresh -->
            <Border Grid.Row="0"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,8">
                <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Chat ID filter:" FontSize="11" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <TextBox Text="{Binding ChatFilterText, Mode=TwoWay}"
                             PlaceholderText="All chats"
                             Width="140"
                             FontSize="11"
                             VerticalAlignment="Center"/>
                    <Button Command="{Binding RefreshCommand}"
                            Content="🔄 Refresh Status, Preprocessors &amp; Crons"
                            Padding="10,4"
                            FontSize="11"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding !IsBusy}"/>
                    <Button Command="{Binding RefreshLogsCommand}"
                            Content="📜 Refresh Logs"
                            Padding="10,4"
                            FontSize="11"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding !IsBusy}"/>
                </WrapPanel>
            </Border>

            <!-- Per-Chat Status Grid at Top (highlight SayStreak when >= 4) -->
            <Border Grid.Row="1"
                    Background="{DynamicResource DarkBaseBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    MaxHeight="170"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1"
                            Padding="12,6">
                        <Grid ColumnDefinitions="200,90,115,75,90,90,90,*" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="CHAT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="SAY STREAK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="PREPROCESSORS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="CRONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="RUNS (1H)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="5" Text="SAYS (1H)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="6" Text="FIRES TODAY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="7" Text="NEXT FIRE AT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                    </Border>

                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Chats}"
                             Background="Transparent"
                             BorderThickness="0">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="4,2"/>
                                <Setter Property="Margin" Value="0"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:AutomationChatRow">
                                <Border Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderSubtleBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="0,1">
                                    <Grid ColumnDefinitions="200,90,115,75,90,90,90,*" ColumnSpacing="8" VerticalAlignment="Center">
                                        <TextBlock Grid.Column="0" Text="{Binding ChatDisplay}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ChatDisplay}" VerticalAlignment="Center"/>

                                        <!-- Highlight SayStreak when >= 4 -->
                                        <Border Grid.Column="1"
                                                Classes.streakWarn="{Binding IsHighSayStreak}"
                                                Background="{DynamicResource DarkBaseBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center">
                                            <Border.Styles>
                                                <Style Selector="Border.streakWarn">
                                                    <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                                                    <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                </Style>
                                                <Style Selector="Border.streakWarn TextBlock">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    <Setter Property="FontWeight" Value="Bold"/>
                                                </Style>
                                            </Border.Styles>
                                            <TextBlock Text="{Binding SayStreak}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}"/>
                                        </Border>

                                        <TextBlock Grid.Column="2" Text="{Binding PreprocessorsDisplay}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Crons}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding RunsLastHour}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding SaysLastHour}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="6" Text="{Binding FiresToday}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="7" Text="{Binding NextFireAt}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

            <!-- Main Sub-Tabs: Preprocessors | Crons | Logs -->
            <TabControl Grid.Row="2" Padding="0">

                <!-- ============================================================== -->
                <!-- 1. Preprocessors Sub-Tab                                       -->
                <!-- ============================================================== -->
                <TabItem Header="⚙ Preprocessors" FontSize="12">
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12" Margin="0,8,0,0">
                        <!-- Preprocessors List -->
                        <Border Grid.Column="0"
                                Background="{DynamicResource DarkBaseBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,7">
                                    <Grid ColumnDefinitions="45,85,*,55,90,70,60,55,*" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Text="ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="CHAT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="3" Text="KIND" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="4" Text="TRIGGERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="5" Text="STATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="6" Text="RUNS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="7" Text="ERRORS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="8" Text="LAST ERROR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Preprocessors}"
                                         SelectedItem="{Binding SelectedPreprocessor, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.Styles>
                                        <Style Selector="ListBoxItem">
                                            <Setter Property="Padding" Value="4,2"/>
                                            <Setter Property="Margin" Value="0"/>
                                        </Style>
                                    </ListBox.Styles>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:PreprocessorRow">
                                            <Border Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="45,85,*,55,90,70,60,55,*" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ChatId}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding Kind}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Triggers}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding EnabledBadge}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding Runs}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding ErrorCount}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding LastError}" ToolTip.Tip="{Binding LastError}" FontSize="10" Foreground="{DynamicResource CriticalBrush}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <!-- Preprocessor Details Pane -->
                        <Border Grid.Column="1"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12">
                            <Grid RowDefinitions="Auto,*,Auto,Auto" RowSpacing="8">
                                <!-- Actions Bar -->
                                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBlock Text="{Binding SelectedPreprocessor.Name, FallbackValue='PREPROCESSOR DETAILS'}"
                                               FontSize="11"
                                               FontWeight="Bold"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               Foreground="{DynamicResource AccentTextBrush}"
                                               VerticalAlignment="Center"/>

                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" IsEnabled="{Binding HasSelectedPreprocessor}">
                                        <Button Command="{Binding EnablePreprocessorCommand}"
                                                Content="Enable"
                                                Padding="8,3"
                                                FontSize="11"/>
                                        <Button Command="{Binding DisablePreprocessorCommand}"
                                                Content="Disable"
                                                Padding="8,3"
                                                FontSize="11"/>
                                        <Button Command="{Binding ResetErrorsCommand}"
                                                Content="Reset errors"
                                                Padding="8,3"
                                                FontSize="11"/>

                                        <!-- Reset State with Confirmation Flyout -->
                                        <Button Content="Reset state"
                                                Padding="8,3"
                                                FontSize="11"
                                                Foreground="{DynamicResource WarningBrush}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                    <StackPanel Spacing="8" Width="220" Margin="4">
                                                        <TextBlock Text="Reset persisted state JSON for this preprocessor?"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"/>
                                                        <Button Command="{Binding ResetStateCommand}"
                                                                Content="Confirm Reset State"
                                                                Background="{DynamicResource WarningBrush}"
                                                                Foreground="White"
                                                                FontWeight="Bold"
                                                                HorizontalAlignment="Right"
                                                                Padding="10,4"
                                                                FontSize="11"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>

                                        <!-- Delete with Confirmation Flyout -->
                                        <Button Content="Delete"
                                                Padding="8,3"
                                                FontSize="11"
                                                Foreground="{DynamicResource CriticalBrush}">
                                            <Button.Flyout>
                                                <Flyout Placement="BottomEdgeAlignedRight">
                                                    <StackPanel Spacing="8" Width="220" Margin="4">
                                                        <TextBlock Text="Delete this preprocessor permanently?"
                                                                   TextWrapping="Wrap"
                                                                   FontSize="11"/>
                                                        <Button Command="{Binding DeletePreprocessorCommand}"
                                                                Content="Confirm Delete"
                                                                Background="{DynamicResource CriticalBrush}"
                                                                Foreground="White"
                                                                FontWeight="Bold"
                                                                HorizontalAlignment="Right"
                                                                Padding="10,4"
                                                                FontSize="11"/>
                                                    </StackPanel>
                                                </Flyout>
                                            </Button.Flyout>
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <!-- Read-only Monospace Code TextBox (no execution, no rendering) -->
                                <StackPanel Grid.Row="1" Spacing="4">
                                    <TextBlock Text="CODE (READ-ONLY)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding SelectedCode, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="{StaticResource MonoFontFamily}"
                                             FontSize="11"
                                             MinHeight="120"/>
                                </StackPanel>

                                <!-- State JSON -->
                                <StackPanel Grid.Row="2" Spacing="4">
                                    <TextBlock Text="STATE JSON (READ-ONLY)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding SelectedState, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="{StaticResource MonoFontFamily}"
                                             FontSize="11"
                                             Height="60"/>
                                </StackPanel>

                                <!-- Static Actions JSON -->
                                <StackPanel Grid.Row="3" Spacing="4">
                                    <TextBlock Text="STATIC ACTIONS JSON (READ-ONLY)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBox Text="{Binding SelectedStaticActions, Mode=OneWay}"
                                             IsReadOnly="True"
                                             AcceptsReturn="True"
                                             TextWrapping="NoWrap"
                                             FontFamily="{StaticResource MonoFontFamily}"
                                             FontSize="11"
                                             Height="60"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================================================== -->
                <!-- 2. Crons Sub-Tab                                               -->
                <!-- ============================================================== -->
                <TabItem Header="⏰ Crons" FontSize="12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,8,0,0">
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8">
                            <StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding HasSelectedCron}">
                                <Button Command="{Binding EnableCronCommand}"
                                        Content="Enable"
                                        Padding="10,4"
                                        FontSize="11"/>
                                <Button Command="{Binding DisableCronCommand}"
                                        Content="Disable"
                                        Padding="10,4"
                                        FontSize="11"/>

                                <!-- Cancel Cron with Confirmation Flyout -->
                                <Button Content="Cancel Cron"
                                        Padding="10,4"
                                        FontSize="11"
                                        Foreground="{DynamicResource CriticalBrush}">
                                    <Button.Flyout>
                                        <Flyout Placement="BottomEdgeAlignedRight">
                                            <StackPanel Spacing="8" Width="220" Margin="4">
                                                <TextBlock Text="Cancel this scheduled cron permanently?"
                                                           TextWrapping="Wrap"
                                                           FontSize="11"/>
                                                <Button Command="{Binding CancelCronCommand}"
                                                        Content="Confirm Cancel"
                                                        Background="{DynamicResource CriticalBrush}"
                                                        Foreground="White"
                                                        FontWeight="Bold"
                                                        HorizontalAlignment="Right"
                                                        Padding="10,4"
                                                        FontSize="11"/>
                                            </StackPanel>
                                        </Flyout>
                                    </Button.Flyout>
                                </Button>
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource DarkBaseBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,7">
                                    <Grid ColumnDefinitions="50,90,140,140,70,180,170,65,75,55" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Text="ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="CHAT ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="NAME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="3" Text="PREPROCESSOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="4" Text="KIND" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="5" Text="SPEC" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="6" Text="NEXT FIRE AT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="7" Text="FIRES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="8" Text="STATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="9" Text="DEPTH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Crons}"
                                         SelectedItem="{Binding SelectedCron, Mode=TwoWay}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CronRow">
                                            <Border Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="50,90,140,140,70,180,170,65,75,55" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding ChatId}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding Name}" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding PreprocessorName}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding SpecKind}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Spec}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding NextFireAt}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="7" Text="{Binding Fires}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="8" Text="{Binding EnabledBadge}" FontSize="9" FontWeight="Bold" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="9" Text="{Binding Depth}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>

                <!-- ============================================================== -->
                <!-- 3. Logs Sub-Tab                                                -->
                <!-- ============================================================== -->
                <TabItem Header="📜 Logs" FontSize="12">
                    <Grid RowDefinitions="Auto,*" RowSpacing="10" Margin="0,8,0,0">
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="12,8">
                            <WrapPanel Orientation="Horizontal" ItemSpacing="10" LineSpacing="6" VerticalAlignment="Center">
                                <CheckBox IsChecked="{Binding LogsForSelectedOnly, Mode=TwoWay}"
                                          Content="Selected preprocessor only"
                                          FontSize="11"
                                          VerticalAlignment="Center"/>
                                <Button Command="{Binding RefreshLogsCommand}"
                                        Content="🔄 Refresh"
                                        Padding="10,4"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding !IsBusy}"/>
                                <Button Command="{Binding PrevLogsPageCommand}"
                                        Content="◀ Prev 50"
                                        Padding="10,4"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding !IsBusy}"/>
                                <TextBlock Text="{Binding LogsPageLabel}"
                                           FontSize="11"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           VerticalAlignment="Center"/>
                                <Button Command="{Binding NextLogsPageCommand}"
                                        Content="Next 50 ▶"
                                        Padding="10,4"
                                        FontSize="11"
                                        VerticalAlignment="Center"
                                        IsEnabled="{Binding !IsBusy}"/>
                            </WrapPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Background="{DynamicResource DarkBaseBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                ClipToBounds="True">
                            <Grid RowDefinitions="Auto,*">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="12,7">
                                    <Grid ColumnDefinitions="60,165,140,80,90,*,75" ColumnSpacing="6">
                                        <TextBlock Grid.Column="0" Text="ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="1" Text="AT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="2" Text="PREPROCESSOR" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="3" Text="EVENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="4" Text="OUTCOME" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="5" Text="DETAIL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Grid.Column="6" Text="DUR (MS)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                    </Grid>
                                </Border>

                                <ListBox Grid.Row="1"
                                         ItemsSource="{Binding Logs}"
                                         Background="Transparent"
                                         BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:AutomationLogRow">
                                            <Border Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="8,5"
                                                    Margin="0,1">
                                                <Grid ColumnDefinitions="60,165,140,80,90,*,75" ColumnSpacing="6" VerticalAlignment="Center">
                                                    <TextBlock Grid.Column="0" Text="{Binding Id}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding At}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding PreprocessorName}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding EventKind}" FontSize="10" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="4" Text="{Binding Outcome}" FontSize="10" FontWeight="SemiBold" FontFamily="{StaticResource MonoFontFamily}" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="5" Text="{Binding Detail}" ToolTip.Tip="{Binding Detail}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                                    <TextBlock Grid.Column="6" Text="{Binding DurationMs}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>

            <!-- Collapsible Effective Config Read-Only TextBox -->
            <Expander Grid.Row="3"
                      Header="Effective config"
                      IsExpanded="False"
                      HorizontalAlignment="Stretch">
                <TextBox Text="{Binding ConfigJson, Mode=OneWay}"
                         IsReadOnly="True"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="11"
                         MaxHeight="140"/>
            </Expander>

            <!-- Bottom Status / Error Line -->
            <Border Grid.Row="4"
                    Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="12,6">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding StatusMessage}"
                               IsVisible="{Binding !HasError}"/>
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource CriticalBrush}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip.Tip="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"/>
                </Grid>
            </Border>
        </Grid>

        <!-- Programmatic Confirmation Modal Overlay (when RequireConfirmation == true) -->
        <Border IsVisible="{Binding IsConfirmOpen}" Background="#B0000000">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="18"
                    Width="440"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <StackPanel Spacing="14">
                    <TextBlock Text="{Binding ConfirmTitle}" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="{Binding ConfirmMessage}" TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                        <Button Command="{Binding CancelConfirmCommand}" Content="Cancel" Padding="12,5"/>
                        <Button Command="{Binding ConfirmPendingCommand}"
                                Content="Confirm"
                                Background="{DynamicResource CriticalBrush}"
                                Foreground="White"
                                FontWeight="Bold"
                                Padding="12,5"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Border>
    </Panel>
</UserControl>
