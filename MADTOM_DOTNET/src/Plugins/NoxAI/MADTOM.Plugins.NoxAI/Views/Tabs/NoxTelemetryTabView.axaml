<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.NoxAI.ViewModels"
             xmlns:charts="clr-namespace:MadTOM.Controls.Charts;assembly=MADTOM.Plugins.Telemetry"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="700"
             x:Class="MADTOM.Plugins.NoxAI.Views.Tabs.NoxTelemetryTabView"
             x:DataType="vm:NoxTelemetryTabViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="12">
        <!-- Live Metric Summary Cards -->
        <Grid Grid.Row="0" ColumnDefinitions="*,*,*,*" ColumnSpacing="10">
            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="LLM TOKEN THROUGHPUT" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding TokenThroughputSummary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="PYTHON PROCESS MEMORY" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding ProcessMemorySummary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HealthyBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="PYTHON PROCESS CPU" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding CpuSummary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                <StackPanel Spacing="3">
                    <TextBlock Text="ASYNCIO &amp; EVENT LOOP" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                    <TextBlock Text="{Binding RuntimeSummary}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Time-Series Chart Container -->
        <Border Grid.Row="1"
                Background="{DynamicResource DarkBaseBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16">
            <Grid RowDefinitions="Auto,*">
                <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                    <TextBlock Text="NOXCHAT USAGE &amp; PYTHON RUNTIME POV TELEMETRY (1 HZ STREAM)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding TimeRanges}" SelectedItem="{Binding SelectedTimeRange, Mode=TwoWay}" Width="100"/>
                </Grid>
                <Grid Grid.Row="1" RowDefinitions="*,*" RowSpacing="12">
                    <!-- LLM Token Usage Chart -->
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="LLM Tokens (In / Out / Cached)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,4"/>
                            <charts:MetricHistoryChartControl Grid.Row="1"
                                                              SeriesList="{Binding TokenSeries}"
                                                              WindowStart="{Binding WindowStart}"
                                                              WindowEnd="{Binding WindowEnd}"
                                                              GraphTitle="LLM Tokens"
                                                              MinHeight="180"/>
                        </Grid>
                    </Border>

                    <!-- Python Runtime Process Telemetry Chart -->
                    <Border Grid.Row="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="1" CornerRadius="6" Padding="8">
                        <Grid RowDefinitions="Auto,*">
                            <TextBlock Text="Python Runtime POV (CPU % / RSS MiB / Event Loop Lag ms)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" Margin="4,0,0,4"/>
                            <charts:MetricHistoryChartControl Grid.Row="1"
                                                              SeriesList="{Binding RuntimeSeries}"
                                                              WindowStart="{Binding WindowStart}"
                                                              WindowEnd="{Binding WindowEnd}"
                                                              GraphTitle="Python Runtime"
                                                              MinHeight="180"/>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
