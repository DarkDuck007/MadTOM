<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.NoxAI.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="MADTOM.Plugins.NoxAI.Views.Tabs.TipsTabView"
             x:DataType="vm:TipsTabViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">
        <!-- 1. Top Toolbar Row -->
        <Border Grid.Row="0"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <WrapPanel Orientation="Horizontal" ItemSpacing="8" LineSpacing="6" VerticalAlignment="Center">
                    <TextBox Text="{Binding FilterText, Mode=TwoWay}"
                             PlaceholderText="Filter text…"
                             MinWidth="170"
                             VerticalAlignment="Center"
                             KeyDown="OnFilterKeyDown"/>

                    <ComboBox SelectedIndex="{Binding FilterScopeIndex, Mode=TwoWay}"
                              MinWidth="100"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Filter by scope">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Global"/>
                        <ComboBoxItem Content="Chat"/>
                        <ComboBoxItem Content="Persona"/>
                    </ComboBox>

                    <TextBox Text="{Binding FilterScopeValue, Mode=TwoWay}"
                             PlaceholderText="{Binding FilterScopeValuePlaceholder}"
                             IsVisible="{Binding ShowFilterScopeValue}"
                             MinWidth="115"
                             VerticalAlignment="Center"
                             KeyDown="OnFilterKeyDown"/>

                    <ComboBox SelectedIndex="{Binding FilterStatusIndex, Mode=TwoWay}"
                              MinWidth="105"
                              VerticalAlignment="Center"
                              ToolTip.Tip="Filter by status">
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Active"/>
                        <ComboBoxItem Content="Proposed"/>
                        <ComboBoxItem Content="Rejected"/>
                    </ComboBox>

                    <ToggleButton IsChecked="{Binding OnlyAwaitingApproval, Mode=TwoWay}"
                                  Padding="10,4"
                                  FontSize="11"
                                  VerticalAlignment="Center">
                        <TextBlock Text="{Binding ProposedCount, StringFormat='Awaiting approval ({0})'}"/>
                    </ToggleButton>

                    <Button Command="{Binding RefreshCommand}"
                            Content="🔄 Refresh"
                            Padding="10,4"
                            FontSize="11"
                            VerticalAlignment="Center"
                            IsEnabled="{Binding !IsBusy}"/>
                </WrapPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Border Background="{DynamicResource DarkBaseBrush}"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding TotalCountLabel}"
                                   FontSize="11"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Border>

                    <Border Background="{DynamicResource WarningSubtleBrush}"
                            BorderBrush="{DynamicResource WarningBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center"
                            IsVisible="{Binding HasQueue}">
                        <TextBlock Text="{Binding QueueSize, StringFormat='embedding queue: {0}'}"
                                   FontSize="10"
                                   FontWeight="SemiBold"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   Foreground="{DynamicResource WarningBrush}"/>
                    </Border>

                    <TextBlock Text="{Binding SettingsSummary}"
                               FontSize="10"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"
                               IsVisible="{Binding SettingsSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 2. Main Area (2:1 split) -->
        <Grid Grid.Row="1" ColumnDefinitions="2*,*" ColumnSpacing="12">
            <!-- Left: Tips List + Selected Tip Edit Panel -->
            <Grid Grid.Column="0" RowDefinitions="*,Auto" RowSpacing="10">
                <Border Grid.Row="0"
                        Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Column Header -->
                        <Border Grid.Row="0"
                                Background="{DynamicResource CardBgBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="0,0,0,1"
                                Padding="14,7">
                            <Grid ColumnDefinitions="78,105,54,84,*,44,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="STATE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="SCOPE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="BY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="4" Text="TEXT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="5" Text="USES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                                <TextBlock Grid.Column="6" Text="ACTIONS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <!-- Tips List -->
                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Tips}"
                                 SelectedItem="{Binding SelectedTip, Mode=TwoWay}"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="Margin" Value="0"/>
                                </Style>
                            </ListBox.Styles>
                            <ListBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:TipRowModel">
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="10,7"
                                            Margin="0,1">
                                        <Grid ColumnDefinitions="78,105,54,84,*,44,Auto" ColumnSpacing="8">
                                            <!-- State Badge -->
                                            <Border Grid.Column="0"
                                                    Classes.pending="{Binding IsPending}"
                                                    Classes.ready="{Binding IsReady}"
                                                    Classes.failed="{Binding IsFailed}"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    BorderThickness="1"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center"
                                                    ToolTip.Tip="{Binding ErrorTooltip}">
                                                <Border.Styles>
                                                    <Style Selector="Border.pending">
                                                        <Setter Property="Background" Value="{DynamicResource WarningSubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource WarningBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.ready">
                                                        <Setter Property="Background" Value="{DynamicResource HealthySubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource HealthyBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.failed">
                                                        <Setter Property="Background" Value="{DynamicResource CriticalSubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.pending TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.ready TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource HealthyBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.failed TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                    </Style>
                                                </Border.Styles>
                                                <TextBlock Text="{Binding StateLabel}" FontSize="9" FontWeight="Bold"/>
                                            </Border>

                                            <!-- Scope -->
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding ScopeLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"
                                                       TextTrimming="CharacterEllipsis"
                                                       ToolTip.Tip="{Binding ScopeLabel}"/>

                                            <!-- Author -->
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding AuthorLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       VerticalAlignment="Center"/>

                                            <!-- Status -->
                                            <Border Grid.Column="3"
                                                    Classes.proposed="{Binding IsProposed}"
                                                    Classes.rejected="{Binding IsRejected}"
                                                    Background="{DynamicResource DarkBaseBrush}"
                                                    BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="4"
                                                    Padding="6,2"
                                                    HorizontalAlignment="Left"
                                                    VerticalAlignment="Center">
                                                <Border.Styles>
                                                    <Style Selector="Border.proposed">
                                                        <Setter Property="Background" Value="{DynamicResource AccentSubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.proposed TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.rejected">
                                                        <Setter Property="Background" Value="{DynamicResource CriticalSubtleBrush}"/>
                                                        <Setter Property="BorderBrush" Value="{DynamicResource CriticalBrush}"/>
                                                    </Style>
                                                    <Style Selector="Border.rejected TextBlock">
                                                        <Setter Property="Foreground" Value="{DynamicResource CriticalBrush}"/>
                                                    </Style>
                                                </Border.Styles>
                                                <TextBlock Text="{Binding StatusDisplay}"
                                                           FontSize="9"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Border>

                                            <!-- Text + Optional Trigger -->
                                            <StackPanel Grid.Column="4" Spacing="2" VerticalAlignment="Center" Opacity="{Binding TextOpacity}">
                                                <SelectableTextBlock Text="{Binding Text}"
                                                                     FlowDirection="{Binding FlowDirection}"
                                                                     TextAlignment="{Binding TextAlignment}"
                                                                     TextWrapping="Wrap"
                                                                     FontSize="11"
                                                                     Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                <TextBlock Text="{Binding TriggerDisplay}"
                                                           TextWrapping="Wrap"
                                                           FontSize="10"
                                                           FontStyle="Italic"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           IsVisible="{Binding HasTrigger}"/>
                                            </StackPanel>

                                            <!-- Uses -->
                                            <TextBlock Grid.Column="5"
                                                       Text="{Binding UseCount}"
                                                       FontSize="11"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"/>

                                            <!-- Row Actions -->
                                            <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                <Button Content="Approve"
                                                        IsVisible="{Binding IsProposed}"
                                                        Command="{Binding $parent[UserControl].((vm:TipsTabViewModel)DataContext).ApproveCommand}"
                                                        CommandParameter="{Binding}"
                                                        Background="{DynamicResource HealthySubtleBrush}"
                                                        BorderBrush="{DynamicResource HealthyBrush}"
                                                        BorderThickness="1"
                                                        Foreground="{DynamicResource HealthyBrush}"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"/>
                                                <Button Content="Reject"
                                                        IsVisible="{Binding IsProposed}"
                                                        Command="{Binding $parent[UserControl].((vm:TipsTabViewModel)DataContext).RejectCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource WarningBrush}"/>
                                                <Button Content="{Binding EnableToggleLabel}"
                                                        Command="{Binding $parent[UserControl].((vm:TipsTabViewModel)DataContext).ToggleEnabledCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,2"
                                                        FontSize="10"/>
                                                <Button Content="Delete"
                                                        Command="{Binding $parent[UserControl].((vm:TipsTabViewModel)DataContext).DeleteCommand}"
                                                        CommandParameter="{Binding}"
                                                        Padding="6,2"
                                                        FontSize="10"
                                                        Foreground="{DynamicResource CriticalBrush}"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>

                <!-- Edit Panel Under List -->
                <Border Grid.Row="1"
                        Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="12"
                        IsVisible="{Binding SelectedTip, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <ContentControl Content="{Binding SelectedTip}">
                        <ContentControl.ContentTemplate>
                            <DataTemplate x:DataType="vm:TipRowModel">
                                <StackPanel Spacing="8">
                                    <Grid ColumnDefinitions="*,Auto">
                                        <TextBlock Text="{Binding Id, StringFormat='EDIT TIP · {0}'}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}"
                                                   VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding ScopeLabel}"
                                                   FontSize="10"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   VerticalAlignment="Center"/>
                                    </Grid>
                                    <TextBox Text="{Binding EditTrigger, Mode=TwoWay}"
                                             PlaceholderText="Trigger ('when to use' text; leave empty to match tip text)"
                                             FontSize="11"/>
                                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                        <TextBox Grid.Column="0"
                                                 Text="{Binding EditText, Mode=TwoWay}"
                                                 AcceptsReturn="True"
                                                 TextWrapping="Wrap"
                                                 MinHeight="60"
                                                 MaxHeight="130"
                                                 PlaceholderText="Tip text…"
                                                 FontSize="11"/>
                                        <Button Grid.Column="1"
                                                Command="{Binding $parent[UserControl].((vm:TipsTabViewModel)DataContext).SaveTipCommand}"
                                                CommandParameter="{Binding}"
                                                Content="Save"
                                                Background="{DynamicResource AccentBrush}"
                                                Foreground="White"
                                                FontWeight="Bold"
                                                Padding="14,6"
                                                VerticalAlignment="Bottom"/>
                                    </Grid>
                                </StackPanel>
                            </DataTemplate>
                        </ContentControl.ContentTemplate>
                    </ContentControl>
                </Border>
            </Grid>

            <!-- Right: Three Stacked Cards -->
            <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <!-- Card 1: Add tips -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ADD TIPS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBox Text="{Binding NewTipsText, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="160"
                                     PlaceholderText="Enter one or more tips…"
                                     FontSize="11"/>
                            <TextBlock Text="Separate tips with a blank line. Start a tip with a line 'when: …' to give it a trigger."
                                       FontSize="10"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <ComboBox Grid.Column="0"
                                          SelectedIndex="{Binding NewScopeIndex, Mode=TwoWay}"
                                          MinWidth="95"
                                          VerticalAlignment="Center">
                                    <ComboBoxItem Content="Global"/>
                                    <ComboBoxItem Content="Chat"/>
                                    <ComboBoxItem Content="Persona"/>
                                </ComboBox>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewScopeValue, Mode=TwoWay}"
                                         PlaceholderText="{Binding NewScopeValuePlaceholder}"
                                         IsVisible="{Binding ShowNewScopeValue}"
                                         VerticalAlignment="Center"/>
                                <Button Grid.Column="2"
                                        Command="{Binding AddTipsCommand}"
                                        Content="{Binding AddButtonLabel}"
                                        IsEnabled="{Binding CanAddTips}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="12,5"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"/>
                            </Grid>

                            <ItemsControl ItemsSource="{Binding LastRejected}"
                                          IsVisible="{Binding HasLastRejected}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Background="{DynamicResource CriticalSubtleBrush}"
                                                BorderBrush="{DynamicResource CriticalBrush}"
                                                BorderThickness="1"
                                                CornerRadius="4"
                                                Padding="6,4"
                                                Margin="0,2">
                                            <TextBlock Text="{Binding}"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource CriticalBrush}"
                                                       TextWrapping="Wrap"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Semantic search -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="SEMANTIC SEARCH" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding SearchQuery, Mode=TwoWay}"
                                         PlaceholderText="Search tips semantically…"
                                         KeyDown="OnSearchKeyDown"/>
                                <Button Grid.Column="1"
                                        Command="{Binding SearchCommand}"
                                        Content="Search"
                                        Padding="10,5"
                                        IsEnabled="{Binding !IsBusy}"/>
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SearchResults}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TipRowModel">
                                        <Border Background="{DynamicResource DarkBaseBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,5"
                                                Margin="0,2">
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                                                <Border Grid.Column="0"
                                                        Background="{DynamicResource CardBgBrush}"
                                                        CornerRadius="4"
                                                        Padding="5,2"
                                                        VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Score, StringFormat='{}{0:F2}'}"
                                                               FontSize="10"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource HealthyBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding Text}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Test a chat snippet -->
                    <Border Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="TEST A CHAT SNIPPET" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBox Text="{Binding TestText, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     MinHeight="72"
                                     PlaceholderText="Paste a chat snippet to test matching…"
                                     FontSize="11"/>
                            <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="8">
                                <TextBox Grid.Column="0"
                                         Text="{Binding TestChatId, Mode=TwoWay}"
                                         PlaceholderText="Chat ID (optional)"
                                         FontSize="11"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding TestPersonaKey, Mode=TwoWay}"
                                         PlaceholderText="Persona (optional)"
                                         FontSize="11"/>
                                <Button Grid.Column="2"
                                        Command="{Binding RunTestCommand}"
                                        Content="Run"
                                        Padding="12,5"
                                        IsEnabled="{Binding !IsBusy}"/>
                            </Grid>

                            <TextBlock Text="{Binding TestThreshold, StringFormat='Would be shown (threshold {0:F2})'}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HealthyBrush}"
                                       Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding TestShown}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TipRowModel">
                                        <Border Background="{DynamicResource DarkBaseBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,5"
                                                Margin="0,2">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Score, StringFormat='{}{0:F2}'}"
                                                           FontSize="10"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource HealthyBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ScopeLabel}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Text}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Text="Below threshold"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       Margin="0,4,0,0"/>
                            <ItemsControl ItemsSource="{Binding TestBelowThreshold}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:TipRowModel">
                                        <Border Background="{DynamicResource DarkBaseBrush}"
                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,5"
                                                Margin="0,2">
                                            <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="6">
                                                <TextBlock Grid.Column="0"
                                                           Text="{Binding Score, StringFormat='{}{0:F2}'}"
                                                           FontSize="10"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="1"
                                                           Text="{Binding ScopeLabel}"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Top"/>
                                                <TextBlock Grid.Column="2"
                                                           Text="{Binding Text}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- 3. Bottom Status Line -->
        <Border Grid.Row="2"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="12,6">
            <TextBlock Text="{Binding StatusText}"
                       FontSize="11"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextTrimming="CharacterEllipsis"
                       ToolTip.Tip="{Binding StatusText}"/>
        </Border>
    </Grid>
</UserControl>
