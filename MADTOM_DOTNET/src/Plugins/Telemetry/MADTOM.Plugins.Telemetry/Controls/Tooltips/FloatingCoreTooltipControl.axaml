<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="180" d:DesignHeight="60"
             x:Class="MadTOM.Controls.Tooltips.FloatingCoreTooltipControl">

    <Border Background="#F20A0F1D"
            BorderBrush="#9906B6D4"
            BorderThickness="1"
            CornerRadius="8"
            Padding="8,5"
            BoxShadow="0 4 20 #80000000">
        <StackPanel Spacing="3" Orientation="Horizontal">
            <TextBlock x:Name="HostTextBlock"
                       Text="gander-epyc-01"
                       Foreground="#22D3EE"
                       FontWeight="Bold"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
            <Border Background="#1E293B" CornerRadius="4" Padding="4,1" Margin="3,0">
                <TextBlock x:Name="ThreadTextBlock"
                           Text="Thread #0"
                           Foreground="#94A3B8"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="10"
                           VerticalAlignment="Center"/>
            </Border>
            <TextBlock x:Name="LoadTextBlock"
                       Text="42.1%"
                       Foreground="#10B981"
                       FontWeight="Bold"
                       FontFamily="{StaticResource MonoFontFamily}"
                       FontSize="11"
                       VerticalAlignment="Center"/>
        </StackPanel>
    </Border>
</UserControl>

