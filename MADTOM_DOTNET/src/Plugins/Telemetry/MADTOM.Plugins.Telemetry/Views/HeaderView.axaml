<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="48"
             x:Class="MadTOM.Views.HeaderView"
             x:DataType="vm:HeaderViewModel">

    <Border Background="{DynamicResource HeaderBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Height="48"
            Padding="14,0">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            
            <!-- Left: Brand, Navigation & Collapse Toggle Button -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSidebarCollapseCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        ToolTip.Tip="Toggle Left Sidebar">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="8"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="MAD TOM"
                                       IsVisible="{Binding !IsSidebarCollapsed}"
                                       FontWeight="ExtraBold"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="13"
                                       LetterSpacing="1"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>

                <!-- Default title when on Fleet Matrix / root views -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding !IsDetailPage}">
                    <TextBlock Text="Telemetry &amp; Operations Matrix"
                               IsVisible="{Binding !IsSidebarCollapsed}"
                               FontWeight="Bold"
                               FontSize="12"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               VerticalAlignment="Center"/>

                    <Border Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.5.2"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </Border>
                </StackPanel>

                <!-- Navigation Breadcrumbs when on Detail Page -->
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" IsVisible="{Binding IsDetailPage}">
                    <Border Background="{DynamicResource AccentSubtleBrush}"
                            BorderBrush="{DynamicResource AccentBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="6,2"
                            VerticalAlignment="Center">
                        <TextBlock Text="v0.5.2"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                    </Border>

                    <TextBlock Text="/" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>

                    <Button Command="{Binding NavigateBackCommand}"
                            Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,4"
                            Cursor="Hand"
                            ToolTip.Tip="Nodes">
                        <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
                            <TextBlock Text="←" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="{loc:Loc backToFleet}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource AccentTextBrush}"/>
                        </StackPanel>
                    </Button>

                    <TextBlock Text="/" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>

                    <!-- Node Title with floating CPU info popup on hover -->
                    <Border Background="Transparent"
                            ToolTip.Tip="{Binding CurrentPageSubtitle}"
                            VerticalAlignment="Center">
                        <TextBlock Text="{Binding CurrentPageTitle}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </StackPanel>

            <!-- Right: Global Real-Time Cluster Telemetry Summary -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource DarkBaseBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource HealthyBrush}"/>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding ClusterSummary.HostCount}"/><Run Text=" Hosts ("/>
                            <Run Text="{Binding ClusterSummary.GanderCount, Mode=OneWay}"/>
                            <Run Text=" Push / "/>
                            <Run Text="{Binding ClusterSummary.GoslingCount, Mode=OneWay}"/>
                            <Run Text=" Pull)"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="|" Foreground="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="P95 TWAMP:" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ClusterSummary.TwampSummary}" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource IndigoBrush}"/>
                    </StackPanel>

                    <TextBlock Text="|" Foreground="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>

                    <!-- Opt-In Dynamic Global Metrics Chips -->
                    <ItemsControl ItemsSource="{Binding PinnedMetrics}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="6"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:GlobalMetricItemViewModel">
                                <Button Command="{Binding $parent[UserControl].((vm:HeaderViewModel)DataContext).OpenGlobalMetricsCommand}"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        Padding="2,0"
                                        Cursor="Hand"
                                        ToolTip.Tip="Click to configure Global Metrics in Node Settings">
                                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Icon}" FontSize="11" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding ShortName, StringFormat={}{0}:}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding FormattedValue}" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="3,1" Margin="2,0,0,0">
                                            <TextBlock Text="{Binding ModifierTag}" FontSize="8" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource AccentTextBrush}"/>
                                        </Border>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Button Command="{Binding OpenGlobalMetricsCommand}"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="5,2"
                            Cursor="Hand"
                            ToolTip.Tip="Configure Global Metrics &amp; Top Bar Pinning">
                        <TextBlock Text="⚙" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Button>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>

