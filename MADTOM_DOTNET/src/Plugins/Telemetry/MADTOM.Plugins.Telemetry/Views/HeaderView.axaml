<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="56"
             x:Class="MadTOM.Views.HeaderView"
             x:DataType="vm:HeaderViewModel">

    <Border Background="{DynamicResource HeaderBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Height="56"
            Padding="16,0">
        <Grid ColumnDefinitions="Auto,*" VerticalAlignment="Center">
            
            <!-- Left: Brand & Collapse Toggle Button -->
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <Button Command="{Binding ToggleSidebarCollapseCommand}"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="0"
                        Cursor="Hand"
                        ToolTip.Tip="Toggle Left Sidebar">
                    <Border Background="{DynamicResource AccentBrush}"
                            CornerRadius="8"
                            Padding="8,5">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="⚡" FontSize="13" Foreground="White" VerticalAlignment="Center"/>
                            <TextBlock Text="MAD TOM"
                                       IsVisible="{Binding !IsSidebarCollapsed}"
                                       FontWeight="ExtraBold"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="13"
                                       LetterSpacing="1"
                                       Foreground="White"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </Button>

                <TextBlock Text="Telemetry &amp; Operations Matrix"
                           IsVisible="{Binding !IsSidebarCollapsed}"
                           FontWeight="Bold"
                           FontSize="12"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center"/>

                <Border Background="{DynamicResource AccentSubtleBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2"
                        VerticalAlignment="Center">
                    <TextBlock Text="v0.5.2"
                                FontFamily="{StaticResource MonoFontFamily}"
                                FontSize="10"
                                Foreground="{DynamicResource AccentTextBrush}"/>
                </Border>
            </StackPanel>

            <!-- Right: Global Real-Time Cluster Telemetry Summary -->
            <Border Grid.Column="1"
                    HorizontalAlignment="Right"
                    Background="{DynamicResource DarkBaseBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Padding="12,6">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource HealthyBrush}"/>
                        <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}">
                            <Run Text="{Binding ClusterSummary.HostCount}"/><Run Text=" Hosts ("/>
                            <Run Text="{Binding ClusterSummary.GanderCount, Mode=OneWay}"/>
                            <Run Text=" Push / "/>
                            <Run Text="{Binding ClusterSummary.GoslingCount, Mode=OneWay}"/>
                            <Run Text=" Pull)"/>
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="|" Foreground="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="P95 TWAMP:" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ClusterSummary.TwampSummary}" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource IndigoBrush}"/>
                    </StackPanel>

                    <TextBlock Text="|" Foreground="{DynamicResource BorderBrush}" VerticalAlignment="Center"/>

                    <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="Global Egress:" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Text="{Binding ClusterSummary.GlobalEgressGbps, StringFormat={}{0:F3} Gbps}" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource HealthyBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

        </Grid>
    </Border>
</UserControl>

