<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:services="using:MadTOM.Services"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="MadTOM.Views.Modals.CollectorSettingsModal"
             x:DataType="vm:CollectorSettingsViewModel">

    <UserControl.Styles>
        <Style Selector="Button.active-btn">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.inactive-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="Button.inactive-btn:hover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
        </Style>
        <Style Selector="Button.mod-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.mod-btn:hover">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="Background" Value="{DynamicResource DarkBaseBrush}"/>
        </Style>
        <Style Selector="Button.mod-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
    </UserControl.Styles>

    <!-- Modal Scrim Backdrop -->
    <Grid Background="#B3000000">
        <!-- Dialog Container -->
        <Border x:Name="DialogContainer"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="16"
                Width="720"
                Height="620"
                MinWidth="520"
                MinHeight="400"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                BoxShadow="0 14 36 #C0000000">
            <Panel>
                <Grid Margin="24" RowDefinitions="Auto,*,Auto">
                
                <!-- Modal Header -->
                <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,16">
                    <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                        <Border Background="{DynamicResource AccentBrush}" CornerRadius="6" Padding="6,4">
                            <TextBlock Text="⚡" FontSize="12" Foreground="White"/>
                        </Border>
                        <StackPanel Spacing="1">
                            <TextBlock Text="Collector Endpoints &amp; Node Settings"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Configure telemetry collectors and two-tier opt-in switches"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>
                    </StackPanel>

                    <Button Grid.Column="1"
                            Command="{Binding CloseCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="8,4"
                            Cursor="Hand">
                        <TextBlock Text="✕" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </Button>
                </Grid>

                <!-- Modal Content Tabs -->
                <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTabIndex}">
                    
                    <!-- TAB 1: Collectors -->
                    <TabItem Header="Collectors" FontSize="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="14" Margin="0,12,0,0">
                            <!-- Existing Endpoints List -->
                            <TextBlock Text="CONFIGURED COLLECTORS"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Border Background="{DynamicResource DarkBaseBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    MinHeight="100"
                                    MaxHeight="150">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Endpoints}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                        BorderThickness="0,0,0,1"
                                                        Padding="12,8">
                                                    <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                        <Border Grid.Column="0" Background="{DynamicResource AccentSubtleBrush}" CornerRadius="4" Padding="6,2" Margin="0,0,8,0">
                                                            <TextBlock Text="{Binding Name}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="10"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentTextBrush}"/>
                                                        </Border>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding Address}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <Button Grid.Column="2"
                                                                Command="{Binding $parent[UserControl].((vm:CollectorSettingsViewModel)DataContext).SelectCollectorForEditCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="6,2"
                                                                Cursor="Hand"
                                                                Margin="0,0,4,0">
                                                            <TextBlock Text="Edit" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                                                        </Button>
                                                        <Button Grid.Column="3"
                                                                Command="{Binding $parent[UserControl].((vm:CollectorSettingsViewModel)DataContext).RemoveCollectorCommand}"
                                                                CommandParameter="{Binding Address}"
                                                                Background="Transparent"
                                                                BorderThickness="0"
                                                                Padding="6,2"
                                                                Cursor="Hand">
                                                            <TextBlock Text="Remove" FontSize="10" Foreground="{DynamicResource CriticalBrush}"/>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>

                            <!-- Add / Edit Collector Section -->
                            <TextBlock Text="MANAGE COLLECTOR ENDPOINT"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="10"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource TextMutedBrush}"/>

                            <Grid ColumnDefinitions="*,*,Auto,Auto" Margin="0,0,0,0">
                                <TextBox Grid.Column="0"
                                         Text="{Binding NewName, Mode=TwoWay}"
                                         PlaceholderText="Collector Name (e.g. Lab Fleet)"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         FontSize="11"
                                         Margin="0,0,8,0"/>
                                <TextBox Grid.Column="1"
                                         Text="{Binding NewAddress, Mode=TwoWay}"
                                         PlaceholderText="Host:Port (e.g. 127.0.0.1:50051)"
                                         FontFamily="{StaticResource MonoFontFamily}"
                                         FontSize="11"
                                         Margin="0,0,8,0"/>
                                <Button Grid.Column="2"
                                         Command="{Binding SaveCollectorCommand}"
                                         Background="{DynamicResource AccentBrush}"
                                         Foreground="White"
                                         CornerRadius="6"
                                         Padding="12,6"
                                         Cursor="Hand">
                                    <TextBlock Text="{Binding SaveCollectorButtonText}" FontWeight="Bold" FontSize="11"/>
                                </Button>
                                <Button Grid.Column="3"
                                        IsVisible="{Binding IsEditingCollector}"
                                        Command="{Binding CancelEditCollectorCommand}"
                                        Background="{DynamicResource DarkBaseBrush}"
                                        Foreground="{DynamicResource TextMutedBrush}"
                                        CornerRadius="6"
                                        Padding="10,6"
                                        Margin="6,0,0,0"
                                        Cursor="Hand">
                                    <TextBlock Text="Cancel" FontSize="11"/>
                                </Button>
                            </Grid>
                            <Border Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="8" Padding="12">
                                <StackPanel Spacing="8" IsEnabled="{Binding IsCacheAvailable}">
                                    <TextBlock Text="CLIENT HISTORY CACHE" FontWeight="Bold" FontSize="11"/>
                                    <TextBlock Text="Keep streamed graph history, including Monitor-only metrics, while this app is open. Applies to all connected nodes."
                                               TextWrapping="Wrap" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Retention (minutes)" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding CacheRetentionMinutes, Mode=TwoWay}" Width="90" PlaceholderText="60"/>
                                        <Button Content="Apply" Command="{Binding ApplyCacheRetentionCommand}"/>
                                        <Button Content="Clear cache" Command="{Binding ClearTelemetryCacheCommand}"/>
                                    </StackPanel>
                                    <TextBox Text="{Binding CacheMemoryEstimate, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"/>
                                    <TextBlock Text="Default: 60 minutes. Use 120 for two hours; maximum 1440 (24 hours). History is cleared when the app exits."
                                               TextWrapping="Wrap" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 2: Node Opt-In Settings -->
                    <TabItem Header="Node Opt-in Configuration" FontSize="12">
                        <Grid RowDefinitions="Auto,*" Margin="0,12,0,0">
                            <!-- Target Node Selector (Pinned outside ScrollViewer) -->
                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
                                <TextBlock Text="Select Node:"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <ComboBox Grid.Column="1"
                                          ItemsSource="{Binding DetectedNodes}"
                                          SelectedItem="{Binding SelectedNode, Mode=TwoWay}"
                                          PlaceholderText="None (select a node to configure...)"
                                          HorizontalAlignment="Stretch">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                <TextBlock Text="{Binding Id}" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}"/>
                                                <TextBlock Text="•" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="{Binding CollectorName}" Foreground="{DynamicResource AccentTextBrush}" FontSize="10"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                                <Button Grid.Column="2"
                                        Command="{Binding ClearSelectedNodeCommand}"
                                        IsVisible="{Binding SelectedNode, Converter={x:Static ObjectConverters.IsNotNull}}"
                                        Background="{DynamicResource DarkBaseBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="6"
                                        Padding="8,5"
                                        Margin="8,0,0,0"
                                        Cursor="Hand"
                                        ToolTip.Tip="Deselect node (return to None)">
                                    <TextBlock Text="✕ Clear" FontSize="11" Foreground="{DynamicResource TextMutedBrush}"/>
                                </Button>
                            </Grid>

                            <!-- Scrollable Content -->
                            <ScrollViewer Grid.Row="1" x:Name="NodeSettingsScrollViewer" VerticalScrollBarVisibility="Auto">
                                <Panel>
                                    <!-- No Node Selected Placeholder Card -->
                                    <Border IsVisible="{Binding SelectedNodeSettings, Converter={x:Static ObjectConverters.IsNull}}"
                                            Background="{DynamicResource DarkBaseBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="32"
                                            HorizontalAlignment="Stretch"
                                            VerticalAlignment="Center"
                                            Margin="0,20,0,0">
                                        <StackPanel HorizontalAlignment="Center" Spacing="10">
                                            <TextBlock Text="🖥️" FontSize="36" HorizontalAlignment="Center"/>
                                            <TextBlock Text="No Node Selected"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="13"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       HorizontalAlignment="Center"/>
                                            <TextBlock Text="Select a node from the dropdown above to view and modify its opt-in configuration."
                                                       FontSize="11"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Center"
                                                       TextWrapping="Wrap"
                                                       MaxWidth="380"
                                                       TextAlignment="Center"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Node Settings Panel -->
                                    <Panel IsVisible="{Binding SelectedNodeSettings, Converter={x:Static ObjectConverters.IsNotNull}}">
                                        <Border DataContext="{Binding SelectedNodeSettings}"
                                                Background="{DynamicResource DarkBaseBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                Padding="14">
                                            <StackPanel Spacing="12">
                                                
                                                <!-- Tier 1: Collection Opt-in (3-Tier Policy) -->
                                                <TextBlock Text="TIER 1: COLLECTION OPT-IN (3-TIER POLICY)"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                                <TextBlock Text="Configure metric collection and storage policy. Off: disabled. Monitor: live 1Hz streaming only (no disk writes). Store: live stream + persisted in TSDB."
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>

                                                <!-- List of Metric Groups -->
                                                <ItemsControl ItemsSource="{Binding MetricGroups}">
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate>
                                                            <Border Background="{DynamicResource CardBgBrush}"
                                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                                    BorderThickness="1"
                                                                    CornerRadius="8"
                                                                    Padding="12,10"
                                                                    Margin="0,0,0,8">
                                                                <StackPanel Spacing="8">
                                                                    <!-- Group Header -->
                                                                    <Grid ColumnDefinitions="*,Auto">
                                                                        <StackPanel Grid.Column="0">
                                                                            <TextBlock Text="{Binding Title}"
                                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                                       FontSize="11"
                                                                                       FontWeight="Bold"
                                                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                            <TextBlock Text="{Binding Description}"
                                                                                       FontSize="10"
                                                                                       Foreground="{DynamicResource TextMutedBrush}"/>
                                                                        </StackPanel>
                                                                        <Button Grid.Column="1"
                                                                                Command="{Binding ToggleExpandedCommand}"
                                                                                IsVisible="{Binding HasSubItems}"
                                                                                Background="Transparent"
                                                                                BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                                BorderThickness="1"
                                                                                CornerRadius="4"
                                                                                Padding="8,3"
                                                                                Cursor="Hand">
                                                                            <Panel>
                                                                                <TextBlock Text="▼ Details" IsVisible="{Binding !IsExpanded}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                                                                                <TextBlock Text="▲ Less" IsVisible="{Binding IsExpanded}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                                                                            </Panel>
                                                                        </Button>
                                                                    </Grid>

                                                                    <!-- Primary Items -->
                                                                    <ItemsControl ItemsSource="{Binding Items}">
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Grid ColumnDefinitions="*,Auto" Margin="0,4">
                                                                                    <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                        <TextBlock Text="{Binding DisplayName}"
                                                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                                                   FontSize="11"
                                                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                                        <TextBlock Text="{Binding Subtitle}"
                                                                                                   FontSize="10"
                                                                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                                                                   IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                                    </StackPanel>
                                                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                                                                                        <RadioButton Content="Off"
                                                                                                     GroupName="{Binding GroupName}"
                                                                                                     IsChecked="{Binding IsOff, Mode=TwoWay}"
                                                                                                     FontSize="11"
                                                                                                     ToolTip.Tip="Disabled probing, zero overhead"/>
                                                                                        <RadioButton Content="Monitor"
                                                                                                     GroupName="{Binding GroupName}"
                                                                                                     IsChecked="{Binding IsMonitorOnly, Mode=TwoWay}"
                                                                                                     FontSize="11"
                                                                                                     ToolTip.Tip="Live 1Hz streaming only (zero disk writes on node or collector)"/>
                                                                                        <RadioButton Content="Store"
                                                                                                     GroupName="{Binding GroupName}"
                                                                                                     IsChecked="{Binding IsMonitorAndStore, Mode=TwoWay}"
                                                                                                     FontSize="11"
                                                                                                     ToolTip.Tip="Live streaming AND persisted in TSDB for historical charting"/>
                                                                                    </StackPanel>
                                                                                </Grid>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <!-- Granular Sub-Items -->
                                                                    <Border IsVisible="{Binding IsExpanded}"
                                                                            Background="{DynamicResource DarkBaseBrush}"
                                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                                            BorderThickness="1"
                                                                            CornerRadius="6"
                                                                            Padding="10,8"
                                                                            Margin="0,4,0,0">
                                                                        <StackPanel Spacing="6">
                                                                            <TextBlock Text="{Binding SubItemsHeader}"
                                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                                       FontSize="10"
                                                                                       FontWeight="SemiBold"
                                                                                       Foreground="{DynamicResource AccentTextBrush}"/>
                                                                            <ItemsControl ItemsSource="{Binding SubItems}">
                                                                                <ItemsControl.ItemTemplate>
                                                                                    <DataTemplate>
                                                                                        <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                                                <TextBlock Text="{Binding DisplayName}"
                                                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                                                           FontSize="10"
                                                                                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                                                                <TextBlock Text="{Binding Subtitle}"
                                                                                                           FontSize="9"
                                                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                                                           IsVisible="{Binding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
                                                                                            </StackPanel>
                                                                                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                                                                <RadioButton Content="Off"
                                                                                                             GroupName="{Binding GroupName}"
                                                                                                             IsChecked="{Binding IsOff, Mode=TwoWay}"
                                                                                                             FontSize="10"/>
                                                                                                <RadioButton Content="Monitor"
                                                                                                             GroupName="{Binding GroupName}"
                                                                                                             IsChecked="{Binding IsMonitorOnly, Mode=TwoWay}"
                                                                                                             FontSize="10"/>
                                                                                                <RadioButton Content="Store"
                                                                                                             GroupName="{Binding GroupName}"
                                                                                                             IsChecked="{Binding IsMonitorAndStore, Mode=TwoWay}"
                                                                                                             FontSize="10"/>
                                                                                            </StackPanel>
                                                                                        </Grid>
                                                                                    </DataTemplate>
                                                                                </ItemsControl.ItemTemplate>
                                                                            </ItemsControl>
                                                                        </StackPanel>
                                                                    </Border>
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>

                                                <!-- TWAMP Target Card -->
                                                <Border Background="{DynamicResource CardBgBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        BorderThickness="1"
                                                        CornerRadius="8"
                                                        Padding="12,10">
                                                    <StackPanel Spacing="6">
                                                        <TextBlock Text="TWAMP Light reflector (host:UDP port)"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="11"
                                                                   FontWeight="SemiBold"/>
                                                        <TextBox Text="{Binding TwampTarget}" PlaceholderText="Empty disables probing"
                                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                                 FontSize="11"/>
                                                        <CheckBox Content="Endpoint clocks are synchronized" IsChecked="{Binding TwampClocksSynchronized}"
                                                                  FontSize="11"/>
                                                    </StackPanel>
                                                </Border>

                                                <!-- Process Telemetry Section -->
                                                <Separator Background="{DynamicResource BorderBrush}" Height="1"/>
                                                <TextBlock Text="PROCESS TELEMETRY"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentTextBrush}"/>
                                                <TextBlock Text="Configure process probing and TSDB historical storage policy."
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>

                                                <StackPanel Spacing="8">
                                                    <StackPanel Orientation="Horizontal" Spacing="16">
                                                        <RadioButton Content="Disabled (Off)"
                                                                     GroupName="ProcessModeGroup"
                                                                     IsChecked="{Binding IsProcessDisabled, Mode=TwoWay}"
                                                                     ToolTip.Tip="Completely stops querying /proc, zero streaming and zero storage"/>
                                                        <RadioButton Content="Live Only (Probed)"
                                                                     GroupName="ProcessModeGroup"
                                                                     IsChecked="{Binding IsProcessLiveOnly, Mode=TwoWay}"
                                                                     ToolTip.Tip="Probes 1Hz snapshot for live Processes tab; ephemeral, no TSDB storage"/>
                                                        <RadioButton Content="Probed &amp; Stored (TSDB)"
                                                                     GroupName="ProcessModeGroup"
                                                                     IsChecked="{Binding IsProcessStored, Mode=TwoWay}"
                                                                     ToolTip.Tip="Probes 1Hz snapshot AND records top processes into TSDB for graphing"/>
                                                    </StackPanel>

                                                    <!-- Top N processes slider -->
                                                    <Border Background="{DynamicResource CardBgBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="12,8"
                                                            Margin="0,4,0,0">
                                                        <Grid ColumnDefinitions="Auto,*,Auto">
                                                            <TextBlock Text="Top Process Count:"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="11"
                                                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="0,0,12,0"/>
                                                            <Slider Grid.Column="1"
                                                                    Minimum="1"
                                                                    Maximum="10"
                                                                    TickFrequency="1"
                                                                    IsSnapToTickEnabled="True"
                                                                    Value="{Binding TopNProcesses, Mode=TwoWay}"
                                                                    VerticalAlignment="Center"/>
                                                            <TextBlock Grid.Column="2"
                                                                       Text="{Binding TopNProcesses, StringFormat='Top {0} processes'}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="11"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource AccentTextBrush}"
                                                                       VerticalAlignment="Center"
                                                                       Margin="12,0,0,0"/>
                                                        </Grid>
                                                    </Border>
                                                </StackPanel>

                                                <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                                                <!-- Tier 2: Viewing Opt-in -->
                                                <TextBlock Text="TIER 2: VIEWING OPT-IN (CLIENT UI DISPLAY)"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource AccentBrush}"/>
                                                <TextBlock Text="Toggle whether the UI renders live cards without stopping background TSDB collection."
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>

                                                <WrapPanel Orientation="Horizontal">
                                                    <CheckBox Content="Enable Live Card View" IsChecked="{Binding IsViewingEnabled, Mode=TwoWay}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="Stream Core Matrix" IsChecked="{Binding ViewCpuMatrix, Mode=TwoWay}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="Stream Swap &amp; ZRAM" IsChecked="{Binding ViewSwapZram, Mode=TwoWay}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="Stream Power &amp; Battery" IsChecked="{Binding ViewPowerBattery, Mode=TwoWay}" Margin="0,0,16,6"/>
                                                    <CheckBox Content="Stream NIC Counters" IsChecked="{Binding ViewNetworkCounters, Mode=TwoWay}" Margin="0,0,16,6"/>
                                                </WrapPanel>

                                                <!-- Save / Apply Button Row -->
                                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,8,0,0">
                                                    <TextBlock Text="{Binding StatusMessage}"
                                                               FontSize="11"
                                                               Foreground="{DynamicResource HealthyBrush}"
                                                               VerticalAlignment="Center"/>
                                                    
                                                    <Border Grid.Column="1"
                                                            IsVisible="{Binding HasUnappliedChanges}"
                                                            Background="{DynamicResource WarningSubtleBrush}"
                                                            BorderBrush="{DynamicResource WarningBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="8,4"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center">
                                                        <TextBlock Text="● Unapplied Changes"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="10"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource WarningBrush}"/>
                                                    </Border>

                                                    <Button Grid.Column="2"
                                                            Command="{Binding SaveConfigCommand}"
                                                            Background="{DynamicResource AccentBrush}"
                                                            Foreground="White"
                                                            CornerRadius="6"
                                                            Padding="14,6"
                                                            Cursor="Hand">
                                                        <TextBlock Text="Apply to Node" FontWeight="Bold" FontSize="11"/>
                                                    </Button>
                                                </Grid>
                                            </StackPanel>
                                        </Border>
                                    </Panel>
                                </Panel>
                            </ScrollViewer>
                        </Grid>
                    </TabItem>

                    <!-- TAB 3: Node Groups -->
                    <TabItem Header="Node Groups" FontSize="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,0,0">
                                <TextBlock Text="ASSIGN NODES TO CUSTOM FLEET GROUPS"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}"/>

                                <ItemsControl ItemsSource="{Binding NodeGroupItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:NodeGroupItemViewModel">
                                            <Border Background="{DynamicResource DarkBaseBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="8"
                                                    Padding="12,10"
                                                    Margin="0,0,0,8">
                                                <Grid ColumnDefinitions="140,*,Auto">
                                                    <StackPanel Grid.Column="0" Spacing="2" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding NodeId}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <TextBlock Text="{Binding Ip}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="10"
                                                                   Foreground="{DynamicResource TextMutedBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="12,0">
                                                        <TextBlock Text="Group:"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="11"
                                                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                                                   VerticalAlignment="Center"/>
                                                        <TextBox Text="{Binding GroupName, Mode=TwoWay}"
                                                                 Width="130"
                                                                 FontFamily="{StaticResource MonoFontFamily}"
                                                                 FontSize="11"
                                                                 Background="{DynamicResource CardBgBrush}"
                                                                 Foreground="{DynamicResource TextPrimaryBrush}"
                                                                 BorderBrush="{DynamicResource BorderBrush}"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                                                        <Button Content="Compute"
                                                                Command="{Binding SetPresetGroupCommand}"
                                                                CommandParameter="Compute"
                                                                Background="{DynamicResource CardBgBrush}"
                                                                Foreground="{DynamicResource AccentTextBrush}"
                                                                FontSize="10"
                                                                Padding="6,3"
                                                                CornerRadius="4"
                                                                Cursor="Hand"/>
                                                        <Button Content="Storage"
                                                                Command="{Binding SetPresetGroupCommand}"
                                                                CommandParameter="Storage"
                                                                Background="{DynamicResource CardBgBrush}"
                                                                Foreground="{DynamicResource HealthyBrush}"
                                                                FontSize="10"
                                                                Padding="6,3"
                                                                CornerRadius="4"
                                                                Cursor="Hand"/>
                                                        <Button Content="Edge"
                                                                Command="{Binding SetPresetGroupCommand}"
                                                                CommandParameter="Edge"
                                                                Background="{DynamicResource CardBgBrush}"
                                                                Foreground="{DynamicResource PurpleBrush}"
                                                                FontSize="10"
                                                                Padding="6,3"
                                                                CornerRadius="4"
                                                                Cursor="Hand"/>
                                                        <Button Content="None"
                                                                Command="{Binding SetPresetGroupCommand}"
                                                                CommandParameter=""
                                                                Background="{DynamicResource CardBgBrush}"
                                                                Foreground="{DynamicResource TextMutedBrush}"
                                                                FontSize="10"
                                                                Padding="6,3"
                                                                CornerRadius="4"
                                                                Cursor="Hand"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <!-- TAB 4: Global Metrics -->
                    <TabItem Header="Global Metrics" FontSize="12">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Spacing="14" Margin="0,12,0,0">
                                
                                <!-- Section 1: Add/Pin Metric Configurator -->
                                <Border Background="{DynamicResource DarkBaseBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <TextBlock Text="OPT-IN GLOBAL METRICS (PIN TO TOP BAR)"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource AccentTextBrush}"/>
                                        <TextBlock Text="Choose any fleet metric and aggregation modifier to pin to the top-right header bar."
                                                   FontSize="11"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>

                                        <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,4,0,0">
                                            <!-- Metric ComboBox -->
                                            <ComboBox Grid.Column="0"
                                                      ItemsSource="{Binding AvailableMetricOptions}"
                                                      SelectedItem="{Binding SelectedMetricOption, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      Margin="0,0,10,0">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="services:MetricDefinition">
                                                        <StackPanel Orientation="Horizontal" Spacing="8">
                                                            <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding Unit, StringFormat=({0})}" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" VerticalAlignment="Center"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>

                                            <!-- Segmented Aggregation Selector -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="2"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="mod-btn"
                                                            Classes.active="{Binding IsAddModifierSum}"
                                                            Content="Sum"
                                                            Command="{Binding SetAddModifierCommand}"
                                                            CommandParameter="Sum"/>
                                                    <Button Classes="mod-btn"
                                                            Classes.active="{Binding IsAddModifierAvg}"
                                                            Content="Avg"
                                                            Command="{Binding SetAddModifierCommand}"
                                                            CommandParameter="Avg"/>
                                                    <Button Classes="mod-btn"
                                                            Classes.active="{Binding IsAddModifierRate}"
                                                            Content="Rate of Change (/s)"
                                                            Command="{Binding SetAddModifierCommand}"
                                                            CommandParameter="Rate of Change"/>
                                                </StackPanel>
                                            </Border>

                                            <!-- Pin Button -->
                                            <Button Grid.Column="2"
                                                    Command="{Binding PinCurrentSelectionCommand}"
                                                    Background="{DynamicResource AccentBrush}"
                                                    CornerRadius="6"
                                                    Padding="12,7"
                                                    Cursor="Hand"
                                                    VerticalAlignment="Center">
                                                <TextBlock Text="+ Pin to Top Bar" FontWeight="Bold" FontSize="11" Foreground="White"/>
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- Section 2: Currently Pinned Top Bar Metrics -->
                                <Border Background="{DynamicResource DarkBaseBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="CURRENTLY PINNED TO TOP BAR"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="10"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource TextMutedBrush}"/>

                                        <ItemsControl ItemsSource="{Binding PinnedMetricsPreview}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GlobalMetricItemViewModel">
                                                    <Border Background="{DynamicResource CardBgBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="6"
                                                            Padding="8,5"
                                                            Margin="0,0,8,8">
                                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Icon}" FontSize="12" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding ShortName}" FontWeight="SemiBold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                            <TextBlock Text="{Binding FormattedValue}" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                                            <Border Background="{DynamicResource DarkBaseBrush}" CornerRadius="3" Padding="4,1" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding ModifierTag}" FontSize="8" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </Border>
                                                            <Button Command="{Binding $parent[UserControl].((vm:CollectorSettingsViewModel)DataContext).UnpinMetricCommand}"
                                                                    CommandParameter="{Binding}"
                                                                    Background="Transparent"
                                                                    BorderThickness="0"
                                                                    Padding="4,1"
                                                                    Cursor="Hand"
                                                                    ToolTip.Tip="Unpin from top bar">
                                                                <TextBlock Text="✕" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                                            </Button>
                                                        </StackPanel>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <!-- Section 3: All Fleet Metrics Catalog & Quick Pin -->
                                <Border Background="{DynamicResource DarkBaseBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14,12">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                <TextBlock Text="ALL FLEET METRICS &amp; QUICK PIN"
                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           Foreground="{DynamicResource TextMutedBrush}"/>
                                                <TextBlock Text="Live cross-node rollup updated every second"
                                                           FontSize="10"
                                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>

                                            <!-- Segmented Catalog Modifier Selector -->
                                            <Border Grid.Column="1"
                                                    Background="{DynamicResource CardBgBrush}"
                                                    BorderBrush="{DynamicResource BorderBrush}"
                                                    BorderThickness="1"
                                                    CornerRadius="6"
                                                    Padding="2">
                                                <StackPanel Orientation="Horizontal" Spacing="2">
                                                    <Button Classes="mod-btn"
                                                            Classes.active="{Binding IsModifierSum}"
                                                            Content="Sum"
                                                            Command="{Binding SetModifierCommand}"
                                                            CommandParameter="Sum"/>
                                                    <Button Classes="mod-btn"
                                                            Classes.active="{Binding IsModifierAvg}"
                                                            Content="Avg"
                                                            Command="{Binding SetModifierCommand}"
                                                            CommandParameter="Avg"/>
                                                    <Button Classes="mod-btn"
                                                            Classes.active="{Binding IsModifierRate}"
                                                            Content="Rate of Change (/s)"
                                                            Command="{Binding SetModifierCommand}"
                                                            CommandParameter="Rate of Change"/>
                                                </StackPanel>
                                            </Border>
                                        </Grid>

                                        <ItemsControl ItemsSource="{Binding GlobalMetrics}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <WrapPanel Orientation="Horizontal"/>
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:GlobalMetricItemViewModel">
                                                    <Border Width="318"
                                                            Background="{DynamicResource CardBgBrush}"
                                                            BorderBrush="{DynamicResource BorderBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="8"
                                                            Padding="12"
                                                            Margin="0,0,8,8">
                                                        <Grid RowDefinitions="Auto,Auto,Auto">
                                                            <!-- Header: Icon, Name, Modifier Tag -->
                                                            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,6">
                                                                <TextBlock Grid.Column="0" Text="{Binding Icon}" FontSize="13" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                                                <TextBlock Grid.Column="1" Text="{Binding Name}"
                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                           FontSize="11"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <Border Grid.Column="2" Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="5,1">
                                                                    <TextBlock Text="{Binding ModifierLabel}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource AccentTextBrush}"/>
                                                                </Border>
                                                            </Grid>

                                                            <!-- Large Value -->
                                                            <TextBlock Grid.Row="1"
                                                                       Text="{Binding FormattedValue}"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="18"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                                       Margin="0,2,0,4"/>

                                                            <!-- Footer: Context and Quick Pin Button -->
                                                            <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                                                <TextBlock Grid.Column="0"
                                                                           Text="{Binding Context}"
                                                                           FontSize="10"
                                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                                           VerticalAlignment="Center"/>
                                                                <Button Grid.Column="1"
                                                                        Command="{Binding $parent[UserControl].((vm:CollectorSettingsViewModel)DataContext).TogglePinForMetricCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="{DynamicResource DarkBaseBrush}"
                                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                                        BorderThickness="1"
                                                                        CornerRadius="4"
                                                                        Padding="6,3"
                                                                        Cursor="Hand">
                                                                    <Panel>
                                                                        <TextBlock Text="✓ Pinned" IsVisible="{Binding IsPinned}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource HealthyBrush}"/>
                                                                        <TextBlock Text="+ Pin to Bar" IsVisible="{Binding !IsPinned}" FontSize="9" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource AccentTextBrush}"/>
                                                                    </Panel>
                                                                </Button>
                                                            </Grid>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>
                </TabControl>

                <!-- Footer Status & Actions -->
                <Grid Grid.Row="2" ColumnDefinitions="*,Auto" Margin="0,16,0,0">
                    <TextBlock Text="{Binding StatusMessage}"
                               FontSize="11"
                               Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                        <Button Command="{Binding RefreshAllCommand}"
                                Background="{DynamicResource DarkBaseBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                Cursor="Hand">
                            <TextBlock Text="🔄 Discover Nodes" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                        <Button Command="{Binding CloseCommand}"
                                Background="{DynamicResource DarkBaseBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="12,6"
                                Cursor="Hand">
                            <TextBlock Text="Done" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Button>
                    </StackPanel>
                </Grid>
            </Grid>

            <!-- Unapplied Changes Confirmation Modal Overlay -->
            <Grid IsVisible="{Binding IsUnsavedPromptOpen}"
                  Background="#CC000000"
                  HorizontalAlignment="Stretch"
                  VerticalAlignment="Stretch">
                <Border Background="{DynamicResource CardBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Width="440"
                        Padding="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        BoxShadow="0 8 24 #80000000">
                    <StackPanel Spacing="14">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <Border Background="{DynamicResource WarningSubtleBrush}" BorderBrush="{DynamicResource WarningBrush}" BorderThickness="1" CornerRadius="6" Padding="6,4">
                                <TextBlock Text="⚠️" FontSize="14"/>
                            </Border>
                            <StackPanel Spacing="2">
                                <TextBlock Text="Unapplied Changes"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontWeight="Bold"
                                           FontSize="14"
                                           Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <TextBlock Text="You have modified settings that have not been applied to the node."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </StackPanel>
                        </StackPanel>

                        <TextBlock Text="Would you like to apply these changes to the daemon before closing, or discard them and revert to the daemon's current settings?"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   TextWrapping="Wrap"/>

                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" Margin="0,6,0,0">
                            <Button Grid.Column="0"
                                    Command="{Binding DiscardAndCloseCommand}"
                                    Background="{DynamicResource DarkBaseBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Cursor="Hand">
                                <TextBlock Text="Discard Changes" FontSize="11" Foreground="{DynamicResource CriticalBrush}"/>
                            </Button>

                            <Button Grid.Column="2"
                                    Command="{Binding CancelClosePromptCommand}"
                                    Background="{DynamicResource DarkBaseBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="6"
                                    Padding="10,6"
                                    Margin="0,0,8,0"
                                    Cursor="Hand">
                                <TextBlock Text="Cancel" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                            </Button>

                            <Button Grid.Column="3"
                                    Command="{Binding ApplyAndCloseCommand}"
                                    Background="{DynamicResource AccentBrush}"
                                    CornerRadius="6"
                                    Padding="12,6"
                                    Cursor="Hand">
                                <TextBlock Text="Apply &amp; Close" FontWeight="Bold" FontSize="11" Foreground="White"/>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Symmetric Resize Border Handles -->
            <Border x:Name="ResizeLeft" HorizontalAlignment="Left" VerticalAlignment="Stretch" Width="8" Margin="0,12" Cursor="SizeWestEast" Background="Transparent"/>
            <Border x:Name="ResizeRight" HorizontalAlignment="Right" VerticalAlignment="Stretch" Width="8" Margin="0,12" Cursor="SizeWestEast" Background="Transparent"/>
            <Border x:Name="ResizeTop" HorizontalAlignment="Stretch" VerticalAlignment="Top" Height="8" Margin="12,0" Cursor="SizeNorthSouth" Background="Transparent"/>
            <Border x:Name="ResizeBottom" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Height="8" Margin="12,0" Cursor="SizeNorthSouth" Background="Transparent"/>

            <Border x:Name="ResizeTopLeft" HorizontalAlignment="Left" VerticalAlignment="Top" Width="14" Height="14" Cursor="TopLeftCorner" Background="Transparent"/>
            <Border x:Name="ResizeTopRight" HorizontalAlignment="Right" VerticalAlignment="Top" Width="14" Height="14" Cursor="TopRightCorner" Background="Transparent"/>
            <Border x:Name="ResizeBottomLeft" HorizontalAlignment="Left" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="BottomLeftCorner" Background="Transparent"/>
            <Border x:Name="ResizeBottomRight" HorizontalAlignment="Right" VerticalAlignment="Bottom" Width="14" Height="14" Cursor="BottomRightCorner" Background="Transparent"/>
        </Panel>
    </Border>
    </Grid>

</UserControl>
