<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:logs="using:MadTOM.Controls.Logs"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="500"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostLogsTabView"
             x:DataType="vm:HostLogsTabViewModel">

    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid RowDefinitions="Auto,*">

            <!-- Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="System Journal Stream"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="{DynamicResource AccentSubtleBrush}"
                                    CornerRadius="4"
                                    Padding="6,2">
                                <TextBlock Text="{Binding StatusBadgeText}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="{Binding StatsSummary}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Grid>

            <!-- Console Log Window & Virtual Viewport -->
            <Panel Grid.Row="1">
                <Border Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        MinHeight="360"
                        ClipToBounds="True">
                    <logs:VirtualLogViewControl x:Name="LogViewer"
                                                NodeId="{Binding HostId}"
                                                CollectorEndpoint="{Binding CollectorEndpoint}"
                                                LogMode="{Binding LogMode}"
                                                LogCache="{Binding LogCache}"
                                                TotalRecords="{Binding TotalRecords}"
                                                FirstSeq="{Binding FirstSeq}"
                                                LastSeq="{Binding LastSeq}"
                                                IsFollowMode="{Binding IsFollowMode, Mode=TwoWay}"
                                                CacheRevision="{Binding CacheRevision}"
                                                ChunkUnavailablePredicate="{Binding IsChunkUnavailablePredicate}"/>
                </Border>

                <!-- Floating "Jump to latest (↓)" button -->
                <Button Command="{Binding ScrollToLatestCommand}"
                        IsVisible="{Binding HasNewLogs}"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Bottom"
                        Margin="0,0,0,16"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        CornerRadius="14"
                        Padding="14,6"
                        Cursor="Hand">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <TextBlock Text="↓" FontWeight="Bold" FontSize="12"/>
                        <TextBlock Text="Jump to latest" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold"/>
                    </StackPanel>
                </Button>
            </Panel>

        </Grid>
    </Border>
</UserControl>
