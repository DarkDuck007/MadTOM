<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:models="using:MadTOM.Models"
             xmlns:charts="using:MadTOM.Controls.Charts"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostProcessesTabView"
             x:DataType="vm:HostProcessesTabViewModel">

    <UserControl.Styles>
        <Style Selector="Button.subtab-btn">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,5" />
            <Setter Property="CornerRadius" Value="6" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        </Style>
        <Style Selector="Button.subtab-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.subtab-btn.active">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource CyanBrush}" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <Style Selector="Button.scope-btn">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,3" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontFamily" Value="{StaticResource MonoFontFamily}" />
        </Style>
        <Style Selector="Button.scope-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        </Style>
        <Style Selector="Button.scope-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">

        <!-- Top Navigation Port (Flex WrapPanel) -->
        <WrapPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,8">
            <!-- Sub-tabs: List & Overview -->
            <Border Background="{DynamicResource DarkBaseBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="2"
                    Margin="0,0,10,4">
                <StackPanel Orientation="Horizontal" Spacing="2">
                    <Button Content="List"
                            Command="{Binding SelectProcessListTabCommand}"
                            Classes="subtab-btn"
                            Classes.active="{Binding IsProcessListTabSelected}"/>
                    <Button Content="Overview"
                            Command="{Binding SelectProcessOverviewTabCommand}"
                            Classes="subtab-btn"
                            Classes.active="{Binding IsProcessOverviewTabSelected}"/>
                </StackPanel>
            </Border>

            <!-- Filter TextBox (Width halved from 260 to 130; visible on List sub-tab) -->
            <TextBox Text="{Binding SearchFilter, Mode=TwoWay}"
                     PlaceholderText="Filter processes..."
                     FontFamily="{StaticResource MonoFontFamily}"
                     FontSize="11"
                     Width="130"
                     IsVisible="{Binding IsProcessListTabSelected}"
                     Background="{DynamicResource DarkBaseBrush}"
                     Foreground="{DynamicResource TextPrimaryBrush}"
                     BorderBrush="{DynamicResource BorderBrush}"
                     CornerRadius="6"
                     Padding="8,5"
                     Margin="0,0,8,4"
                     VerticalAlignment="Center"/>

            <!-- Refresh Button -->
            <Button Command="{Binding RefreshCommand}"
                    Background="{DynamicResource DarkBaseBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="10,5"
                    Margin="0,0,10,4"
                    Cursor="Hand"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="5">
                    <TextBlock Text="↻" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Refresh" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                </StackPanel>
            </Button>

            <!-- Target Host Indicator -->
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Margin="0,0,0,4">
                <TextBlock Text="Target:"
                           FontFamily="{StaticResource MonoFontFamily}"
                           FontSize="10"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"/>
                <Border Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4"
                        Padding="6,2">
                    <TextBlock Text="{Binding TargetHostId}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="10"
                               FontWeight="Bold"
                               Foreground="{DynamicResource CyanBrush}"/>
                </Border>
            </StackPanel>
        </WrapPanel>

        <!-- Content Area -->
        <Grid Grid.Row="1">
            <!-- SUB-TAB 1: Process List -->
            <Grid IsVisible="{Binding IsProcessListTabSelected}" RowDefinitions="Auto,*">

                <!-- Pagination Row -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,8">
                    <TextBlock Text="{Binding PageCount, StringFormat='Page {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="100 processes per page" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                        <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}" Padding="8,3"/>
                        <Button Content="Next ›" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" Padding="8,3"/>
                    </StackPanel>
                </Grid>

                <!-- Process Table -->
                <Border Grid.Row="1"
                        Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*">
                        <!-- Header Row -->
                        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" Padding="10,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                            <Grid ColumnDefinitions="70,*,120,80,80,110,140">
                                <TextBlock Grid.Column="0" Text="PID" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="COMMAND" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="USER" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="3" Text="THREADS" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="4" Text="CPU %" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="5" Text="MEMORY" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="6" Text="ACTIONS" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                            </Grid>
                        </Border>

                        <Panel Grid.Row="1">
                            <!-- Virtualized ListBox -->
                            <ListBox ItemsSource="{Binding Processes}"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     Padding="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Padding" Value="0"/>
                                        <Setter Property="Margin" Value="0"/>
                                        <Setter Property="MinHeight" Value="0"/>
                                        <Setter Property="Background" Value="Transparent"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                        <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProcessInfoModel">
                                        <Border Padding="12,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="70,*,120,80,80,110,140">
                                                <TextBlock Grid.Column="0" Text="{Binding Pid}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="2" Text="{Binding User}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Threads}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Cpu, StringFormat={}{0:F1}%}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HealthyBrush}" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Mem}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                                <!-- Actions -->
                                                <StackPanel IsEnabled="{Binding $parent[UserControl].((vm:HostProcessesTabViewModel)DataContext).CanSendSignals}" Grid.Column="6" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                                    <Button Content="{loc:Loc processTerm}"
                                                            Command="{Binding $parent[UserControl].((vm:HostProcessesTabViewModel)DataContext).DispatchTermCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource WarningSubtleBrush}"
                                                            BorderBrush="{DynamicResource WarningBrush}"
                                                            BorderThickness="1"
                                                            Foreground="{DynamicResource WarningBrush}"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Padding="6,2"
                                                            CornerRadius="4"/>
                                                    <Button Content="{loc:Loc processKill}"
                                                            Command="{Binding $parent[UserControl].((vm:HostProcessesTabViewModel)DataContext).DispatchKillCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource CriticalSubtleBrush}"
                                                            BorderBrush="{DynamicResource CriticalBrush}"
                                                            BorderThickness="1"
                                                            Foreground="{DynamicResource CriticalBrush}"
                                                            FontFamily="{StaticResource MonoFontFamily}"
                                                            FontSize="10"
                                                            FontWeight="Bold"
                                                            Padding="6,2"
                                                            CornerRadius="4"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <!-- Process Telemetry Disabled Notification -->
                            <Border IsVisible="{Binding IsProcessCollectionDisabled}"
                                    Background="{DynamicResource DarkBaseBrush}"
                                    HorizontalAlignment="Stretch"
                                    VerticalAlignment="Stretch">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
                                    <TextBlock Text="⊘ Process Telemetry Disabled"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="13"
                                               FontWeight="Bold"
                                               Foreground="{DynamicResource AmberBrush}"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="Process probing is currently turned off for this node in Collector settings to conserve CPU and network resources."
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               MaxWidth="450"
                                               TextWrapping="Wrap"/>
                                    <TextBlock Text="To enable live process snapshots or historical charting, open Collector Settings ➔ Node Opt-in Configuration and choose 'Live Only' or 'Probed &amp; Stored'."
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"
                                               HorizontalAlignment="Center"
                                               TextAlignment="Center"
                                               MaxWidth="450"
                                               TextWrapping="Wrap"/>
                                </StackPanel>
                            </Border>
                        </Panel>
                    </Grid>
                </Border>
            </Grid>

            <!-- SUB-TAB 2: Process Overview (True Top N Aggregated Graph) -->
            <!-- SUB-TAB 2: Process Overview -->
            <Grid Grid.Row="1" RowDefinitions="Auto,*,Auto" IsVisible="{Binding IsProcessOverviewTabSelected}">
                <!-- Overview Toolbar with Scopes & Top N Selector -->
                <Border Grid.Row="0"
                        Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,4"
                        Margin="0,0,0,8">
                    <Grid ColumnDefinitions="Auto,*,Auto">
                        <!-- Scopes (Same as Historical Telemetry) -->
                        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="Scope:"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"
                                       Margin="0,0,4,0"/>

                            <Button Content="1m" Command="{Binding SetScopeCommand}" CommandParameter="1m"
                                    Classes="scope-btn" Classes.active="{Binding IsScope1m}"/>
                            <Button Content="5m" Command="{Binding SetScopeCommand}" CommandParameter="5m"
                                    Classes="scope-btn" Classes.active="{Binding IsScope5m}"/>
                            <Button Content="30m" Command="{Binding SetScopeCommand}" CommandParameter="30m"
                                    Classes="scope-btn" Classes.active="{Binding IsScope30m}"/>
                            <Button Content="2h" Command="{Binding SetScopeCommand}" CommandParameter="2h"
                                    Classes="scope-btn" Classes.active="{Binding IsScope2h}"/>
                            <Button Content="6h" Command="{Binding SetScopeCommand}" CommandParameter="6h"
                                    Classes="scope-btn" Classes.active="{Binding IsScope6h}"/>
                            <Button Content="12h" Command="{Binding SetScopeCommand}" CommandParameter="12h"
                                    Classes="scope-btn" Classes.active="{Binding IsScope12h}"/>
                            <Button Content="24h" Command="{Binding SetScopeCommand}" CommandParameter="24h"
                                    Classes="scope-btn" Classes.active="{Binding IsScope24h}"/>
                            <Button Content="Custom" Command="{Binding SetScopeCommand}" CommandParameter="custom"
                                    Classes="scope-btn" Classes.active="{Binding IsScopeCustom}"/>
                        </StackPanel>

                        <!-- Top N Slider / Selector -->
                        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Track Top N:"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextSecondaryBrush}"
                                       VerticalAlignment="Center"/>
                            <Slider Minimum="1" Maximum="10" SmallChange="1" LargeChange="1"
                                    TickFrequency="1" IsSnapToTickEnabled="True"
                                    Value="{Binding OverviewTopN, Mode=TwoWay}"
                                    Width="100"
                                    VerticalAlignment="Center"/>
                            <Border Background="{DynamicResource CardBgBrush}"
                                    BorderBrush="{DynamicResource CyanBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding OverviewTopN, StringFormat='Top {0}'}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource CyanBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Chart Container -->
                <Border Grid.Row="1"
                        Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8"
                        ClipToBounds="True">
                    <Grid>
                        <charts:MetricHistoryChartControl SeriesList="{Binding OverviewSeries}"
                                                          Timestamps="{Binding OverviewTimestamps}"
                                                          WindowStart="{Binding OverviewWindowStart}"
                                                          WindowEnd="{Binding OverviewWindowEnd}"
                                                          ZoomLevel="{Binding OverviewZoomLevel}"
                                                          PanOffset="{Binding OverviewPanOffset}"
                                                          Height="360"/>

                        <!-- Process Telemetry Disabled Notification -->
                        <Border IsVisible="{Binding IsProcessCollectionDisabled}"
                                Background="{DynamicResource DarkBaseBrush}"
                                HorizontalAlignment="Stretch"
                                VerticalAlignment="Stretch">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8" Margin="24">
                                <TextBlock Text="⊘ Process Telemetry Disabled"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource AmberBrush}"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Process probing is currently turned off for this node in Collector settings to conserve CPU and network resources."
                                           FontSize="11"
                                           Foreground="{DynamicResource TextSecondaryBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           MaxWidth="450"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="To enable live process snapshots or historical charting, open Collector Settings ➔ Node Opt-in Configuration and choose 'Live Only' or 'Probed &amp; Stored'."
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Center"
                                           TextAlignment="Center"
                                           MaxWidth="450"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Active Ranks & Current Leader Processes Footer Legend -->
                <Border Grid.Row="2"
                        Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Padding="8,6"
                        Margin="0,6,0,0">
                    <StackPanel Spacing="4">
                        <TextBlock Text="CURRENT LEADER PROCESSES PER RANK:"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                        <ItemsControl ItemsSource="{Binding CurrentRankLeaders}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal"/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProcessRankLeaderModel">
                                    <Border Background="{DynamicResource CardBgBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="6"
                                            Padding="6,3"
                                            Margin="0,0,6,4">
                                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                            <Border Width="10" Height="10" CornerRadius="5" Background="{Binding ColorHex}"/>
                                            <TextBlock Text="{Binding Rank, StringFormat='#{0}:'}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Text="{Binding ProcessName}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="SemiBold"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                                            <TextBlock Text="{Binding Cpu, StringFormat='{}{0:F1}%'}"
                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                       FontSize="11"
                                                       FontWeight="Bold"
                                                       Foreground="{DynamicResource CyanBrush}"/>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </Grid>
    </Grid>
</UserControl>
