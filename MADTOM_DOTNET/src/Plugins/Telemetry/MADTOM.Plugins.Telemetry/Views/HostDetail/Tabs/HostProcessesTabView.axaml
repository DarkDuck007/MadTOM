<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:models="using:MadTOM.Models"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostProcessesTabView"
             x:DataType="vm:HostProcessesTabViewModel">

    <Border Background="{DynamicResource CardBgBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- Filter & Refresh Toolbar -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,12">
                <TextBox Grid.Column="0"
                         Text="{Binding SearchFilter, Mode=TwoWay}"
                         PlaceholderText="Filter process PID, name, user..."
                         FontFamily="{StaticResource MonoFontFamily}"
                         FontSize="11"
                         Width="260"
                         HorizontalAlignment="Left"
                         Background="{DynamicResource DarkBaseBrush}"
                         Foreground="{DynamicResource TextPrimaryBrush}"
                         BorderBrush="{DynamicResource BorderBrush}"
                         CornerRadius="6"
                         Padding="10,6"/>

                <Button Grid.Column="1"
                        Command="{Binding RefreshCommand}"
                        Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="6"
                        Padding="12,6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="↻" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Refresh" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                    </StackPanel>
                </Button>
            </Grid>

            <!-- Pagination Row -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,10">
                <TextBlock Text="{Binding PageCount, StringFormat='Page {0}'}" Foreground="{DynamicResource TextMutedBrush}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" VerticalAlignment="Center"/>
                <TextBlock Grid.Column="1" Text="100 processes per page" Foreground="{DynamicResource TextMutedBrush}" FontSize="10" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                    <Button Content="‹ Previous" Command="{Binding PreviousPageCommand}" IsEnabled="{Binding CanPreviousPage}" Padding="8,3"/>
                    <Button Content="Next ›" Command="{Binding NextPageCommand}" IsEnabled="{Binding CanNextPage}" Padding="8,3"/>
                </StackPanel>
            </Grid>

            <!-- Process Table -->
            <Border Grid.Row="2"
                    Background="{DynamicResource DarkBaseBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header Row -->
                    <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="70,*,120,80,80,110,140">
                            <TextBlock Grid.Column="0" Text="PID" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="COMMAND" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="USER" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="THREADS" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="CPU %" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="5" Text="MEMORY" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="6" Text="ACTIONS" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <!-- Virtualized ListBox -->
                    <ListBox Grid.Row="1"
                             ItemsSource="{Binding Processes}"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.Styles>
                            <Style Selector="ListBoxItem">
                                <Setter Property="Padding" Value="0"/>
                                <Setter Property="Margin" Value="0"/>
                                <Setter Property="MinHeight" Value="0"/>
                                <Setter Property="Background" Value="Transparent"/>
                            </Style>
                            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}"/>
                            </Style>
                            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
                                <Setter Property="Background" Value="{DynamicResource CardBgBrush}"/>
                            </Style>
                        </ListBox.Styles>
                        <ListBox.ItemTemplate>
                            <DataTemplate x:DataType="models:ProcessInfoModel">
                                <Border Padding="12,8" BorderBrush="{DynamicResource BorderSubtleBrush}" BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="70,*,120,80,80,110,140">
                                        <TextBlock Grid.Column="0" Text="{Binding Pid}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Name}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Medium" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="2" Text="{Binding User}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="3" Text="{Binding Threads}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="4" Text="{Binding Cpu, StringFormat={}{0:F1}%}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource HealthyBrush}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="5" Text="{Binding Mem}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>

                                        <!-- Actions -->
                                        <StackPanel IsEnabled="{Binding $parent[UserControl].((vm:HostProcessesTabViewModel)DataContext).CanSendSignals}" Grid.Column="6" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                                            <Button Content="{loc:Loc processTerm}"
                                                    Command="{Binding $parent[UserControl].((vm:HostProcessesTabViewModel)DataContext).DispatchTermCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource WarningSubtleBrush}"
                                                    BorderBrush="{DynamicResource WarningBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource WarningBrush}"
                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Padding="6,2"
                                                    CornerRadius="4"/>
                                            <Button Content="{loc:Loc processKill}"
                                                    Command="{Binding $parent[UserControl].((vm:HostProcessesTabViewModel)DataContext).DispatchKillCommand}"
                                                    CommandParameter="{Binding}"
                                                    Background="{DynamicResource CriticalSubtleBrush}"
                                                    BorderBrush="{DynamicResource CriticalBrush}"
                                                    BorderThickness="1"
                                                    Foreground="{DynamicResource CriticalBrush}"
                                                    FontFamily="{StaticResource MonoFontFamily}"
                                                    FontSize="10"
                                                    FontWeight="Bold"
                                                    Padding="6,2"
                                                    CornerRadius="4"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>

        </Grid>
    </Border>
</UserControl>
