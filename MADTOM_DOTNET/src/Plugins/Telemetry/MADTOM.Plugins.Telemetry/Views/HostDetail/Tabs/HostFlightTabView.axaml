<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:vmt="using:MadTOM.ViewModels.Topology"
             xmlns:views="using:MadTOM.Views.Topology"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostFlightTabView"
             x:DataType="vm:HostFlightTabViewModel">

    <Grid RowDefinitions="Auto,*" Background="#0D1117">
        <!-- Top Loading & Status Progress Bar -->
        <Border Grid.Row="0" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="14,10">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBlock Text="Network Topology &amp; Rules" FontWeight="SemiBold" FontSize="14" Foreground="White"/>
                    <Border Background="#21262D" CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                        <TextBlock Text="{Binding DropRate}" FontSize="11" Foreground="#8B949E"/>
                    </Border>
                </StackPanel>

                <!-- Stage Subtitle & Progress Indicator -->
                <StackPanel Grid.Column="1" Margin="24,0" VerticalAlignment="Center" Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Grid.Column="0" Text="{Binding Topology.CurrentStageSubtitle}"
                                   FontSize="11" Foreground="#58A6FF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Grid.Column="1" Text="{Binding Topology.LoadingProgress, StringFormat='{}{0:F0}%'}"
                                   FontSize="11" Foreground="#8B949E" IsVisible="{Binding Topology.IsLoading}"/>
                    </Grid>
                    <ProgressBar IsIndeterminate="{Binding Topology.IsLoading}"
                                 Value="{Binding Topology.LoadingProgress}"
                                 Maximum="100" Height="3" Background="#21262D" Foreground="#238636"
                                 IsVisible="{Binding Topology.IsLoading}"/>
                </StackPanel>

                <!-- Node Capabilities Badges & Drawer Toggle -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Border Background="#1F6FEB" CornerRadius="4" Padding="6,2" ToolTip.Tip="Kernel Netlink (AF_NETLINK) operational">
                        <TextBlock Text="NETLINK" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <!-- Real Firewall Backend Badge (detected directly from node's kernel/executables) -->
                    <Border Background="{Binding Topology.FirewallBackendColor}" 
                            CornerRadius="4" Padding="6,2" ToolTip.Tip="{Binding Topology.FirewallBackendTooltip}">
                        <TextBlock Text="{Binding Topology.FirewallBackendTag}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <!-- Real Active TCP Congestion Control Algorithm (read from /proc/sys/net/ipv4/tcp_congestion_control) -->
                    <Border Background="#238636" CornerRadius="4" Padding="6,2" 
                            ToolTip.Tip="System default TCP congestion algorithm (/proc/sys/net/ipv4/tcp_congestion_control)">
                        <TextBlock Text="{Binding Topology.DefaultTcpCc, StringFormat='CC: {0}'}" FontSize="10" FontWeight="Bold" Foreground="White"/>
                    </Border>
                    <!-- Toggle Inspector Drawer Button -->
                    <Button Command="{Binding Topology.ToggleInspectorCommand}"
                            Padding="8,3" FontSize="11" Background="#21262D" Foreground="White"
                            ToolTip.Tip="Toggle Inspector Panel (Collapse / Expand)">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <TextBlock Text="📋" FontSize="10"/>
                            <TextBlock Text="Inspector" FontSize="10" FontWeight="SemiBold"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Visualizer Area: Canvas + Resizable Sliding Inspector Drawer -->
        <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto">
            <!-- 2D Interactive Map Canvas with Overlay Controls -->
            <Grid Grid.Column="0">
                <views:TopologyCanvasControl ViewModel="{Binding Topology}"/>

                <!-- Floating Canvas Controls Overlay (Auto Arrange & Center Graph) -->
                <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="16"
                        Background="#161B22" BorderBrush="#30363D" BorderThickness="1" CornerRadius="6" Padding="6">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Button Content="Auto Arrange" Command="{Binding Topology.AutoArrangeCommand}"
                                Padding="10,6" FontSize="11" Background="#21262D" Foreground="White"
                                ToolTip.Tip="Automatically organize nodes into structured topology tiers (Loopback, Interfaces, Gateways, Containers)"/>
                        <Button Content="Center Graph" Command="{Binding Topology.CenterGraphCommand}"
                                Padding="10,6" FontSize="11" Background="#21262D" Foreground="White"
                                ToolTip.Tip="Fit and center all nodes within the current view"/>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Drag Resizer GridSplitter -->
            <GridSplitter Grid.Column="1" Width="4" Background="#21262D" ResizeDirection="Columns"
                          IsVisible="{Binding Topology.IsInspectorOpen}"/>

            <!-- Dense Inspector Drawer -->
            <Border Grid.Column="2" Width="{Binding Topology.InspectorWidth, Mode=TwoWay}"
                    MinWidth="320" MaxWidth="900"
                    Background="#161B22" BorderBrush="#30363D" BorderThickness="1,0,0,0"
                    IsVisible="{Binding Topology.IsInspectorOpen}">
                <Grid RowDefinitions="Auto,Auto,*">
                    <!-- Inspector Header -->
                    <Border Grid.Row="0" Background="#21262D" Padding="12,10" BorderBrush="#30363D" BorderThickness="0,0,0,1">
                        <Grid ColumnDefinitions="*,Auto">
                            <!-- Contextual Title: Selected item if any, otherwise Global Scope -->
                            <StackPanel Grid.Column="0" ToolTip.Tip="{Binding Topology.SelectedNode.FullDetailsText}">
                                <TextBlock Text="{Binding Topology.SelectedNode.Title, FallbackValue='Host Network Tables &amp; Rules'}" 
                                           FontWeight="Bold" FontSize="14" Foreground="White" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding Topology.SelectedNode.Subtitle, FallbackValue='Inspection data across all interfaces and sockets'}" 
                                           FontSize="11" Foreground="#8B949E" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                <Button Content="Deselect" Command="{Binding Topology.DeselectNodeCommand}"
                                        IsVisible="{Binding Topology.SelectedNode, Converter={x:Null}}"
                                        Background="Transparent" Foreground="#8B949E" FontSize="11" Padding="6,2"/>
                                <Button Content="✕" Command="{Binding Topology.CloseInspectorCommand}"
                                        Background="Transparent" Foreground="#8B949E" Padding="6,2" VerticalAlignment="Top"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- Inspector Tab Switcher -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Background="#0D1117" Spacing="2" Margin="0,0,0,1">
                        <Button Content="Routes" Command="{Binding Topology.SwitchInspectorTabCommand}" CommandParameter="routes"
                                Padding="12,8" FontSize="11"
                                Background="{Binding Topology.IsRoutesTab, Converter={x:Null}}" Foreground="White"/>
                        <Button Content="Firewall Rules" Command="{Binding Topology.SwitchInspectorTabCommand}" CommandParameter="firewall"
                                Padding="12,8" FontSize="11"
                                Background="{Binding Topology.IsFirewallTab, Converter={x:Null}}" Foreground="White"/>
                        <Button Content="Sockets (TCP)" Command="{Binding Topology.SwitchInspectorTabCommand}" CommandParameter="sockets"
                                Padding="12,8" FontSize="11"
                                Background="{Binding Topology.IsSocketsTab, Converter={x:Null}}" Foreground="White"/>
                        <Button Content="ARP / Neighbors" Command="{Binding Topology.SwitchInspectorTabCommand}" CommandParameter="neighbors"
                                Padding="12,8" FontSize="11"
                                Background="{Binding Topology.IsNeighborsTab, Converter={x:Null}}" Foreground="White"/>
                        <Button Content="Diagnostics" Command="{Binding Topology.SwitchInspectorTabCommand}" CommandParameter="diag"
                                Padding="12,8" FontSize="11"
                                Background="{Binding Topology.IsDiagTab, Converter={x:Null}}" Foreground="White"/>
                    </StackPanel>

                    <!-- Inspector Content Views -->
                    <Grid Grid.Row="2">
                        <!-- Routes Table -->
                        <ScrollViewer IsVisible="{Binding Topology.IsRoutesTab}">
                            <ItemsControl ItemsSource="{Binding Topology.Routes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmt:RouteRowViewModel">
                                        <Border Padding="10,6" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,110,80,60">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding Destination}" FontWeight="SemiBold" FontSize="12" Foreground="White" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Gateway, StringFormat='via {0}'}" FontSize="11" Foreground="#58A6FF"
                                                               TextWrapping="Wrap"
                                                               IsVisible="{Binding Gateway, Converter={x:Null}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding InterfaceName}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Protocol}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Metric, StringFormat='m:{0}'}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Firewall Rules Table -->
                        <ScrollViewer IsVisible="{Binding Topology.IsFirewallTab}">
                            <ItemsControl ItemsSource="{Binding Topology.FirewallRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmt:FirewallRuleRowViewModel">
                                        <Border Padding="10,8" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <Border Grid.Column="0" Background="{Binding VerdictColor}" CornerRadius="3" Padding="6,2" Margin="0,0,8,0" VerticalAlignment="Top">
                                                    <TextBlock Text="{Binding Verdict}" FontWeight="Bold" FontSize="10" Foreground="White"/>
                                                </Border>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Statement}" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Comment}" FontSize="10" Foreground="#8B949E" IsVisible="{Binding Comment, Converter={x:Null}}"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Packets, StringFormat='{}{0:N0} pkts'}" FontSize="10" Foreground="#8B949E" VerticalAlignment="Top"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Sockets (TCP) Table -->
                        <ScrollViewer IsVisible="{Binding Topology.IsSocketsTab}">
                            <ItemsControl ItemsSource="{Binding Topology.Sockets}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmt:SocketRowViewModel">
                                        <Border Padding="10,6" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,*,90,70">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding LocalEndpoint}" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding ProcessDisplay}" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding RemoteEndpoint}" FontSize="11" Foreground="#58A6FF" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding CongestionAlgorithm, StringFormat='CC: {0}'}" FontSize="10" Foreground="#8B949E"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding FormattedDeliveryRate}" FontSize="11" Foreground="#3FB950" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="3" Text="{Binding FormattedRtt}" FontSize="11" Foreground="#E3B341" VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- ARP / Neighbors Table -->
                        <ScrollViewer IsVisible="{Binding Topology.IsNeighborsTab}">
                            <ItemsControl ItemsSource="{Binding Topology.Neighbors}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vmt:NeighborRowViewModel">
                                        <Border Padding="10,6" BorderBrush="#21262D" BorderThickness="0,0,0,1">
                                            <Grid ColumnDefinitions="*,*,100">
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock Text="{Binding IpAddress}" FontWeight="SemiBold" FontSize="11" Foreground="White" TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding InterfaceName, StringFormat='dev: {0}'}" FontSize="10" Foreground="#8B949E"/>
                                                </StackPanel>
                                                <TextBlock Grid.Column="1" Text="{Binding MacAddress}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#58A6FF" VerticalAlignment="Center"/>
                                                <TextBlock Grid.Column="2" Text="{Binding State}" Foreground="{Binding StateColor}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Active Read-Only Diagnostics (Ping, Traceroute, Route Get) -->
                        <Grid RowDefinitions="Auto,*" Margin="12" IsVisible="{Binding Topology.IsDiagTab}">
                            <StackPanel Grid.Row="0" Spacing="8">
                                <TextBlock Text="Active Read-Only Diagnostics" FontWeight="Bold" FontSize="12" Foreground="White"/>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                    <TextBox Grid.Column="0" Text="{Binding Topology.DiagTarget}" PlaceholderText="IP address or domain (e.g. 1.1.1.1)"/>
                                    <Button Grid.Column="1" Content="Execute" Command="{Binding Topology.RunProbeCommand}"
                                            Margin="8,0,0,0" Background="#238636" Foreground="White"/>
                                </Grid>
                            </StackPanel>
                            <Border Grid.Row="1" Background="#0D1117" BorderBrush="#30363D" BorderThickness="1" CornerRadius="4" Margin="0,10,0,0" Padding="8">
                                <ScrollViewer>
                                    <TextBlock Text="{Binding Topology.ProbeConsoleOutput}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#58A6FF"/>
                                </ScrollViewer>
                            </Border>
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
