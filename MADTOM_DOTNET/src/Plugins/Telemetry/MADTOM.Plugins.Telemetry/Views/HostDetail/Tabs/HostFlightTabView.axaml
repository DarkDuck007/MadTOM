<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:vm="using:MadTOM.ViewModels" x:Class="MadTOM.Views.HostDetail.Tabs.HostFlightTabView" x:DataType="vm:HostFlightTabViewModel">
 <StackPanel Spacing="12">
 <TextBlock Text="Network interfaces" FontSize="18"/><TextBlock Text="{Binding DropRate}"/>
 <Grid ColumnDefinitions="*,*,60,120,120,80,80" Margin="8"><TextBlock Grid.Column="0" Text="Node"/><TextBlock Grid.Column="1" Text="Interface"/><TextBlock Grid.Column="2" Text="Link"/><TextBlock Grid.Column="3" Text="RX bytes"/><TextBlock Grid.Column="4" Text="TX bytes"/><TextBlock Grid.Column="5" Text="Drops"/><TextBlock Grid.Column="6" Text="Errors"/></Grid>
 <ItemsControl ItemsSource="{Binding Interfaces}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:NetworkInterfaceRow">
 <Border Padding="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"><Grid ColumnDefinitions="*,*,60,120,120,80,80"><TextBlock Grid.Column="0" Text="{Binding Node}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="2" Text="{Binding State}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="3" Text="{Binding RxBytes}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="4" Text="{Binding TxBytes}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="5" Text="{Binding Drops}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="6" Text="{Binding Errors}" TextTrimming="CharacterEllipsis"/></Grid></Border>
 </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
 <TextBlock Text="Firewall rule attribution is unavailable; counters above are reported by the node."/>
 </StackPanel>
</UserControl>
