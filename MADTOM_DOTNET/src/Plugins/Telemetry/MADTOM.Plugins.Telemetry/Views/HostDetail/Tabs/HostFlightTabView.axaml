<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:radar="using:MadTOM.Controls.Radar"
             xmlns:models="using:MadTOM.Models"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="550"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostFlightTabView"
             x:DataType="vm:HostFlightTabViewModel">

    <Grid ColumnDefinitions="*,*" Margin="0,4">
        
        <!-- Left Column: Interface Sockets & Queues -->
        <Border Grid.Column="0"
                Background="#070A12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="0,0,8,0">
            <StackPanel Spacing="14">
                <StackPanel Spacing="2">
                    <TextBlock Text="{loc:Loc tabFlight}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Kernel ring buffer queues &amp; TWAMP probe vector status"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <!-- eth0 Socket -->
                <Border Background="#090F1C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="eth0 (Primary 100GbE QSFP28)" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="UP / MTU 9000" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource HealthyBrush}"/>
                        </Grid>
                        <TextBlock Text="TX: 24.8 Gbps | RX: 18.2 Gbps | Ring-Buffer: 4096/4096" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                        <ProgressBar Value="48" Maximum="100" Height="6" CornerRadius="3" Foreground="{DynamicResource AccentBrush}" Background="#1E293B"/>
                    </StackPanel>
                </Border>

                <!-- eth1 Socket -->
                <Border Background="#090F1C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="eth1 (Storage Sync NVMe-oF)" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource IndigoBrush}"/>
                            <TextBlock Grid.Column="1" Text="UP / MTU 9000" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource HealthyBrush}"/>
                        </Grid>
                        <TextBlock Text="TX: 52.1 Gbps | RX: 49.6 Gbps | RoCEv2 Enabled" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                        <ProgressBar Value="72" Maximum="100" Height="6" CornerRadius="3" Foreground="{DynamicResource IndigoBrush}" Background="#1E293B"/>
                    </StackPanel>
                </Border>

                <!-- Path Asymmetry & DSCP -->
                <Border Background="#090F1C" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                    <StackPanel Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="{loc:Loc asymmetry}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource WarningBrush}"/>
                            <TextBlock Grid.Column="1" Text="DSCP 46 (EF)" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                        <TextBlock Text="Upstream Bufferbloat: 0.14ms | Downstream Peering Delay: 1.14ms" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </Border>

        <!-- Right Column: NFLOG Drop Radar -->
        <Border Grid.Column="1"
                Background="#070A12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                Margin="8,0,0,0">
            <StackPanel Spacing="14">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="{loc:Loc nflogRadar}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="#4C0519" CornerRadius="4" Padding="5,1">
                                <TextBlock Text="Group 100 Tap" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" Foreground="{DynamicResource CriticalBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Netfilter packet drop correlation with TWAMP transit jitter"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding DropRate}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource CriticalBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Grid ColumnDefinitions="200,*">
                    <!-- Polar Radar Sweep -->
                    <Border Grid.Column="0" Width="200" Height="200" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <radar:PolarDropRadarControl Width="200" Height="200"/>
                    </Border>

                    <!-- Drop Rules Table -->
                    <Border Grid.Column="1"
                            Background="#060A14"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Margin="12,0,0,0"
                            Padding="8">
                        <StackPanel>
                            <!-- Header -->
                            <Grid ColumnDefinitions="*,*,*" Margin="0,0,0,6">
                                <TextBlock Grid.Column="0" Text="RULE" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="1" Text="SOURCE IP" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Grid.Column="2" Text="PROTO" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Grid>
                            <!-- Items -->
                            <ItemsControl ItemsSource="{Binding DropRules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:DropRuleModel">
                                        <Grid ColumnDefinitions="*,*,*" Margin="0,4">
                                            <TextBlock Grid.Column="0" Text="{Binding Rule}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CriticalBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Ip}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding Proto}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </Grid>

            </StackPanel>
        </Border>

    </Grid>
</UserControl>

