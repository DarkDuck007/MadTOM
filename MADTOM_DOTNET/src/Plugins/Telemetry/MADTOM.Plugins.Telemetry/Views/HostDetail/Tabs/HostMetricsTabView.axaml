<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:models="using:MadTOM.Models"
             xmlns:charts="using:MadTOM.Controls.Charts"
             xmlns:core="using:MadTOM.Controls.CoreMatrix"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostMetricsTabView"
             x:DataType="vm:HostMetricsTabViewModel">

    <UserControl.Styles>
        <Style Selector="Button.scope-btn">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource DarkBaseBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.scope-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
        </Style>
        <Style Selector="Button.scope-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

        <!-- Scope & Time Toolbar -->
        <Border Background="{DynamicResource DarkBaseBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Scopes -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Scope:"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <Button Content="1m" Command="{Binding SetScopeCommand}" CommandParameter="1m"
                            Classes="scope-btn" Classes.active="{Binding IsScope1m}"/>
                    <Button Content="5m" Command="{Binding SetScopeCommand}" CommandParameter="5m"
                            Classes="scope-btn" Classes.active="{Binding IsScope5m}"/>
                    <Button Content="30m" Command="{Binding SetScopeCommand}" CommandParameter="30m"
                            Classes="scope-btn" Classes.active="{Binding IsScope30m}"/>
                    <Button Content="2h" Command="{Binding SetScopeCommand}" CommandParameter="2h"
                            Classes="scope-btn" Classes.active="{Binding IsScope2h}"/>
                    <Button Content="24h" Command="{Binding SetScopeCommand}" CommandParameter="24h"
                            Classes="scope-btn" Classes.active="{Binding IsScope24h}"/>
                    <Button Content="Custom" Command="{Binding SetScopeCommand}" CommandParameter="custom"
                            Classes="scope-btn" Classes.active="{Binding IsScopeCustom}"/>
                </StackPanel>

                <!-- Live Stream Active Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentTextBrush}"/>
                    <TextBlock Text="Historical telemetry"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding ScopeError}" Foreground="{DynamicResource WarningBrush}"/>
        <ItemsControl ItemsSource="{Binding Graphs}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MetricGraphViewModel">
                    <Border IsVisible="{Binding IsVisible}" Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="16" Margin="0,0,0,12"
                            BoxShadow="0 4 16 #20000000">
                        <StackPanel Spacing="10">
                            <Grid ColumnDefinitions="Auto,*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontWeight="Bold"
                                               FontSize="13"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    <Border IsVisible="{Binding IsMerged}"
                                            Background="{DynamicResource IndigoSubtleBrush}"
                                            BorderBrush="{DynamicResource IndigoBrush}"
                                            BorderThickness="1"
                                            CornerRadius="4"
                                            Padding="6,1"
                                            VerticalAlignment="Center">
                                        <TextBlock Text="Merged Series"
                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                   FontSize="9"
                                                   FontWeight="Bold"
                                                   Foreground="{DynamicResource IndigoBrush}"/>
                                    </Border>
                                </StackPanel>
                                <TextBlock Grid.Column="1"
                                           Text="{Binding Status}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Center"
                                           Margin="0,0,12,0"/>
                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6">
                                    <Button Content="Split"
                                            IsVisible="{Binding IsMerged}"
                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).SplitGraphCommand}"
                                            CommandParameter="{Binding}"
                                            Background="{DynamicResource DarkBaseBrush}"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            FontSize="10"
                                            Padding="8,3"
                                            CornerRadius="4"
                                            Cursor="Hand"/>
                                    <Button Content="✕"
                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).RemoveGraphCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="12"
                                            Padding="6,2"
                                            Cursor="Hand"
                                            ToolTip.Tip="Remove Graph"/>
                                </StackPanel>
                            </Grid>
                            <charts:MetricHistoryChartControl SeriesList="{Binding Series}"
                                                              Timestamps="{Binding Timestamps}"
                                                              WindowStart="{Binding WindowStart}"
                                                              WindowEnd="{Binding WindowEnd}"
                                                              Values="{Binding Values}"
                                                              Labels="{Binding Labels}"
                                                              Height="190"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Full Viewport Width Processor Matrix -->
        <Border IsVisible="{Binding ViewCoreMatrix}" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                BoxShadow="0 4 16 #20000000">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Loc coreMatrixTitle}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Per-thread CPU utilization"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ThreadCount, StringFormat={}{0} Threads}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="175"
                        Padding="4">
                    <core:DetailedCoreMatrixControl IsAggregatedMode="{Binding IsAggregatedMode}"
                                                    ThreadCount="{Binding ThreadCount}"
                                                    CoreLoads="{Binding CoreLoads}"
                                                    ClusterNodes="{Binding ClusterNodes}"
                                                    TargetHostId="{Binding TargetHostId}"/>
                </Border>
            </StackPanel>
        </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- Custom Observation Window Modal Overlay -->
        <Border Background="#B3000000"
                IsVisible="{Binding IsCustomScopeModalOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 #80000000">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Custom Time Window"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Specify start and end telemetry capture bounds"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CancelCustomScopeCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Cursor="Hand"
                                FontSize="14"
                                Padding="6,2"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                    <!-- Start Window -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="START DATE &amp; TIME"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                        <Grid ColumnDefinitions="*,*">
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding CustomStartDate, Mode=TwoWay}"
                                        Margin="0,0,4,0"/>
                            <TimePicker Grid.Column="1"
                                        SelectedTime="{Binding CustomStartTime, Mode=TwoWay}"
                                        Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- End Window -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="END DATE &amp; TIME"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   Foreground="{DynamicResource IndigoBrush}"/>
                        <Grid ColumnDefinitions="*,*">
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding CustomEndDate, Mode=TwoWay}"
                                        Margin="0,0,4,0"/>
                            <TimePicker Grid.Column="1"
                                        SelectedTime="{Binding CustomEndTime, Mode=TwoWay}"
                                        Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Content="Cancel"
                                Command="{Binding CancelCustomScopeCommand}"
                                Background="{DynamicResource DarkBaseBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,8"
                                Margin="0,0,6,0"
                                CornerRadius="6"
                                Cursor="Hand"/>
                        <Button Grid.Column="1"
                                Content="Apply Window"
                                Command="{Binding ApplyCustomScopeCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,8"
                                Margin="6,0,0,0"
                                CornerRadius="6"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>

        <!-- Graph Customization Modal Overlay -->
        <Border Background="#CC000000"
                IsVisible="{Binding IsCustomizationModalOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Width="680"
                    MaxHeight="720"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 #80000000">
                <Grid RowDefinitions="Auto,Auto,*,Auto">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Customize Graphs &amp; Telemetry"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Add metrics, merge charts into multi-series plots, and customize line colors"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CloseCustomizationModalCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Cursor="Hand"
                                FontSize="14"
                                Padding="6,2"/>
                    </Grid>

                    <!-- Add Graph & Presets Bar -->
                    <Border Grid.Row="1" Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,16">
                        <StackPanel Spacing="10">
                            <!-- Add Metric Row -->
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="Add Metric:"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center"/>
                                    <ComboBox ItemsSource="{Binding AvailableMetrics}"
                                              SelectedItem="{Binding SelectedMetric}"
                                              Width="240"
                                              Background="{DynamicResource CardBgBrush}"
                                              Foreground="{DynamicResource TextPrimaryBrush}"
                                              BorderBrush="{DynamicResource BorderBrush}"
                                              FontSize="11"/>
                                    <Button Content="+ Add Graph"
                                            Command="{Binding AddGraphCommand}"
                                            Background="{DynamicResource AccentBrush}"
                                            Foreground="White"
                                            FontWeight="Bold"
                                            FontSize="11"
                                            Padding="12,5"
                                            CornerRadius="4"
                                            Cursor="Hand"/>
                                </StackPanel>
                            </Grid>

                            <!-- Quick Presets Row -->
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Quick Merges:"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           Foreground="{DynamicResource TextMutedBrush}"
                                           VerticalAlignment="Center"/>
                                <Button Content="Merge CPU (Total/User/Sys/IO)"
                                        Command="{Binding QuickMergeCpuCommand}"
                                        Background="{DynamicResource CardBgBrush}"
                                        Foreground="{DynamicResource AccentTextBrush}"
                                        FontSize="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        Cursor="Hand"/>
                                <Button Content="Merge Memory (Used/Avail)"
                                        Command="{Binding QuickMergeMemoryCommand}"
                                        Background="{DynamicResource CardBgBrush}"
                                        Foreground="{DynamicResource HealthyBrush}"
                                        FontSize="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        Cursor="Hand"/>
                                <Button Content="Merge TWAMP (RTT/Up/Down)"
                                        Command="{Binding QuickMergeTwampCommand}"
                                        Background="{DynamicResource CardBgBrush}"
                                        Foreground="{DynamicResource PurpleBrush}"
                                        FontSize="10"
                                        Padding="8,4"
                                        CornerRadius="4"
                                        Cursor="Hand"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Active Graphs List -->
                    <ScrollViewer Grid.Row="2" MaxHeight="380" VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Graphs}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:MetricGraphViewModel">
                                    <Border Background="{DynamicResource DarkBaseBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="8"
                                            Padding="12"
                                            Margin="0,0,0,10">
                                        <StackPanel Spacing="8">
                                            <!-- Graph header bar -->
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Title}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontWeight="Bold"
                                                               FontSize="12"
                                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                    <Border IsVisible="{Binding IsMerged}"
                                                            Background="{DynamicResource IndigoSubtleBrush}"
                                                            BorderBrush="{DynamicResource IndigoBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Padding="4,1">
                                                        <TextBlock Text="Merged"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontSize="9"
                                                                   Foreground="{DynamicResource IndigoBrush}"/>
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                                    <Button Content="Merge with Next"
                                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).MergeWithNextCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource CardBgBrush}"
                                                            Foreground="{DynamicResource AccentTextBrush}"
                                                            FontSize="10"
                                                            Padding="8,3"
                                                            CornerRadius="4"
                                                            Cursor="Hand"/>
                                                    <Button Content="Split"
                                                            IsVisible="{Binding IsMerged}"
                                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).SplitGraphCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource CardBgBrush}"
                                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                                            FontSize="10"
                                                            Padding="8,3"
                                                            CornerRadius="4"
                                                            Cursor="Hand"/>
                                                    <Button Content="Remove"
                                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).RemoveGraphCommand}"
                                                            CommandParameter="{Binding}"
                                                            Background="{DynamicResource CriticalSubtleBrush}"
                                                            Foreground="{DynamicResource CriticalBrush}"
                                                            FontSize="10"
                                                            Padding="8,3"
                                                            CornerRadius="4"
                                                            Cursor="Hand"/>
                                                </StackPanel>
                                            </Grid>

                                            <!-- Series in this graph -->
                                            <ItemsControl ItemsSource="{Binding Series}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="models:ChartSeriesModel">
                                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="8,6" Margin="0,0,0,4">
                                                            <Grid ColumnDefinitions="Auto,*,Auto,Auto">
                                                                <!-- Color Preview Dot -->
                                                                <Ellipse Width="10" Height="10" Fill="{Binding SolidBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>

                                                                <!-- Metric Label -->
                                                                <TextBlock Grid.Column="1"
                                                                           Text="{Binding Metric}"
                                                                           FontFamily="{StaticResource MonoFontFamily}"
                                                                           FontSize="11"
                                                                           Foreground="{DynamicResource TextPrimaryBrush}"
                                                                           VerticalAlignment="Center"/>

                                                                <!-- Color Palette Swatches -->
                                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="0,0,10,0">
                                                                    <Button Background="#06B6D4" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#06B6D4" ToolTip.Tip="Cyan"/>
                                                                    <Button Background="#10B981" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#10B981" ToolTip.Tip="Emerald"/>
                                                                    <Button Background="#3B82F6" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#3B82F6" ToolTip.Tip="Blue"/>
                                                                    <Button Background="#8B5CF6" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#8B5CF6" ToolTip.Tip="Purple"/>
                                                                    <Button Background="#EC4899" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#EC4899" ToolTip.Tip="Pink"/>
                                                                    <Button Background="#F59E0B" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#F59E0B" ToolTip.Tip="Amber"/>
                                                                    <Button Background="#F97316" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#F97316" ToolTip.Tip="Orange"/>
                                                                    <Button Background="#EF4444" Width="14" Height="14" CornerRadius="7" Padding="0" BorderThickness="0" Cursor="Hand" Command="{Binding ChangeColorCommand}" CommandParameter="#EF4444" ToolTip.Tip="Red"/>
                                                                </StackPanel>

                                                                <!-- Remove Series Button (for merged graphs) -->
                                                                <Button Grid.Column="3"
                                                                        Content="✕"
                                                                        Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).RemoveSeriesCommand}"
                                                                        CommandParameter="{Binding}"
                                                                        Background="Transparent"
                                                                        Foreground="{DynamicResource TextMutedBrush}"
                                                                        FontSize="10"
                                                                        Padding="4,2"
                                                                        Cursor="Hand"
                                                                        ToolTip.Tip="Remove Series"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!-- Footer -->
                    <Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,16,0,0">
                        <Button Grid.Column="0"
                                Content="Reset Defaults"
                                Command="{Binding ResetToDefaultGraphsCommand}"
                                Background="{DynamicResource DarkBaseBrush}"
                                Foreground="{DynamicResource TextMutedBrush}"
                                FontSize="11"
                                Padding="12,6"
                                CornerRadius="6"
                                Cursor="Hand"/>
                        <Button Grid.Column="2"
                                Content="Done"
                                Command="{Binding CloseCustomizationModalCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                FontWeight="Bold"
                                FontSize="11"
                                Padding="20,6"
                                CornerRadius="6"
                                Cursor="Hand"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

