<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:models="using:MadTOM.Models"
             xmlns:charts="using:MadTOM.Controls.Charts"
             xmlns:core="using:MadTOM.Controls.CoreMatrix"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostMetricsTabView"
             x:DataType="vm:HostMetricsTabViewModel">

    <UserControl.Styles>
        <Style Selector="Button.scope-btn">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="{DynamicResource DarkBaseBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.scope-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
        </Style>
        <Style Selector="Button.scope-btn.active">
            <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <Grid>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="16">

        <!-- Scope & Time Toolbar -->
        <Border Background="{DynamicResource DarkBaseBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Scopes -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Scope:"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <Button Content="1m" Command="{Binding SetScopeCommand}" CommandParameter="1m"
                            Classes="scope-btn" Classes.active="{Binding IsScope1m}"/>
                    <Button Content="5m" Command="{Binding SetScopeCommand}" CommandParameter="5m"
                            Classes="scope-btn" Classes.active="{Binding IsScope5m}"/>
                    <Button Content="30m" Command="{Binding SetScopeCommand}" CommandParameter="30m"
                            Classes="scope-btn" Classes.active="{Binding IsScope30m}"/>
                    <Button Content="2h" Command="{Binding SetScopeCommand}" CommandParameter="2h"
                            Classes="scope-btn" Classes.active="{Binding IsScope2h}"/>
                    <Button Content="6h" Command="{Binding SetScopeCommand}" CommandParameter="6h"
                            Classes="scope-btn" Classes.active="{Binding IsScope6h}"/>
                    <Button Content="12h" Command="{Binding SetScopeCommand}" CommandParameter="12h"
                            Classes="scope-btn" Classes.active="{Binding IsScope12h}"/>
                    <Button Content="24h" Command="{Binding SetScopeCommand}" CommandParameter="24h"
                            Classes="scope-btn" Classes.active="{Binding IsScope24h}"/>
                    <Button Content="Custom" Command="{Binding SetScopeCommand}" CommandParameter="custom"
                            Classes="scope-btn" Classes.active="{Binding IsScopeCustom}"/>
                </StackPanel>

                <!-- Actions & Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentTextBrush}"/>
                        <TextBlock Text="Historical telemetry"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextMutedBrush}"/>
                    </StackPanel>

                    <Button Content="⚙ Customize Graphs &amp; Telemetry"
                            Command="{Binding OpenCustomizationModalCommand}"
                            Background="{DynamicResource CardBgBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            Foreground="{DynamicResource TextPrimaryBrush}"
                            FontSize="11"
                            Padding="10,5"
                            CornerRadius="6"
                            Cursor="Hand"
                            ToolTip.Tip="Configure layout, side-by-side rows, metrics, and presets"/>
                </StackPanel>
            </Grid>
        </Border>

        <TextBlock Text="{Binding ScopeError}" Foreground="{DynamicResource WarningBrush}"/>

        <!-- Graph Groups (Rows of Side-by-Side Graphs) -->
        <ItemsControl ItemsSource="{Binding Groups}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:MetricGraphGroupViewModel">
                    <Border Margin="0,0,0,8">
                        <StackPanel Spacing="6">
                            <!-- Optional Group / Row Controls Header -->
                            <Grid ColumnDefinitions="*,Auto" Margin="4,0,4,2">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               IsVisible="{Binding Title, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontWeight="Bold"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                    <TextBlock Text="{Binding GraphCount, StringFormat={}({0} side-by-side)}"
                                               IsVisible="{Binding HasMultipleGraphs}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="10"
                                               Foreground="{DynamicResource TextMutedBrush}"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4">
                                    <Button Content="▲ Row Up"
                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).MoveGroupUpCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="10"
                                            Padding="4,2"
                                            Cursor="Hand"
                                            ToolTip.Tip="Move this entire row up"/>
                                    <Button Content="▼ Row Down"
                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).MoveGroupDownCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextMutedBrush}"
                                            FontSize="10"
                                            Padding="4,2"
                                            Cursor="Hand"
                                            ToolTip.Tip="Move this entire row down"/>
                                    <Button Content="Combine Row ↓"
                                            Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).CombineGroupWithNextCommand}"
                                            CommandParameter="{Binding}"
                                            Background="Transparent"
                                            Foreground="{DynamicResource TextSecondaryBrush}"
                                            FontSize="10"
                                            Padding="6,2"
                                            Cursor="Hand"
                                            ToolTip.Tip="Combine this row with the row below into side-by-side graphs"/>
                                </StackPanel>
                            </Grid>

                            <!-- Horizontal Row of Graphs (1 to N side-by-side) -->
                            <ItemsControl ItemsSource="{Binding Graphs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Rows="1"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:MetricGraphViewModel">
                                        <Border IsVisible="{Binding IsVisible}"
                                                Background="{DynamicResource CardBgBrush}"
                                                BorderBrush="{DynamicResource BorderBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="14"
                                                Margin="4,0,4,8"
                                                BoxShadow="0 4 16 #20000000">
                                            <StackPanel Spacing="8">
                                                <!-- Graph Card Header -->
                                                <Grid ColumnDefinitions="Auto,*,Auto">
                                                    <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Title}"
                                                                   FontFamily="{StaticResource MonoFontFamily}"
                                                                   FontWeight="Bold"
                                                                   FontSize="12"
                                                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                        <Border IsVisible="{Binding IsMerged}"
                                                                Background="{DynamicResource IndigoSubtleBrush}"
                                                                BorderBrush="{DynamicResource IndigoBrush}"
                                                                BorderThickness="1"
                                                                CornerRadius="4"
                                                                Padding="4,1"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="Merged"
                                                                       FontFamily="{StaticResource MonoFontFamily}"
                                                                       FontSize="8"
                                                                       FontWeight="Bold"
                                                                       Foreground="{DynamicResource IndigoBrush}"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding Status}"
                                                               FontFamily="{StaticResource MonoFontFamily}"
                                                               FontSize="9"
                                                               Foreground="{DynamicResource TextMutedBrush}"
                                                               HorizontalAlignment="Right"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,8,0"/>

                                                    <!-- Reordering & Action Controls -->
                                                    <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="3">
                                                        <Button Content="◀"
                                                                Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).MoveGraphLeftCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource DarkBaseBrush}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                FontSize="10"
                                                                Padding="5,2"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Move left in this row"/>
                                                        <Button Content="▶"
                                                                Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).MoveGraphRightCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource DarkBaseBrush}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                FontSize="10"
                                                                Padding="5,2"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Move right in this row"/>
                                                        <Button Content="▲"
                                                                Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).MoveGraphUpCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource DarkBaseBrush}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                FontSize="10"
                                                                Padding="5,2"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Move to row above"/>
                                                        <Button Content="▼"
                                                                Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).MoveGraphDownCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource DarkBaseBrush}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                FontSize="10"
                                                                Padding="5,2"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Move to row below"/>
                                                        <Button Content="⤹ Row"
                                                                Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).SeparateGraphToNewRowCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource DarkBaseBrush}"
                                                                Foreground="{DynamicResource TextSecondaryBrush}"
                                                                FontSize="9"
                                                                Padding="5,2"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Separate into its own row"/>
                                                         <Button Content="Split"
                                                                IsVisible="{Binding IsMerged}"
                                                                Command="{Binding $parent[UserControl].((vm:HostMetricsTabViewModel)DataContext).SplitGraphCommand}"
                                                                CommandParameter="{Binding}"
                                                                Background="{DynamicResource DarkBaseBrush}"
                                                                Foreground="{DynamicResource AccentTextBrush}"
                                                                FontSize="9"
                                                                Padding="6,2"
                                                                CornerRadius="3"
                                                                Cursor="Hand"
                                                                ToolTip.Tip="Split merged series into side-by-side graphs"/>
                                                    </StackPanel>
                                                </Grid>

                                                <!-- The Chart -->
                                                <charts:MetricHistoryChartControl SeriesList="{Binding Series}"
                                                                                  Timestamps="{Binding Timestamps}"
                                                                                  WindowStart="{Binding WindowStart}"
                                                                                  WindowEnd="{Binding WindowEnd}"
                                                                                  Values="{Binding Values}"
                                                                                  Labels="{Binding Labels}"
                                                                                  Height="190"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Full Viewport Width Processor Matrix -->
        <Border IsVisible="{Binding ViewCoreMatrix}" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                BoxShadow="0 4 16 #20000000">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Loc coreMatrixTitle}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Per-thread CPU utilization"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ThreadCount, StringFormat={}{0} Threads}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Background="{DynamicResource DarkBaseBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="175"
                        Padding="4">
                    <core:DetailedCoreMatrixControl IsAggregatedMode="{Binding IsAggregatedMode}"
                                                    ThreadCount="{Binding ThreadCount}"
                                                    CoreLoads="{Binding CoreLoads}"
                                                    ClusterNodes="{Binding ClusterNodes}"
                                                    TargetHostId="{Binding TargetHostId}"/>
                </Border>
            </StackPanel>
        </Border>

        </StackPanel>
        </ScrollViewer>

        <!-- Custom Observation Window Modal Overlay -->
        <Border Background="#B3000000"
                IsVisible="{Binding IsCustomScopeModalOpen}"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="24"
                    Width="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    BoxShadow="0 8 32 #80000000">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Custom Time Window"
                                       FontWeight="Bold"
                                       FontSize="15"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="Specify start and end telemetry capture bounds"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <Button Grid.Column="1"
                                Content="✕"
                                Command="{Binding CancelCustomScopeCommand}"
                                Background="Transparent"
                                Foreground="{DynamicResource TextMutedBrush}"
                                Cursor="Hand"
                                FontSize="14"
                                Padding="6,2"/>
                    </Grid>

                    <Separator Background="{DynamicResource BorderBrush}" Height="1"/>

                    <!-- Start Window -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="START DATE &amp; TIME"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   Foreground="{DynamicResource AccentTextBrush}"/>
                        <Grid ColumnDefinitions="*,*">
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding CustomStartDate, Mode=TwoWay}"
                                        Margin="0,0,4,0"/>
                            <TimePicker Grid.Column="1"
                                        SelectedTime="{Binding CustomStartTime, Mode=TwoWay}"
                                        Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- End Window -->
                    <StackPanel Spacing="6">
                        <TextBlock Text="END DATE &amp; TIME"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="10"
                                   Foreground="{DynamicResource IndigoBrush}"/>
                        <Grid ColumnDefinitions="*,*">
                            <DatePicker Grid.Column="0"
                                        SelectedDate="{Binding CustomEndDate, Mode=TwoWay}"
                                        Margin="0,0,4,0"/>
                            <TimePicker Grid.Column="1"
                                        SelectedTime="{Binding CustomEndTime, Mode=TwoWay}"
                                        Margin="4,0,0,0"/>
                        </Grid>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <Grid ColumnDefinitions="*,*" Margin="0,8,0,0">
                        <Button Grid.Column="0"
                                Content="Cancel"
                                Command="{Binding CancelCustomScopeCommand}"
                                Background="{DynamicResource DarkBaseBrush}"
                                Foreground="{DynamicResource TextPrimaryBrush}"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,8"
                                Margin="0,0,6,0"
                                CornerRadius="6"
                                Cursor="Hand"/>
                        <Button Grid.Column="1"
                                Content="Apply Window"
                                Command="{Binding ApplyCustomScopeCommand}"
                                Background="{DynamicResource AccentBrush}"
                                Foreground="White"
                                FontWeight="Bold"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Center"
                                Padding="12,8"
                                Margin="6,0,0,0"
                                CornerRadius="6"
                                Cursor="Hand"/>
                    </Grid>
                </StackPanel>
            </Border>
        </Border>
    </Grid>
</UserControl>
