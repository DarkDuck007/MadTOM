<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:SQUEEZE.ViewModels"
             xmlns:m="using:SQUEEZE.Models"
             xmlns:s="using:SQUEEZE.Services"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="650"
             x:Class="SQUEEZE.Views.SettingsDialog"
             x:DataType="vm:SettingsViewModel"
             Background="{DynamicResource CardBgBrush}"
             Foreground="{DynamicResource TextPrimaryBrush}"
             FontFamily="Inter, Segoe UI, sans-serif">

    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" BoxShadow="0 8 32 #80000000">
        <Grid RowDefinitions="Auto,Auto,*,Auto" Margin="12">

            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBlock Text="⚙" FontSize="16" Foreground="{DynamicResource AccentTextBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="Server connection &amp; discovery" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>
                <Button Grid.Column="1" Classes="cyber-btn" Command="{Binding CloseCommand}" Content="×" ToolTip.Tip="Close (Esc)" AutomationProperties.Name="Close connection settings" Padding="8,4" Margin="8,0,0,0" />
            </Grid>

            <!-- Status Banner -->
            <Border Grid.Row="1" Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,8">
                <Grid ColumnDefinitions="Auto,*">
                    <TextBlock Grid.Column="0" Text="STATUS: " Foreground="{DynamicResource TextMutedBrush}" FontSize="12" FontWeight="Bold" />
                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Foreground="{Binding StatusColor}" FontSize="12" FontWeight="Bold" TextWrapping="Wrap" />
                </Grid>
            </Border>

            <!-- Content Area (Manual Settings + Priority List + LAN Discovery) -->
            <ScrollViewer Grid.Row="2">
                <StackPanel Spacing="8">

                    <!-- Section: Manual Connection -->
                    <Border Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="8">
                            <TextBlock Text="MANUAL CONNECTION" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}" />

                            <StackPanel Spacing="4">
                                <TextBlock Text="SERVER URL / IP:PORT" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBox Text="{Binding ServerUrl}"
                                         PlaceholderText="http://127.0.0.1:8080"
                                         Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="12" Padding="8,6" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="AUTH TOKEN (OPTIONAL)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBox Text="{Binding AuthToken}"
                                         PasswordChar="•"
                                         PlaceholderText="Leave empty for unauthenticated LAN mode"
                                         Background="{DynamicResource CardBgBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" FontSize="12" Padding="8,6" />
                            </StackPanel>

                            <CheckBox IsChecked="{Binding AutoConnect}" Content="Auto-reconnect to available devices on startup &amp; discovery" Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12" />

                            <!-- Buttons -->
                            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Classes="cyber-btn" Command="{Binding TestConnectionCommand}" Content="✓ Test" Margin="0,0,8,4" />
                                <Button Classes="cyber-btn-start" Command="{Binding ConnectCommand}" Content="↗ Connect" Margin="0,0,0,4" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <!-- Section: Auto-Connect Priority List -->
                    <Border Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="8">
                            <StackPanel Spacing="2">
                                <TextBlock Text="AUTO-CONNECT PRIORITY LIST" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" />
                                <TextBlock Text="Previously connected devices in priority order. Auto-connect connects to any available node according to this list." Foreground="{DynamicResource TextMutedBrush}" FontSize="11" TextWrapping="Wrap" />
                            </StackPanel>

                            <!-- Priority List Items -->
                            <ItemsControl ItemsSource="{Binding AutoConnectPriorityList}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AutoConnectPriorityItemViewModel">
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="8,6" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="Auto,*,Auto">
                                                <!-- Priority Rank Badge -->
                                                <Border Grid.Column="0" Background="{DynamicResource DarkBaseBrush}" CornerRadius="3" Padding="6,2" VerticalAlignment="Center" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding PriorityRank, StringFormat='#{0}'}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" FontSize="11" />
                                                </Border>

                                                <!-- Node Info & Priority Interface Selector -->
                                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding NodeId}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="12" Margin="0,0,8,0" />
                                                        <TextBlock Text="● Available" Foreground="{DynamicResource HealthyBrush}" FontSize="11" IsVisible="{Binding IsAvailable}" VerticalAlignment="Center" />
                                                        <TextBlock Text="○ Offline" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" IsVisible="{Binding !IsAvailable}" VerticalAlignment="Center" />
                                                    </WrapPanel>

                                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                                        <TextBlock Text="Priority interface:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                        <TextBox Text="{Binding PriorityInterface}"
                                                                 FontSize="11" Padding="6,2" MinWidth="220"
                                                                 Background="{DynamicResource DarkBaseBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" />
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Action Buttons: Move Up, Move Down, Remove, Connect -->
                                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center" Margin="8,0,0,0">
                                                    <Button Classes="cyber-btn" ToolTip.Tip="Move up in priority"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MovePriorityUpCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="▲" Padding="6,3" FontSize="10" />
                                                    <Button Classes="cyber-btn" ToolTip.Tip="Move down in priority"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).MovePriorityDownCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="▼" Padding="6,3" FontSize="10" />
                                                    <Button Classes="cyber-btn" ToolTip.Tip="Remove from auto-connect"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).RemovePriorityItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="✕" Padding="6,3" FontSize="10" />
                                                    <Button Classes="cyber-btn" ToolTip.Tip="Connect directly to this node"
                                                            Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).ConnectToPriorityItemCommand}"
                                                            CommandParameter="{Binding}"
                                                            Content="↗ Connect" Padding="8,4" FontSize="11" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Section: LAN Server Discovery (Aggregated Nodes) -->
                    <Border Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="10">
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="LAN NODES (mDNS)" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource HealthyBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <TextBlock Text="• _squeeze._tcp.local" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center" />
                                </WrapPanel>
                                <Button Grid.Column="1" Classes="cyber-btn" Command="{Binding ScanNetworkCommand}" Content="⟳ Scan" FontSize="12" Padding="8,4" Margin="6,0,0,0" />
                            </Grid>

                            <!-- Aggregated Discovered Nodes List -->
                            <ItemsControl ItemsSource="{Binding DiscoveredNodes}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:DiscoveredNodeViewModel">
                                        <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <StackPanel Grid.Column="0" Spacing="4">
                                                    <WrapPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding NodeId}" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}" FontSize="12" Margin="0,0,8,0" />
                                                        <TextBlock Text="{Binding Version, StringFormat='v{0}'}" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                        <Border Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="3" Padding="4,1" IsVisible="{Binding HasMultipleInterfaces}" VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Interfaces.Count, StringFormat='{}{0} interfaces'}" Foreground="{DynamicResource AccentTextBrush}" FontSize="10" />
                                                        </Border>
                                                    </WrapPanel>

                                                    <TextBlock Text="{Binding HardwareGpu, StringFormat='Capabilities: {0}'}" Foreground="{DynamicResource AccentTextBrush}" FontSize="11" TextWrapping="Wrap" />

                                                    <!-- Interface Selector -->
                                                    <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2,0,0">
                                                        <TextBlock Text="Interface:" Foreground="{DynamicResource TextMutedBrush}" FontSize="11" VerticalAlignment="Center" />
                                                        <ComboBox ItemsSource="{Binding Interfaces}"
                                                                  SelectedItem="{Binding SelectedInterface}"
                                                                  MinWidth="180" FontSize="11" Padding="6,3">
                                                            <ComboBox.ItemTemplate>
                                                                <DataTemplate x:DataType="m:DiscoveredNodeInterface">
                                                                    <TextBlock Text="{Binding DisplayText}" FontSize="11" />
                                                                </DataTemplate>
                                                            </ComboBox.ItemTemplate>
                                                        </ComboBox>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Connect Button -->
                                                <Button Grid.Column="1" Classes="cyber-btn"
                                                        Command="{Binding $parent[ItemsControl].((vm:SettingsViewModel)DataContext).SelectAndConnectNodeCommand}"
                                                        CommandParameter="{Binding}"
                                                        Content="↗ Connect"
                                                        VerticalAlignment="Center" Margin="8,0,0,0" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                        </StackPanel>
                    </Border>

                </StackPanel>
            </ScrollViewer>

            <!-- Footer Close -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                <Button Classes="cyber-btn" Command="{Binding CloseCommand}" Content="Close" />
            </StackPanel>

        </Grid>
    </Border>
</UserControl>
