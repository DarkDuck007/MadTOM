<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SQUEEZE.ViewModels"
        xmlns:views="using:SQUEEZE.Views"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="820"
        Width="1280" Height="820"
        MinWidth="360" MinHeight="500"
        x:Class="SQUEEZE.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="SQUEEZE // Remote Media Transcoder"
        Background="{DynamicResource AppBgBrush}">

    <views:MainView />

</Window>
