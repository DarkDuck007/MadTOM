<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>true</MSBuildEnableWorkloadResolver>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <ApplicationId>com.madtom.ipcam</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="CameraForegroundService.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MADTOM.Plugins.IPCam\MADTOM.Plugins.IPCam.csproj" />
    <ProjectReference Include="..\..\..\Core\MADTOM.Protocol\MADTOM.Protocol.csproj" />
    <ProjectReference Include="..\..\..\Core\MADTOM.Identity\MADTOM.Identity.csproj" />
    <ProjectReference Include="..\..\..\Core\MADTOM.Media.Contracts\MADTOM.Media.Contracts.csproj" />
  </ItemGroup>
</Project>
