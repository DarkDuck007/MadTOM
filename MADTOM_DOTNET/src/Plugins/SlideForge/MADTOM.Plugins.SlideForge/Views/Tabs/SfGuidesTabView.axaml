<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.SlideForge.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1180" d:DesignHeight="700"
             x:Class="MADTOM.Plugins.SlideForge.Views.Tabs.SfGuidesTabView"
             x:DataType="vm:SfGuidesViewModel">

    <Grid RowDefinitions="*,Auto" Margin="16" RowSpacing="8">
        <TabControl Grid.Row="0">
            <!-- Sub-Tab 1: Guide Markdown Files -->
            <TabItem Header="Guides (*.md)" FontSize="12">
                <Grid ColumnDefinitions="260,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <!-- File List -->
                    <Border Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="GUIDE FILES" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <Button Grid.Column="1" Command="{Binding LoadCommand}" Content="Refresh" Padding="8,2" FontSize="10" IsEnabled="{Binding !IsBusy}"/>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1"
                                     ItemsSource="{Binding Files}"
                                     SelectedItem="{Binding SelectedFile, Mode=TwoWay}"
                                     SelectionChanged="OnFileSelectionChanged"
                                     Background="Transparent"
                                     BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SfGuideFile">
                                        <Grid ColumnDefinitions="*,Auto" Margin="2,3">
                                            <TextBlock Text="{Binding Path}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding SizeDisplay}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="6,0,0,0"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Monospace Editor -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding OpenPath, FallbackValue='Select a guide file'}" FontSize="12" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}"/>
                                    <Border IsVisible="{Binding IsDirty}" Background="{DynamicResource WarningBrush}" CornerRadius="4" Padding="6,1">
                                        <TextBlock Text="UNSAVED" FontSize="9" FontWeight="Bold" Foreground="White"/>
                                    </Border>
                                </StackPanel>
                                <Button Grid.Column="1"
                                        Command="{Binding SaveCommand}"
                                        Content="Save"
                                        IsEnabled="{Binding IsDirty}"
                                        Background="{DynamicResource AccentBrush}"
                                        Foreground="White"
                                        FontWeight="Bold"
                                        Padding="14,4"
                                        FontSize="11"/>
                            </Grid>
                            <TextBox Grid.Row="1"
                                     Text="{Binding EditorText, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     AcceptsTab="True"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="12"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Sub-Tab 2: Tips -->
            <TabItem Header="Tips (tips.yaml)" FontSize="12">
                <Grid ColumnDefinitions="*,360" ColumnSpacing="12" Margin="0,8,0,0">
                    <!-- Tips List -->
                    <Border Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                        <Grid RowDefinitions="Auto,*">
                            <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="10,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="TIPS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                                        <Button Command="{Binding LoadTipsCommand}" Content="Refresh" Padding="8,2" FontSize="10"/>
                                        <Button Command="{Binding NewTipFormCommand}" Content="+ New" Padding="8,2" FontSize="10"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <ListBox Grid.Row="1" ItemsSource="{Binding Tips}" SelectedItem="{Binding SelectedTip, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:SfTip">
                                        <Border Background="{DynamicResource CardBgBrush}" CornerRadius="6" Padding="8" Margin="4,2">
                                            <StackPanel Spacing="2">
                                                <Grid ColumnDefinitions="*,Auto">
                                                    <TextBlock Text="{Binding Id}" FontSize="11" FontWeight="Bold" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource AccentTextBrush}"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding Priority, StringFormat='prio {0}'}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                                </Grid>
                                                <TextBlock Text="{Binding TextEn}" FontSize="11" TextWrapping="Wrap"/>
                                                <TextBlock Text="{Binding WhenJson}" FontSize="10" FontFamily="{StaticResource MonoFontFamily}" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                                            </StackPanel>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <!-- Add/Edit Form -->
                    <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12">
                        <StackPanel Spacing="8">
                            <TextBlock Text="ADD / EDIT TIP" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBlock Text="ID" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Text="{Binding TipIdInput, Mode=TwoWay}" PlaceholderText="e.g. rtl" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"/>
                            <TextBlock Text="Priority" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <NumericUpDown Value="{Binding TipPriorityInput, Mode=TwoWay}" Minimum="0" Maximum="100" FormatString="0"/>
                            <TextBlock Text="Text (English)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Text="{Binding TipTextEnInput, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="90" FontSize="11"/>
                            <TextBlock Text="When (JSON object)" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Text="{Binding TipWhenJsonInput, Mode=TwoWay}" AcceptsReturn="True" TextWrapping="Wrap" Height="80" FontFamily="{StaticResource MonoFontFamily}" FontSize="11"/>
                            <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,6,0,0">
                                <Button Command="{Binding SaveTipFormCommand}" Content="Save Tip" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" Padding="12,5" FontSize="11"/>
                                <Button Command="{Binding DeleteSelectedTipCommand}" Content="Delete Selected" Foreground="{DynamicResource CriticalBrush}" Padding="10,5" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Sub-Tab 3: Prompt Preview -->
            <TabItem Header="Prompt Preview" FontSize="12">
                <Grid ColumnDefinitions="360,*" ColumnSpacing="12" Margin="0,8,0,0">
                    <Border Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid RowDefinitions="Auto,*,Auto" RowSpacing="8">
                            <TextBlock Text="SAMPLE SPEC JSON" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBox Grid.Row="1"
                                     Text="{Binding PreviewSpecJson, Mode=TwoWay}"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"/>
                            <Button Grid.Row="2" Command="{Binding PreviewPromptCommand}" Content="Render Prompt Preview" Background="{DynamicResource AccentBrush}" Foreground="White" FontWeight="Bold" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Padding="10,6" FontSize="11"/>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10">
                        <Grid RowDefinitions="Auto,*" RowSpacing="8">
                            <TextBlock Text="ASSEMBLED PROMPT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                            <TextBox Grid.Row="1"
                                     Text="{Binding PromptPreview, Mode=OneWay}"
                                     IsReadOnly="True"
                                     AcceptsReturn="True"
                                     TextWrapping="Wrap"
                                     FontFamily="{StaticResource MonoFontFamily}"
                                     FontSize="11"/>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <TextBlock Grid.Row="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource CriticalBrush}" FontSize="11" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
    </Grid>
</UserControl>
