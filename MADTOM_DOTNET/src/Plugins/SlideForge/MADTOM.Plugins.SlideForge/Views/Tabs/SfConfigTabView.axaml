<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.SlideForge.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="MADTOM.Plugins.SlideForge.Views.Tabs.SfConfigTabView"
             x:DataType="vm:SfConfigViewModel">

    <Grid RowDefinitions="Auto,*" Margin="16" RowSpacing="10">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="EFFECTIVE CONFIGURATION (READ-ONLY · SECRETS REDACTED)" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource CriticalBrush}" FontSize="11" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </StackPanel>
            <Button Grid.Column="1" Command="{Binding LoadCommand}" Content="Refresh Config" Padding="10,4" FontSize="11" IsEnabled="{Binding !IsBusy}"/>
        </Grid>

        <Border Grid.Row="1" Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="8">
            <TextBox Text="{Binding ConfigJson, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="{StaticResource MonoFontFamily}"
                     FontSize="12"
                     Background="Transparent"
                     BorderThickness="0"/>
        </Border>
    </Grid>
</UserControl>
