<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MADTOM.Plugins.SlideForge.ViewModels"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="680"
             x:Class="MADTOM.Plugins.SlideForge.Views.Tabs.SfUsersTabView"
             x:DataType="vm:SfUsersViewModel">

    <Grid RowDefinitions="Auto,*,Auto" Margin="16" RowSpacing="10">
        <!-- Search Toolbar -->
        <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}" PlaceholderText="Search user ID or username..." Width="240" FontSize="11"/>
                    <Button Command="{Binding LoadCommand}" Content="Search / Refresh" Padding="10,4" FontSize="11" IsEnabled="{Binding !IsBusy}"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat='{}{0} users'}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Grid.Column="1" Text="{Binding ErrorMessage}" Foreground="{DynamicResource CriticalBrush}" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>
            </Grid>
        </Border>

        <!-- Users Table -->
        <Border Grid.Row="1" Background="{DynamicResource DarkBaseBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
                <Border Grid.Row="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="12,6">
                    <Grid ColumnDefinitions="110,*,60,100,110,80,80" ColumnSpacing="8">
                        <TextBlock Text="USER ID" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="1" Text="LABEL" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="2" Text="LANG" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="3" Text="QUOTA (7D)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="4" Text="LIMIT MODE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="5" Text="JOBS (7D)" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                        <TextBlock Grid.Column="6" Text="STATUS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}"/>
                    </Grid>
                </Border>
                <ListBox Grid.Row="1" ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SfUserRow">
                            <Grid ColumnDefinitions="110,*,60,100,110,80,80" ColumnSpacing="8" Margin="2,3">
                                <TextBlock Text="{Binding UserId}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}"/>
                                <TextBlock Grid.Column="1" Text="{Binding Label}" FontSize="11" FontWeight="SemiBold"/>
                                <TextBlock Grid.Column="2" Text="{Binding Lang}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                <TextBlock Grid.Column="3" Text="{Binding QuotaText}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}"/>
                                <TextBlock Grid.Column="4" Text="{Binding OverrideBadge}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                                <TextBlock Grid.Column="5" Text="{Binding Jobs7d}" FontSize="11" FontFamily="{StaticResource MonoFontFamily}"/>
                                <TextBlock Grid.Column="6" Text="{Binding StatusText}" FontSize="10" FontWeight="Bold"/>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <!-- Selected User Actions -->
        <Border Grid.Row="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="12,8" IsEnabled="{Binding HasSelectedUser}">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="Selected User:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="{Binding SelectedUser.Label, FallbackValue='—'}" FontSize="11" FontWeight="Bold" VerticalAlignment="Center"/>
                <TextBlock Text="Weekly Limit:" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,0,0"/>
                <TextBox Text="{Binding QuotaLimitInput, Mode=TwoWay}" PlaceholderText="default" Width="90" FontSize="11"/>
                <Button Command="{Binding ApplyQuotaInputCommand}" Content="Set Quota" Padding="10,4" FontSize="11" Background="{DynamicResource AccentBrush}" Foreground="White" IsEnabled="{Binding !IsBusy}"/>
                <Button Command="{Binding ResetQuotaCommand}" Content="Reset to Default" Padding="10,4" FontSize="11" IsEnabled="{Binding !IsBusy}"/>
                <Button Command="{Binding ToggleBanSelectedCommand}" Content="Toggle Ban / Unban" Padding="10,4" FontSize="11" Foreground="{DynamicResource WarningBrush}" IsEnabled="{Binding !IsBusy}"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
