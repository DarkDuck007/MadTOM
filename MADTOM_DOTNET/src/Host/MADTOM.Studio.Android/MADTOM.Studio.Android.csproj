<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver>true</MSBuildEnableWorkloadResolver>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26</SupportedOSPlatformVersion>
    <ApplicationId>com.madtom.studio</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableSGenConcurrent>true</AndroidEnableSGenConcurrent>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidUseFastDeployment>false</AndroidUseFastDeployment>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MADTOM.Studio\MADTOM.Studio.csproj" Properties="BuildingForAndroid=true;OutputType=Library" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="$(AvaloniaVersion)" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Resources\**\*" />
  </ItemGroup>
</Project>
