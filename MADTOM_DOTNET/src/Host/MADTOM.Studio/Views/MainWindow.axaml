<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MADTOM.Console.ViewModels"
        xmlns:views="using:MADTOM.Console.Views"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MADTOM.Console.Views.MainWindow"
        x:DataType="vm:ConsoleMainViewModel"
        Title="MADTOM Studio - Operations &amp; Modules Host"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource AppBgBrush}">

    <views:MainView />

</Window>
