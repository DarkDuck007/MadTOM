<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MADTOM.Console.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MADTOM.Console.Views.MainWindow"
        x:DataType="vm:ConsoleMainViewModel"
        Title="MADTOM Studio - Operations &amp; Modules Host"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource AppBgBrush}">

    <Window.Styles>
        <Style Selector="Button.plugin-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.plugin-tab:pointerover">
            <Setter Property="Background" Value="{DynamicResource CardHoverBgBrush}" />
        </Style>
        <Style Selector="Button.plugin-tab.active">
            <Setter Property="Background" Value="{DynamicResource CardBgBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
        <Style Selector="Button.plugin-tab.placeholder">
            <Setter Property="Opacity" Value="0.4" />
        </Style>
        <Style Selector="Button.plugin-tab.placeholder:pointerover">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
    </Window.Styles>

    <LayoutTransformControl>
        <LayoutTransformControl.LayoutTransform>
            <ScaleTransform ScaleX="{Binding UiScale}" ScaleY="{Binding UiScale}" />
        </LayoutTransformControl.LayoutTransform>
        <Grid>
            <Grid RowDefinitions="Auto,*">
            
            <!-- Global Top Bar (MADTOM Studio Header) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Height="54"
                    Padding="16,0">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    
                    <!-- Left: Studio Logo / Collapse Toggle -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="{DynamicResource AccentBrush}"
                                    CornerRadius="6"
                                    Width="32" Height="32">
                                <TextBlock Text="⊞"
                                           FontSize="18"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MADTOM"
                                           FontFamily="Consolas, monospace"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           LetterSpacing="1.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="STUDIO"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2"
                                           Foreground="{DynamicResource AccentTextBrush}" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Settings Menu (Gear Icon on top left, right side of MADTOM Console logo) -->
                    <Button Grid.Column="1"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="7,5"
                            Margin="8,0,0,0"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <TextBlock Text="⚙"
                                   FontSize="15"
                                   Foreground="{DynamicResource TextSecondaryBrush}"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                        <Button.Flyout>
                            <Flyout Placement="BottomEdgeAlignedLeft"
                                    OverlayDismissEventPassThrough="False">
                                <Border Background="{DynamicResource CardBgBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Padding="14"
                                        Width="330">
                                    <StackPanel Spacing="12">
                                        <!-- Header -->
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="⚙ SETTINGS"
                                                       FontWeight="Bold"
                                                       FontSize="11"
                                                       LetterSpacing="1.2"
                                                       Foreground="{DynamicResource TextPrimaryBrush}"
                                                       VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="1"
                                                       Text="Appearance &amp; Lexicon"
                                                       FontSize="10"
                                                       Foreground="{DynamicResource TextMutedBrush}"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Separator Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,-4,0,-4" />

                                        <!-- Themes Section -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="COLOR THEME"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       LetterSpacing="1"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                            <ComboBox ItemsSource="{Binding AvailableThemes}"
                                                      SelectedItem="{Binding SelectedThemeOption, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      FontSize="11"
                                                      Background="{DynamicResource DarkBaseBrush}"
                                                      BorderBrush="{DynamicResource BorderBrush}"
                                                      CornerRadius="6"
                                                      Padding="8,5">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ThemeOption">
                                                        <Grid ColumnDefinitions="Auto,*">
                                                            <Border Grid.Column="0"
                                                                    Width="14" Height="14"
                                                                    CornerRadius="3"
                                                                    Margin="0,0,8,0"
                                                                    VerticalAlignment="Center"
                                                                    BorderBrush="{Binding PreviewAccent}"
                                                                    BorderThickness="1.5"
                                                                    Background="{Binding PreviewBg}" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding DisplayName}"
                                                                       FontSize="11"
                                                                       VerticalAlignment="Center" />
                                                        </Grid>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>

                                        <Separator Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,-4,0,-4" />

                                        <!-- Lexicon Section -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="LEXICON / TERMINOLOGY"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       LetterSpacing="1"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                            <Grid ColumnDefinitions="*,*,*" Margin="0,2">
                                                <Button Grid.Column="0"
                                                        Content="Goose"
                                                        Command="{Binding SwitchLexiconCommand}"
                                                        CommandParameter="goose"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Margin="0,0,3,0"
                                                        Padding="6,4"
                                                        Background="{DynamicResource DarkBaseBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        CornerRadius="4" />

                                                <Button Grid.Column="1"
                                                        Content="Feline"
                                                        Command="{Binding SwitchLexiconCommand}"
                                                        CommandParameter="feline"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Margin="3,0,3,0"
                                                        Padding="6,4"
                                                        Background="{DynamicResource DarkBaseBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        CornerRadius="4" />

                                                <Button Grid.Column="2"
                                                        Content="Standard"
                                                        Command="{Binding SwitchLexiconCommand}"
                                                        CommandParameter="standard"
                                                        FontSize="10"
                                                        FontWeight="SemiBold"
                                                        HorizontalAlignment="Stretch"
                                                        HorizontalContentAlignment="Center"
                                                        Margin="3,0,0,0"
                                                        Padding="6,4"
                                                        Background="{DynamicResource DarkBaseBrush}"
                                                        BorderBrush="{DynamicResource BorderBrush}"
                                                        CornerRadius="4" />
                                            </Grid>
                                        </StackPanel>

                                        <Separator Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,-4,0,-4" />

                                        <!-- UI Scaling Section -->
                                        <StackPanel Spacing="6">
                                            <Grid ColumnDefinitions="*,Auto">
                                                <TextBlock Grid.Column="0"
                                                           Text="UI SCALING"
                                                           FontSize="10"
                                                           FontWeight="Bold"
                                                           LetterSpacing="1"
                                                           Foreground="{DynamicResource TextMutedBrush}"
                                                           VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding UiScalePercent, StringFormat='{}{0}%'}"
                                                               FontSize="11"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource AccentTextBrush}"
                                                               VerticalAlignment="Center" />
                                                    <Button Content="Reset"
                                                            Command="{Binding ResetUiScaleCommand}"
                                                            FontSize="9"
                                                            Padding="6,2"
                                                            Background="Transparent"
                                                            BorderBrush="{DynamicResource BorderSubtleBrush}"
                                                            BorderThickness="1"
                                                            CornerRadius="4"
                                                            Cursor="Hand" />
                                                </StackPanel>
                                            </Grid>

                                            <Slider Minimum="10"
                                                    Maximum="1000"
                                                    Value="{Binding UiScalePercent, Mode=TwoWay}"
                                                    SmallChange="5"
                                                    LargeChange="25" />

                                            <Grid ColumnDefinitions="*,*,*,*,*" Margin="0,2">
                                                <Button Grid.Column="0" Content="50%" Command="{Binding SetUiScaleCommand}" CommandParameter="50"
                                                        FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="0,0,2,0" Padding="4,2" Background="{DynamicResource DarkBaseBrush}" CornerRadius="3" />
                                                <Button Grid.Column="1" Content="75%" Command="{Binding SetUiScaleCommand}" CommandParameter="75"
                                                        FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0" Padding="4,2" Background="{DynamicResource DarkBaseBrush}" CornerRadius="3" />
                                                <Button Grid.Column="2" Content="100%" Command="{Binding SetUiScaleCommand}" CommandParameter="100"
                                                        FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0" Padding="4,2" Background="{DynamicResource DarkBaseBrush}" CornerRadius="3" />
                                                <Button Grid.Column="3" Content="150%" Command="{Binding SetUiScaleCommand}" CommandParameter="150"
                                                        FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,2,0" Padding="4,2" Background="{DynamicResource DarkBaseBrush}" CornerRadius="3" />
                                                <Button Grid.Column="4" Content="200%" Command="{Binding SetUiScaleCommand}" CommandParameter="200"
                                                        FontSize="9" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Margin="2,0,0,0" Padding="4,2" Background="{DynamicResource DarkBaseBrush}" CornerRadius="3" />
                                            </Grid>
                                        </StackPanel>

                                        <Separator Height="1" Background="{DynamicResource BorderSubtleBrush}" Margin="0,-4,0,-4" />

                                        <!-- System Tray Section -->
                                        <StackPanel Spacing="6">
                                            <TextBlock Text="SYSTEM TRAY BEHAVIOR"
                                                       FontSize="10"
                                                       FontWeight="Bold"
                                                       LetterSpacing="1"
                                                       Foreground="{DynamicResource TextMutedBrush}" />

                                            <ComboBox ItemsSource="{Binding TrayBehaviorOptions}"
                                                      SelectedItem="{Binding SelectedTrayBehavior, Mode=TwoWay}"
                                                      HorizontalAlignment="Stretch"
                                                      FontSize="11"
                                                      Background="{DynamicResource DarkBaseBrush}"
                                                      BorderBrush="{DynamicResource BorderBrush}"
                                                      CornerRadius="6"
                                                      Padding="8,5">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:TrayBehaviorOption">
                                                        <StackPanel Spacing="1">
                                                            <TextBlock Text="{Binding DisplayName}"
                                                                       FontSize="11"
                                                                       FontWeight="SemiBold"
                                                                       Foreground="{DynamicResource TextPrimaryBrush}" />
                                                            <TextBlock Text="{Binding Description}"
                                                                       FontSize="9"
                                                                       Foreground="{DynamicResource TextMutedBrush}" />
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Flyout>
                        </Button.Flyout>
                    </Button>

                    <!-- Active Plugin Indicator Badge -->
                    <Border Grid.Column="2"
                            Background="{DynamicResource DarkBaseBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPlugin.IconGlyph}" FontSize="13" />
                            <TextBlock Text="{Binding SelectedPlugin.DisplayName}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="{DynamicResource AccentTextBrush}" />
                            <TextBlock Text="• RUNNING"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource HealthyBrush}"
                                       IsVisible="{Binding !SelectedPlugin.IsPlaceholder}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="• COMING SOON"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="{DynamicResource WarningBrush}"
                                       IsVisible="{Binding SelectedPlugin.IsPlaceholder}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Main Shell Body: Left Plugin Sidebar + Active Viewport Slot -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,4,*">
                
                <!-- Left Navigation Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Width="{Binding SidebarWidth}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                        </Transitions>
                    </Border.Transitions>

                    <Grid RowDefinitions="Auto,*,Auto" Margin="8,12">
                        
                        <!-- Header Label -->
                        <TextBlock Grid.Row="0"
                                   Text="MODULES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="8,0,0,8"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />

                        <!-- Plugin List -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginItemViewModel">
                                    <Button Command="{Binding $parent[Window].((vm:ConsoleMainViewModel)DataContext).SelectPluginCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="plugin-tab"
                                            Classes.active="{Binding IsSelected}"
                                            Classes.placeholder="{Binding IsPlaceholder}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding IconGlyph}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="2,0,8,0" />
                                            
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding !$parent[Window].((vm:ConsoleMainViewModel)DataContext).IsSidebarCollapsed}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Console Info -->
                        <Border Grid.Row="2"
                                Background="{DynamicResource DarkBaseBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                IsVisible="{Binding !IsSidebarCollapsed}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="MADTOM STUDIO v1.0"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="In-Process Visual ALC Host"
                                           FontSize="8"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Draggable Sidebar Splitter -->
                <GridSplitter Grid.Column="1"
                              Width="4"
                              ResizeDirection="Columns"
                              Background="Transparent"
                              DragDelta="OnSidebarSplitterDragDelta"
                              Cursor="SizeWestEast" />

                <!-- Active Module Viewport Stage -->
                <ContentControl Grid.Column="2"
                                Content="{Binding CurrentPluginView}"
                                Background="{DynamicResource AppBgBrush}" />
            </Grid>
        </Grid>

        <!-- Global Toast Notification Overlay -->
        <Border IsVisible="{Binding IsToastVisible}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="24"
                Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource AccentBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                BoxShadow="0 8 24 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding ToastIcon}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastMessage}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>
    </LayoutTransformControl>

</Window>

