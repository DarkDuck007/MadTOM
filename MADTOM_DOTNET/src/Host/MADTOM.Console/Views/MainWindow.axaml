<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:MADTOM.Console.ViewModels"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MADTOM.Console.Views.MainWindow"
        x:DataType="vm:ConsoleMainViewModel"
        Title="MADTOM Console - Operations &amp; Modules Host"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource AppBgBrush}">

    <Window.Styles>
        <Style Selector="Button.plugin-tab">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>
        <Style Selector="Button.plugin-tab:pointerover">
            <Setter Property="Background" Value="#1E293B" />
        </Style>
        <Style Selector="Button.plugin-tab.active">
            <Setter Property="Background" Value="#162E3B" />
            <Setter Property="BorderBrush" Value="#0E7490" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Grid>
        <Grid RowDefinitions="Auto,*">
            
            <!-- Global Top Bar (MADTOM Console Header) -->
            <Border Grid.Row="0"
                    Background="{DynamicResource HeaderBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="0,0,0,1"
                    Height="54"
                    Padding="16,0">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                    
                    <!-- Console Logo & Sidebar Toggle Button -->
                    <Button Grid.Column="0"
                            Command="{Binding ToggleSidebarCommand}"
                            Background="Transparent"
                            BorderThickness="0"
                            Padding="6,4"
                            Cursor="Hand"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <Border Background="#0E7490"
                                    CornerRadius="6"
                                    Width="32" Height="32">
                                <TextBlock Text="⊞"
                                           FontSize="18"
                                           Foreground="#FFFFFF"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="MADTOM"
                                           FontFamily="Consolas, monospace"
                                           FontSize="13"
                                           FontWeight="Bold"
                                           LetterSpacing="1.5"
                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                <TextBlock Text="CONSOLE"
                                           FontSize="10"
                                           FontWeight="SemiBold"
                                           LetterSpacing="2"
                                           Foreground="#38BDF8" />
                            </StackPanel>
                        </StackPanel>
                    </Button>

                    <!-- Active Plugin Indicator Badge -->
                    <Border Grid.Column="1"
                            Background="#0F172A"
                            BorderBrush="#1E293B"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10,4"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedPlugin.IconGlyph}" FontSize="13" />
                            <TextBlock Text="{Binding SelectedPlugin.DisplayName}"
                                       FontSize="11"
                                       FontWeight="SemiBold"
                                       Foreground="#38BDF8" />
                            <TextBlock Text="• RUNNING"
                                       FontSize="9"
                                       FontWeight="Bold"
                                       Foreground="#22C55E"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Right Controls: Global Language Switcher -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                        <TextBlock Text="LEXICON:"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   LetterSpacing="1"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   VerticalAlignment="Center" />
                        
                        <Button Content="Goose"
                                Command="{Binding SwitchLexiconCommand}"
                                CommandParameter="goose"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Padding="8,4"
                                Background="#0F172A"
                                BorderBrush="#1E293B"
                                CornerRadius="4" />
                        
                        <Button Content="Feline"
                                Command="{Binding SwitchLexiconCommand}"
                                CommandParameter="feline"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Padding="8,4"
                                Background="#0F172A"
                                BorderBrush="#1E293B"
                                CornerRadius="4" />
                        
                        <Button Content="Standard"
                                Command="{Binding SwitchLexiconCommand}"
                                CommandParameter="standard"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Padding="8,4"
                                Background="#0F172A"
                                BorderBrush="#1E293B"
                                CornerRadius="4" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Main Shell Body: Left Plugin Sidebar + Active Viewport Slot -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                
                <!-- Left Navigation Sidebar -->
                <Border Grid.Column="0"
                        Background="{DynamicResource SidebarBgBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="0,0,1,0"
                        Width="{Binding SidebarWidth}">
                    <Border.Transitions>
                        <Transitions>
                            <DoubleTransition Property="Width" Duration="0:0:0.2" Easing="CubicEaseOut" />
                        </Transitions>
                    </Border.Transitions>

                    <Grid RowDefinitions="Auto,*,Auto" Margin="8,12">
                        
                        <!-- Header Label -->
                        <TextBlock Grid.Row="0"
                                   Text="MODULES"
                                   FontSize="10"
                                   FontWeight="Bold"
                                   LetterSpacing="1.2"
                                   Foreground="{DynamicResource TextMutedBrush}"
                                   Margin="8,0,0,8"
                                   IsVisible="{Binding !IsSidebarCollapsed}" />

                        <!-- Plugin List -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding Plugins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PluginItemViewModel">
                                    <Button Command="{Binding $parent[Window].((vm:ConsoleMainViewModel)DataContext).SelectPluginCommand}"
                                            CommandParameter="{Binding}"
                                            Classes="plugin-tab"
                                            Classes.active="{Binding IsSelected}"
                                            HorizontalAlignment="Stretch"
                                            Margin="0,2">
                                        <Grid ColumnDefinitions="Auto,*">
                                            <TextBlock Grid.Column="0"
                                                       Text="{Binding IconGlyph}"
                                                       FontSize="16"
                                                       VerticalAlignment="Center"
                                                       Margin="2,0,8,0" />
                                            
                                            <StackPanel Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding !$parent[Window].((vm:ConsoleMainViewModel)DataContext).IsSidebarCollapsed}">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontSize="11"
                                                           FontWeight="SemiBold"
                                                           Foreground="{DynamicResource TextPrimaryBrush}" />
                                                <TextBlock Text="{Binding Category}"
                                                           FontSize="9"
                                                           Foreground="{DynamicResource TextMutedBrush}" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- Bottom Console Info -->
                        <Border Grid.Row="2"
                                Background="#0B1220"
                                BorderBrush="#1E293B"
                                BorderThickness="1"
                                CornerRadius="6"
                                Padding="8"
                                IsVisible="{Binding !IsSidebarCollapsed}">
                            <StackPanel Spacing="2">
                                <TextBlock Text="MADTOM CONSOLE v1.0"
                                           FontSize="9"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource TextMutedBrush}" />
                                <TextBlock Text="In-Process Visual ALC Host"
                                           FontSize="8"
                                           Foreground="#64748B" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- Active Module Viewport Stage -->
                <ContentControl Grid.Column="1"
                                Content="{Binding CurrentPluginView}"
                                Background="{DynamicResource AppBgBrush}" />
            </Grid>
        </Grid>

        <!-- Global Toast Notification Overlay -->
        <Border IsVisible="{Binding IsToastVisible}"
                HorizontalAlignment="Right"
                VerticalAlignment="Bottom"
                Margin="24"
                Background="#0F172A"
                BorderBrush="#0E7490"
                BorderThickness="1"
                CornerRadius="8"
                Padding="16,12"
                BoxShadow="0 8 24 0 #40000000">
            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                <TextBlock Text="{Binding ToastIcon}" FontSize="16" VerticalAlignment="Center" />
                <TextBlock Text="{Binding ToastMessage}"
                           FontSize="12"
                           FontWeight="Medium"
                           Foreground="{DynamicResource TextPrimaryBrush}"
                           VerticalAlignment="Center" />
            </StackPanel>
        </Border>
    </Grid>

</Window>

