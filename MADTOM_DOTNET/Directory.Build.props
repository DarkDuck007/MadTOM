<Project>
  <PropertyGroup>
    <MSBuildEnableWorkloadResolver Condition="'$(TargetFramework)' != 'net10.0-android'">false</MSBuildEnableWorkloadResolver>
    <UsedAvaloniaProducts></UsedAvaloniaProducts>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <AvaloniaStatsTaskEnabled>false</AvaloniaStatsTaskEnabled>
    <EnableAvaloniaStatsTask>false</EnableAvaloniaStatsTask>
  </PropertyGroup>
</Project>

