<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:charts="using:MadTOM.Controls.Charts"
             xmlns:core="using:MadTOM.Controls.CoreMatrix"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostMetricsTabView"
             x:DataType="vm:HostMetricsTabViewModel">

    <UserControl.Styles>
        <Style Selector="Button.scope-btn">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Background" Value="#1E293B" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
        <Style Selector="Button.scope-btn.active">
            <Setter Property="Background" Value="#0891B2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>
    </UserControl.Styles>

    <StackPanel Spacing="16">

        <!-- Scope & Time Toolbar -->
        <Border Background="#070A12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="10"
                Padding="10,8">
            <Grid ColumnDefinitions="*,Auto">
                <!-- Scopes -->
                <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock Text="Scope:"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"
                               VerticalAlignment="Center"/>

                    <Button Content="1m" Command="{Binding SetScopeCommand}" CommandParameter="1m"
                            Classes="scope-btn" Classes.active="{Binding IsScope1m}"/>
                    <Button Content="5m" Command="{Binding SetScopeCommand}" CommandParameter="5m"
                            Classes="scope-btn" Classes.active="{Binding IsScope5m}"/>
                    <Button Content="30m" Command="{Binding SetScopeCommand}" CommandParameter="30m"
                            Classes="scope-btn" Classes.active="{Binding IsScope30m}"/>
                    <Button Content="2h" Command="{Binding SetScopeCommand}" CommandParameter="2h"
                            Classes="scope-btn" Classes.active="{Binding IsScope2h}"/>
                    <Button Content="24h" Command="{Binding SetScopeCommand}" CommandParameter="24h"
                            Classes="scope-btn" Classes.active="{Binding IsScope24h}"/>
                    <Button Content="Custom" Command="{Binding SetScopeCommand}" CommandParameter="custom"
                            Classes="scope-btn" Classes.active="{Binding IsScopeCustom}"/>
                </StackPanel>

                <!-- Live Stream Active Status -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <Ellipse Width="7" Height="7" Fill="{DynamicResource AccentTextBrush}"/>
                    <TextBlock Text="Sub-millisecond TWAMP Stream Active"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontSize="11"
                               Foreground="{DynamicResource TextMutedBrush}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Directional TWAMP Chart -->
        <Border Background="#070A12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                BoxShadow="0 4 16 #20000000">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <TextBlock Text="{loc:Loc directionalTitle}"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="#1E3A8A" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="Stream = 10Hz"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="9"
                                           Foreground="{DynamicResource IndigoBrush}"/>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Forward Egress (T₂-T₁) vs Reverse Ingress (T₄-T₃) delay variations"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <!-- Chart Legend -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource AccentBrush}"/>
                            <TextBlock Text="Forward (↑)" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource IndigoBrush}"/>
                            <TextBlock Text="Reverse (↓)" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource IndigoBrush}"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <Ellipse Width="6" Height="6" Fill="{DynamicResource WarningBrush}"/>
                            <TextBlock Text="Asymmetry (Δ)" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource WarningBrush}"/>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <Border Height="200" Background="#04060B" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                    <charts:TwampTimeSeriesChartControl ForwardSeries="{Binding ForwardSeries}"
                                                        ReverseSeries="{Binding ReverseSeries}"
                                                        AsymmetrySeries="{Binding AsymmetrySeries}"
                                                        TimeLabels="{Binding TimeLabels}"/>
                </Border>
            </StackPanel>
        </Border>

        <!-- Full Viewport Width Processor Matrix -->
        <Border Background="#070A12"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16"
                BoxShadow="0 4 16 #20000000">
            <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="2">
                        <TextBlock Text="{loc:Loc coreMatrixTitle}"
                                   FontFamily="{StaticResource MonoFontFamily}"
                                   FontWeight="Bold"
                                   FontSize="13"
                                   Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Fluid raster rendering edge-to-edge without trailing gaps"
                                   FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Grid.Column="1"
                               Text="{Binding ThreadCount, StringFormat={}{0} Threads}"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="11"
                               Foreground="{DynamicResource AccentTextBrush}"
                               VerticalAlignment="Center"/>
                </Grid>

                <Border Background="#04060B"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        Height="175"
                        Padding="4">
                    <core:DetailedCoreMatrixControl IsAggregatedMode="{Binding IsAggregatedMode}"
                                                    ThreadCount="{Binding ThreadCount}"
                                                    CoreLoads="{Binding CoreLoads}"
                                                    ClusterNodes="{Binding ClusterNodes}"
                                                    TargetHostId="{Binding TargetHostId}"/>
                </Border>
            </StackPanel>
        </Border>

    </StackPanel>
</UserControl>

