<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:models="using:MadTOM.Models"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="500"
             x:Class="MadTOM.Views.HostDetail.Tabs.HostLogsTabView"
             x:DataType="vm:HostLogsTabViewModel">

    <Border Background="#070A12"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="12"
            Padding="16">
        <StackPanel Spacing="12">

            <!-- Toolbar -->
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="System Journal Stream"
                               FontFamily="{StaticResource MonoFontFamily}"
                               FontWeight="Bold"
                               FontSize="13"
                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                    <TextBlock Text="Live streaming journald ring buffer over loopback gRPC"
                               FontSize="11"
                               Foreground="{DynamicResource TextSecondaryBrush}"/>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                    <Button Content="Clear Logs"
                            Command="{Binding ClearCommand}"
                            Background="#1E293B"
                            Foreground="{DynamicResource TextSecondaryBrush}"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontSize="11"
                            Padding="10,5"
                            CornerRadius="6"/>

                    <Button Content="{Binding PauseButtonText}"
                            Command="{Binding TogglePauseCommand}"
                            Background="#D97706"
                            Foreground="White"
                            FontFamily="{StaticResource MonoFontFamily}"
                            FontWeight="Bold"
                            FontSize="11"
                            Padding="10,5"
                            CornerRadius="6"/>
                </StackPanel>
            </Grid>

            <!-- Console Log Window -->
            <Border Background="#04060B"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Height="360"
                    Padding="12">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Logs}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="models:LogEntryModel">
                                <StackPanel Orientation="Horizontal" Spacing="6" Margin="0,2">
                                    <TextBlock Text="{Binding FormattedTime, StringFormat={}[{0}]}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11"
                                               Foreground="#64748B"/>
                                    <TextBlock Text="{Binding Message}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontSize="11"
                                               Foreground="{DynamicResource TextPrimaryBrush}"/>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Border>

        </StackPanel>
    </Border>
</UserControl>

