<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:MadTOM.ViewModels"
             xmlns:radar="using:MadTOM.Controls.Radar"
             xmlns:loc="using:MadTOM.Localization"
             mc:Ignorable="d" d:DesignWidth="1100" d:DesignHeight="950"
             x:Class="MadTOM.Views.Radar.GlobalRadarView"
             x:DataType="vm:GlobalRadarViewModel">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Margin="24">

            <!-- Title & Scoped Node Toolbar -->
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Spacing="4">
                            <Border Background="#1E1B4B"
                                    BorderBrush="#4338CA"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="6,2"
                                    HorizontalAlignment="Left">
                                <TextBlock Text="{loc:Loc radarBadge}"
                                           FontFamily="{StaticResource MonoFontFamily}"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           Foreground="{DynamicResource IndigoBrush}"/>
                            </Border>

                            <TextBlock Text="{loc:Loc radarTitle}"
                                       FontWeight="ExtraBold"
                                       FontSize="20"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>

                            <TextBlock Text="{loc:Loc radarSubtitle}"
                                       FontSize="12"
                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                        </StackPanel>

                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="Radar Mode:"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontSize="11"
                                       Foreground="{DynamicResource TextMutedBrush}"
                                       VerticalAlignment="Center"/>

                            <ComboBox ItemsSource="{Binding ScopedNodeOptions}"
                                      SelectedItem="{Binding ScopedNodeId, Mode=TwoWay}"
                                      FontFamily="{StaticResource MonoFontFamily}"
                                      FontSize="11"
                                      Width="280"
                                      Background="#04060B"
                                      BorderBrush="{DynamicResource BorderBrush}"
                                      CornerRadius="6"/>
                        </StackPanel>
                    </Grid>

                    <!-- Time scopes and stats bar -->
                    <Border Background="#070A12"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="10,6">
                        <Grid ColumnDefinitions="Auto,*,Auto">
                            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                                <TextBlock Text="Time Window:" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                <Button Content="15m" Command="{Binding SetTimeScopeCommand}" CommandParameter="15m" FontSize="10" Padding="8,3" CornerRadius="4" Background="#1E293B" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button Content="1h" Command="{Binding SetTimeScopeCommand}" CommandParameter="1h" FontSize="10" FontWeight="Bold" Padding="8,3" CornerRadius="4" Background="#4F46E5" Foreground="White"/>
                                <Button Content="6h" Command="{Binding SetTimeScopeCommand}" CommandParameter="6h" FontSize="10" Padding="8,3" CornerRadius="4" Background="#1E293B" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button Content="24h" Command="{Binding SetTimeScopeCommand}" CommandParameter="24h" FontSize="10" Padding="8,3" CornerRadius="4" Background="#1E293B" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Button Content="7d" Command="{Binding SetTimeScopeCommand}" CommandParameter="7d" FontSize="10" Padding="8,3" CornerRadius="4" Background="#1E293B" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Center">
                                <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="Selected Egress: "/>
                                    <Run Text="{Binding EgressRate}" FontWeight="Bold" Foreground="{DynamicResource AccentTextBrush}"/>
                                </TextBlock>
                                <TextBlock Text="|" Foreground="{DynamicResource BorderBrush}"/>
                                <TextBlock FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}">
                                    <Run Text="Total Samples: "/>
                                    <Run Text="{Binding SampleCount}" FontWeight="Bold" Foreground="{DynamicResource HealthyBrush}"/>
                                </TextBlock>
                            </StackPanel>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Interactive Flat World Map -->
            <Border Background="{DynamicResource CardBgBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14"
                    Padding="16">
                <StackPanel Spacing="12">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                            <TextBlock Text="Global Traffic Intensity (Choropleth Heatmap)"
                                       FontFamily="{StaticResource MonoFontFamily}"
                                       FontWeight="Bold"
                                       FontSize="13"
                                       Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Background="#083344" BorderBrush="#0E7490" BorderThickness="1" CornerRadius="4" Padding="6,1">
                                <TextBlock Text="{Binding ActiveVectorsBadge}" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" Foreground="{DynamicResource AccentTextBrush}"/>
                            </Border>
                        </StackPanel>

                        <!-- Gradient Legend -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                            <TextBlock Text="Traffic Density: Low (Gray)" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                            <Border Width="60" Height="8" CornerRadius="4" Background="#EA580C"/>
                            <TextBlock Text="High (Orange)" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="#EA580C"/>
                        </StackPanel>
                    </Grid>

                    <!-- World Map Control with Hover details -->
                    <Border Background="#050811"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Height="440"
                            ClipToBounds="True">
                        <Grid>
                            <radar:WorldRadarMapControl x:Name="RadarMap"
                                                        ScopedNodeId="{Binding ScopedNodeId}"/>

                            <!-- Floating Region Hover Card -->
                            <Border Background="#E60A0F1D"
                                    BorderBrush="#334155"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Padding="10,8"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Margin="12"
                                    IsVisible="{Binding #RadarMap.IsRegionHovered}"
                                    BoxShadow="0 4 20 #80000000">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding #RadarMap.HoveredRegionName}"
                                               FontFamily="{StaticResource MonoFontFamily}"
                                               FontWeight="Bold"
                                               FontSize="12"
                                               Foreground="White"/>
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <TextBlock Text="Traffic:" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding #RadarMap.HoveredTrafficRate}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10" Foreground="#F97316"/>
                                        <TextBlock Text="|" Foreground="{DynamicResource BorderBrush}"/>
                                        <TextBlock Text="TWAMP:" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextMutedBrush}"/>
                                        <TextBlock Text="{Binding #RadarMap.HoveredRtt}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Breakdown Cards (4 Columns) -->
            <Grid ColumnDefinitions="*,*,*,*">
                
                <!-- Card 1: Top Origins -->
                <Border Grid.Column="0" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,6,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="TOP ORIGINS" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Global Share" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" Foreground="{DynamicResource AccentTextBrush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopOrigins}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:OriginShareItem">
                                    <StackPanel Spacing="3" Margin="0,3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <TextBlock Text="{Binding CountryFlag}" FontSize="11"/>
                                                <TextBlock Text="{Binding CountryName}" FontFamily="{StaticResource MonoFontFamily}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}">
                                                <Run Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontWeight="Bold"/>
                                                <Run Text=" (" Foreground="{DynamicResource TextMutedBrush}"/>
                                                <Run Text="{Binding Latency}" Foreground="{DynamicResource AccentTextBrush}"/>
                                                <Run Text=")" Foreground="{DynamicResource TextMutedBrush}"/>
                                            </TextBlock>
                                        </Grid>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="#06B6D4" Background="#1E293B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Card 2: Protocol Split -->
                <Border Grid.Column="1" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="3,0,3,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="PROTOCOL SPLIT" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="L4/L7 Mix" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" Foreground="{DynamicResource HealthyBrush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding ProtocolSplit}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:ProtocolSplitItem">
                                    <StackPanel Spacing="3" Margin="0,3">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </Grid>
                                        <ProgressBar Value="{Binding Percentage}" Maximum="100" Height="4" CornerRadius="2" Foreground="#6366F1" Background="#1E293B"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Card 3: Top ASN Peering -->
                <Border Grid.Column="2" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="3,0,3,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="TOP ASN PEERING" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="BGP Direct" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" Foreground="{DynamicResource WarningBrush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding TopAsn}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:AsnPeeringItem">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <TextBlock Text="{Binding AsnName}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <!-- Card 4: Port Traffic -->
                <Border Grid.Column="3" Background="{DynamicResource CardBgBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="6,0,0,0">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <TextBlock Text="PORT TRAFFIC" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" Text="Ingress" FontFamily="{StaticResource MonoFontFamily}" FontSize="9" Foreground="{DynamicResource CriticalBrush}"/>
                        </Grid>
                        <ItemsControl ItemsSource="{Binding PortTraffic}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PortTrafficItem">
                                    <Grid ColumnDefinitions="*,Auto" Margin="0,3">
                                        <TextBlock Text="{Binding PortName}" FontFamily="{StaticResource MonoFontFamily}" FontSize="10" Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        <TextBlock Grid.Column="1" Text="{Binding Percentage, StringFormat={}{0:F1}%}" FontFamily="{StaticResource MonoFontFamily}" FontWeight="Bold" FontSize="10" Foreground="{DynamicResource AccentTextBrush}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

        </StackPanel>
    </ScrollViewer>
</UserControl>

