<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:MadTOM.ViewModels"
        xmlns:views="using:MadTOM.Views"
        xmlns:modals="using:MadTOM.Views.Modals"
        xmlns:toast="using:MadTOM.Views.Toast"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1440" d:DesignHeight="900"
        x:Class="MadTOM.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="MAD TOM - Telemetry &amp; Operations Matrix"
        Width="1440" Height="900"
        MinWidth="1100" MinHeight="700"
        Background="{DynamicResource AppBgBrush}">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <!-- App Main Layout Grid -->
    <Grid>
        <Grid RowDefinitions="Auto,*">
            
            <!-- Global Top Bar -->
            <views:HeaderView Grid.Row="0" DataContext="{Binding Header}" />

            <!-- Main Shell: Left Sidebar + Viewport Stage -->
            <Grid Grid.Row="1" ColumnDefinitions="Auto,*">
                <views:SidebarView Grid.Column="0" DataContext="{Binding Sidebar}" />

                <!-- Active Viewport Stage -->
                <ContentControl Grid.Column="1"
                                Content="{Binding CurrentView}"
                                Background="{DynamicResource AppBgBrush}"/>
            </Grid>
        </Grid>

        <!-- Remote Signal Confirmation Modal Overlay -->
        <modals:ActionConfirmModal IsVisible="{Binding IsActionModalOpen}" />

        <!-- Floating Toast Notification Overlay -->
        <toast:ToastNotificationView IsVisible="{Binding IsToastVisible}"
                                     HorizontalAlignment="Right"
                                     VerticalAlignment="Bottom"
                                     Margin="24" />
    </Grid>

</Window>
