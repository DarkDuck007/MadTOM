[Unit]
Description=Nox Firecracker sandbox daemon
After=network.target

[Service]
Type=simple
User=root
Group=root
ExecStart=/usr/local/bin/nox-sandbox -host-config /etc/nox-sandbox/host.yaml
ExecReload=/bin/kill -HUP $MAINPID
RuntimeDirectory=nox-sandbox
RuntimeDirectoryMode=0755
ProtectHome=read-only
ProtectSystem=strict
PrivateTmp=yes
ReadWritePaths=/var/lib/nox-sandbox /run/nox-sandbox
Delegate=cpu memory pids
DelegateSubgroup=supervisor
KillMode=mixed
TimeoutStopSec=135s
Restart=on-failure

[Install]
WantedBy=multi-user.target
